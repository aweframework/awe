{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "baseBranchPatterns": [
    "develop",
    "support/4.x"
  ],
  "timezone": "Europe/Madrid",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardLabels": [
    "update-dependencies"
  ],
  "labels": [
    "update-dependencies"
  ],
  "prConcurrentLimit": 8,
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "update-dependencies",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 * * 1"
    ]
  },
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/archetype-resources/**"
  ],
  "packageRules": [
    {
      "description": "The root package.json is an unused leftover; ignorePaths cannot target it without matching every package.json, so it is disabled here.",
      "matchFileNames": [
        "package.json"
      ],
      "enabled": false
    },
    {
      "description": "Reactor artifacts are versioned by the release tooling, never by the bot.",
      "matchPackageNames": [
        "com.almis.awe:**"
      ],
      "enabled": false
    },
    {
      "description": "The Highcharts licence covers versions up to 7; never propose 8 or later (the OSV fix for GHSA-8j65-4pcq-xq95 needs 9, so it stays visible on the dashboard as unfixable).",
      "matchPackageNames": [
        "highcharts"
      ],
      "allowedVersions": "<8"
    },
    {
      "description": "Major updates of the legacy AngularJS client and its test applications wait for approval on the Dependency Dashboard; the client is being replaced in AWE 5. The React client and its test application (awe-tests/awe-boot-react) are not held back. Security fixes are not held back (vulnerability alerts disable the approval step).",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "awe-framework/awe-client-angular/**",
        "awe-framework/awe-modules/awe-tools/**",
        "awe-tests/awe-boot/package.json",
        "awe-tests/awe-scheduler-boot/package.json"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Maintenance line: patch, pin, digest and security fixes only.",
      "matchBaseBranches": [
        "support/4.x"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "lockFileMaintenance"
      ],
      "enabled": false
    },
    {
      "groupName": "maven plugins",
      "description": "Maven build plugins.",
      "matchManagers": [
        "maven"
      ],
      "matchDepTypes": [
        "build"
      ]
    },
    {
      "groupName": "spring boot",
      "description": "Spring Boot and its managed starters move together.",
      "matchPackageNames": [
        "org.springframework.boot:**"
      ]
    },
    {
      "groupName": "spring cloud",
      "description": "Spring Cloud release train.",
      "matchPackageNames": [
        "org.springframework.cloud:**"
      ]
    },
    {
      "groupName": "selenium",
      "description": "Selenium and the driver manager used by the browser tests.",
      "matchPackageNames": [
        "org.seleniumhq.selenium:**",
        "io.github.bonigarcia:webdrivermanager"
      ]
    },
    {
      "groupName": "babel",
      "matchPackageNames": [
        "/^@babel\\//",
        "babel-jest",
        "babel-loader"
      ]
    },
    {
      "groupName": "jest",
      "matchPackageNames": [
        "jest",
        "/^jest-/",
        "/^@jest\\//"
      ]
    },
    {
      "groupName": "docusaurus",
      "matchPackageNames": [
        "@docusaurus/**"
      ]
    },
    {
      "groupName": "ci images",
      "description": "Images and services referenced in .gitlab-ci.yml.",
      "matchManagers": [
        "gitlabci"
      ]
    },
    {
      "groupName": "docker compose images",
      "description": "Local tooling stack (observability) described by the docker-compose file under awe-tests.",
      "matchManagers": [
        "docker-compose"
      ]
    },
    {
      "groupName": "test database images",
      "description": "Database images used by the Testcontainers integration tests.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "awe-framework/awe-testing/src/main/resources/awe-testing-images.properties"
      ]
    },
    {
      "description": "SQL Server tags look like 2022-CU27-ubuntu-22.04: stay on the 2022 line and follow its cumulative updates.",
      "matchPackageNames": [
        "mcr.microsoft.com/mssql/server"
      ],
      "matchFileNames": [
        "awe-framework/awe-testing/src/main/resources/awe-testing-images.properties"
      ],
      "versioning": "regex:^(?<major>\\d+)-CU(?<minor>\\d+)-(?<compatibility>ubuntu-\\d+\\.\\d+)$",
      "allowedVersions": "/^2022-CU\\d+-ubuntu-22\\.04$/"
    },
    {
      "description": "Patch releases of direct Maven and npm dependencies merge by themselves on develop once the merge-request pipeline passes; everything else (digests, pins, CI images, Dockerfile, compose files, lock-file maintenance) waits for a human.",
      "matchBaseBranches": [
        "develop"
      ],
      "matchManagers": [
        "maven",
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "gitLabIgnoreApprovals": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Node releases: odd majors are unstable and are skipped. The Node of the build (awe-dependencies) and the one of the development container use the same datasource, package name and versioning, so this rule groups both in one merge request.",
      "matchDatasources": [
        "node-version"
      ],
      "versioning": "node",
      "groupName": "node toolchain"
    },
    {
      "description": "npm version of the frontend-maven-plugin travels with Node.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "npm"
      ],
      "groupName": "node toolchain"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^awe-framework/awe-dependencies/pom\\.xml$/"
      ],
      "matchStrings": [
        "<node\\.version>v(?<currentValue>\\d+\\.\\d+\\.\\d+)</node\\.version>"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^awe-framework/awe-dependencies/pom\\.xml$/"
      ],
      "matchStrings": [
        "<npm\\.version>(?<currentValue>\\d+\\.\\d+\\.\\d+)</npm\\.version>"
      ],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "org\\.cyclonedx:cyclonedx-maven-plugin:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "org.cyclonedx:cyclonedx-maven-plugin",
      "datasourceTemplate": "maven"
    },
    {
      "description": "Container images of the integration-test databases (awe-testing-images.properties), pinned as name:tag@sha256:digest.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^awe-framework/awe-testing/src/main/resources/awe-testing-images\\.properties$/"
      ],
      "matchStrings": [
        "awe\\.testing\\.image\\.[a-z]+=(?<depName>[^:\\s@]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Reads the Node version pinned in the development container with the same datasource, package name (node) and versioning as the node.version of the build, so the node toolchain group updates both files together.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.devcontainer/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "features/node:[^\"]*\"\\s*:\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ]
}
