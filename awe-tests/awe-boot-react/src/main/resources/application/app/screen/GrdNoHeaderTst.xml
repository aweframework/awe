<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : GrdNoHeaderTst.xml
    Description: Grid without header row, with the grid-no-header theme class
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_GRID_NO_HEADER">
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_GRID_NO_HEADER" expandible="vertical">
      <grid id="GrdNoHeaderTst" style="expand grid-no-header" initial-load="query" server-action="data" target-action="ThemeStyleTst" max="30" load-all="true">
        <column label="PARAMETER_ID" name="id" align="center" charlength="10"/>
        <column label="COLUMN_RADIO_THEME" name="name" align="left" charlength="30"/>
      </grid>
    </window>
  </tag>
</screen>
