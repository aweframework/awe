<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : DeferredLoadTst.xml
    Description: Dialog and tab page which defer the data of their components until they are opened for the first time (#824).
                 The grid shows how many times the query of each component has run
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_DEFERRED_LOAD" onload="DeferredLoadReset">
  <tag source="buttons">
    <button id="ButDefDialog" label="BUTTON_DEFERRED_DIALOG" icon="window-restore">
      <button-action type="dialog" target="DlgDeferred"/>
    </button>
    <button id="ButEagDialog" label="BUTTON_EAGER_DIALOG" icon="window-maximize">
      <button-action type="dialog" target="DlgEager"/>
    </button>
    <button id="ButDefCalls" label="BUTTON_DEFERRED_CALLS" icon="refresh">
      <button-action type="filter" target="GrdDefCalls"/>
    </button>
    <button id="ButDefSave" label="BUTTON_DEFERRED_SAVE" icon="save">
      <button-action type="validate"/>
      <button-action type="value" target="DefSaved" value="Saved"/>
    </button>
    <button id="ButDefPreset" label="BUTTON_DEFERRED_PRESET" icon="pencil">
      <button-action type="value" target="DefText" value="Preset"/>
    </button>
  </tag>
  <tag source="center" expandible="vertical">
    <criteria label="PARAMETER_TEXT" id="DefSaved" component="text" style="col-xs-12 col-sm-6"/>
    <tab id="TabDeferred" initial-load="enum" target-action="DeferredTabs">
      <tabcontainer id="DefFirst">
        <window style="expand" label="SCREEN_TITLE_DEFERRED_LOAD" expandible="vertical">
          <tag type="div" style="panel-body">
            <criteria label="PARAMETER_SELECT" id="TabFirstSelect" component="select" initial-load="query" target-action="DeferredLoadTabFirstSelect" optional="true" style="col-xs-12 col-sm-6"/>
          </tag>
          <grid id="GrdDefCalls" style="expand" server-action="data" target-action="DeferredLoadCalls" max="30" load-all="true">
            <column label="PARAMETER_ID" name="id" align="left" charlength="20"/>
            <column label="PARAMETER_TEXT" name="calls" align="right" charlength="10"/>
          </grid>
        </window>
      </tabcontainer>
      <tabcontainer id="DefSecond" deferred="true">
        <window style="expand" label="SCREEN_TITLE_DEFERRED_LOAD" expandible="vertical">
          <tag type="div" style="panel-body">
            <criteria label="PARAMETER_SELECT" id="TabSecondSelect" component="select" initial-load="query" target-action="DeferredLoadTabSecondSelect" optional="true" style="col-xs-12 col-sm-6"/>
          </tag>
          <grid id="GrdTabRows" style="expand" initial-load="query" server-action="data" target-action="DeferredLoadTabSecondRows" max="10">
            <column label="PARAMETER_TEXT" name="label" align="left" charlength="20"/>
          </grid>
        </window>
      </tabcontainer>
    </tab>

    <dialog id="DlgDeferred" label="DIALOG_TITLE_DEFERRED" modal="true" deferred="true">
      <tag type="div" style="modal-body">
        <criteria label="PARAMETER_SELECT" id="DefSelect" component="select" validation="required" initial-load="query" target-action="DeferredLoadDefSelect" style="col-xs-12 col-sm-6"/>
        <criteria label="PARAMETER_TEXT" id="DefText" component="text" validation="required" initial-load="value" target-action="DeferredLoadDefText" style="col-xs-12 col-sm-6"/>
        <grid id="GrdDefRows" style="expand" initial-load="query" server-action="data" target-action="DeferredLoadDefRows" max="10">
          <column label="PARAMETER_TEXT" name="value" align="left" charlength="20"/>
        </grid>
      </tag>
      <tag type="div" style="modal-footer">
        <button id="ButDefClose" label="BUTTON_CANCEL" icon="times">
          <button-action type="close" target="DlgDeferred"/>
        </button>
      </tag>
    </dialog>

    <dialog id="DlgEager" label="DIALOG_TITLE_EAGER" modal="true">
      <tag type="div" style="modal-body">
        <criteria label="PARAMETER_SELECT" id="EagSelect" component="select" initial-load="query" target-action="DeferredLoadEagSelect" optional="true" style="col-xs-12 col-sm-6"/>
        <grid id="GrdEagRows" style="expand" initial-load="query" server-action="data" target-action="DeferredLoadEagRows" max="10">
          <column label="PARAMETER_TEXT" name="eag" align="left" charlength="20"/>
        </grid>
      </tag>
      <tag type="div" style="modal-footer">
        <button id="ButEagClose" label="BUTTON_CANCEL" icon="times">
          <button-action type="close" target="DlgEager"/>
        </button>
      </tag>
    </dialog>
  </tag>
</screen>
