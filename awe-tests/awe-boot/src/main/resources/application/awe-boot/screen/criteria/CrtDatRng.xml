<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : CrtDatRng.xml
    Description: Date range criterion test screen (presets, default dates, required and readonly ranges)
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window"
        label="SCREEN_TITLE_DATE_RANGE_TEST" help="HELP_SCREEN_TITLE_CRITERIA_TEST">
  <tag source="buttons">
    <button button-type="button" label="BUTTON_RESET" icon="mdi:backspace" id="ButRst" help="HELP_RESET_BUTTON">
      <button-action type="restore"/>
    </button>
    <button button-type="button" label="BUTTON_SEARCH" icon="mdi:search" id="ButSea">
      <button-action type="validate"/>
      <button-action type="filter" target="GrdDatRng"/>
    </button>
  </tag>
  <tag source="center" expandible="vertical">
    <window style="expand" label="SCREEN_TEXT_DATA" id="WinDatRng" expandible="vertical">
      <tag type="div" style="panel-body expand scrollable">
        <criteria label="PARAMETER_DATE_RANGE" id="DatRng" component="date-range" presets="1M,3M,YTD,12M,3Y,ALL" style="col-xs-12 col-sm-6"/>
        <criteria label="PARAMETER_DATE_RANGE_REQUIRED" id="DatRngReq" component="date-range" presets="TODAY,7D" value="01/01/2026,31/01/2026" validation="required" style="col-xs-12 col-sm-6"/>
        <criteria label="PARAMETER_DATE_RANGE_READONLY" id="DatRngRea" component="date-range" presets="1M" value="01/02/2026,28/02/2026" readonly="true" style="col-xs-12 col-sm-6"/>
        <criteria label="PARAMETER_DATE_RANGE_NO_PRESETS" id="DatRngNoPre" component="date-range" style="col-xs-12 col-sm-6"/>
      </tag>
      <tag type="div" style="panel-body">
        <grid id="GrdDatRng" style="expand" server-action="data" target-action="DatRngPrm" max="5">
          <column label="COLUMN_DATE_RANGE_FROM" name="DatFrm" align="left" charlength="20"/>
          <column label="COLUMN_DATE_RANGE_TO" name="DatTo" align="left" charlength="20"/>
          <column label="COLUMN_DATE_RANGE_REQUIRED_FROM" name="ReqFrm" align="left" charlength="20"/>
          <column label="COLUMN_DATE_RANGE_REQUIRED_TO" name="ReqTo" align="left" charlength="20"/>
        </grid>
      </tag>
    </window>
  </tag>
</screen>
