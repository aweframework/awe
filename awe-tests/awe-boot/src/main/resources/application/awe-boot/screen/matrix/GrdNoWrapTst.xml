<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : GrdNoWrapTst.xml
    Description: The same grid as GrdWrapTst without wrapping columns, to compare the render time
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_GRID_NOWRAP">
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_GRID_NOWRAP" expandible="vertical">
      <grid id="GrdNoWrapTst" style="expand" initial-load="query" server-action="data" target-action="WrapRowsTst" editable="true" max="100" load-all="true">
        <column label="COLUMN_WRAP_CODE" name="code" sort-field="code" align="left" charlength="8" component="text"/>
        <column label="COLUMN_WRAP_TITLE" name="title" sort-field="title" align="left" charlength="16"/>
        <column label="COLUMN_WRAP_DESCRIPTION" name="description" sort-field="description" align="left" charlength="30"/>
        <column label="COLUMN_WRAP_NOTES" name="notes" sort-field="notes" align="left" charlength="30"/>
      </grid>
    </window>
  </tag>
</screen>
