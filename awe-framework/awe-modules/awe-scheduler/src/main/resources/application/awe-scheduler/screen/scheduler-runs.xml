<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : scheduler-runs.xml
    Description: Flow runs of the Scheduler: the run list with its executions and skipped tasks
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd"
        template="window" label="MENU_SCHEDULER_RUNS" help="HELP_SCREEN_SCHEDULER_RUNS">
  <tag source="buttons">
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" help="HELP_HELP_BUTTON">
      <button-action type="dialog" target="HlpOpt" />
    </button>
  </tag>
  <tag source="center">
    <!-- The run list on top and, below it, the flow graph, the executions and the skipped tasks of the selected run:
         three windows side by side leave the dates out of view -->
    <tag type="div" style="expand" expandible="vertical">
      <window style="expand" maximize="true" label="SCREEN_TEXT_FLOW_RUNS" icon="sitemap" expandible="vertical">
        <grid id="GrdRunLst" style="expand" server-action="data" target-action="getFlowRunList" initial-load="query" row-numbers="false">
          <column name="IdeRun" hidden="true" />
          <column label="PARAMETER_STATUS" name="RunStaIco" sortable="false" component="icon" align="center" charlength="8" />
          <column label="PARAMETER_ROOT_TASK" name="RunTsk" sortable="false" align="left" charlength="20" />
          <column label="PARAMETER_ROOT_EXECUTION" name="RunExe" sortable="false" align="center" charlength="8" />
          <column label="PARAMETER_LAUNCHED_BY" name="RunLchBy" sortable="false" align="center" charlength="12" />
          <column label="PARAMETER_STARTED_AT" name="RunIni" sortable="false" align="center" charlength="16" />
          <column label="PARAMETER_ENDED_AT" name="RunEnd" sortable="false" align="center" charlength="16" />
          <dependency>
            <dependency-element id="GrdRunLst" condition="eq" value="1" />
            <dependency-action type="remove-class" target="[window-id='RunExecutionsWindow']" target-action="hidden" async="true" silent="true"/>
            <dependency-action type="remove-class" target="[window-id='RunSkippedWindow']" target-action="hidden" async="true" silent="true"/>
            <dependency-action type="remove-class" target="[window-id='RunGraphWindow']" target-action="hidden" async="true" silent="true"/>
            <dependency-action type="filter" target="IdeTsk" async="true" silent="true"/>
            <dependency-action type="filter" target="GrdRunExe" async="true" silent="true"/>
            <dependency-action type="filter" target="GrdRunSkp" async="true" silent="true"/>
          </dependency>
          <dependency>
            <dependency-element id="GrdRunLst" condition="ne" value="1" />
            <dependency-action type="add-class" target="[window-id='RunExecutionsWindow']" target-action="hidden" async="true" silent="true"/>
            <dependency-action type="add-class" target="[window-id='RunSkippedWindow']" target-action="hidden" async="true" silent="true"/>
            <dependency-action type="add-class" target="[window-id='RunGraphWindow']" target-action="hidden" async="true" silent="true"/>
          </dependency>
        </grid>
      </window>
      <!-- Flow graph of the selected run with the state of each task -->
      <window id="RunGraphWindow" style="hidden" label="SCREEN_TEXT_FLOW_GRAPH" icon="code-fork" expandible="vertical">
        <widget type="flow-graph" id="IdeTsk" server-action="data" target-action="getFlowGraph">
          <widget-parameter type="string" name="target" value="update-scheduler-task"/>
        </widget>
      </window>
      <tag type="div" style="expand" expandible="horizontal">
        <window id="RunExecutionsWindow" style="expand-2x hidden" label="SCREEN_TEXT_RUN_EXECUTIONS" icon="gears" expandible="vertical">
          <grid id="GrdRunExe" style="expand" server-action="data" target-action="getFlowRunExecutionList" pagination-disabled="true" row-numbers="false">
            <column label="PARAMETER_TASK" name="RxTsk" sortable="false" align="left" charlength="20" />
            <column label="#" name="RxExe" sortable="false" align="center" charlength="6" />
            <column label="PARAMETER_STATUS" name="RxStaIco" sortable="false" component="icon" align="center" charlength="8" />
            <column label="PARAMETER_STARTED_AT" name="RxIni" sortable="false" align="center" charlength="16" />
            <column label="PARAMETER_ENDED_AT" name="RxEnd" sortable="false" align="center" charlength="16" />
          </grid>
        </window>
        <window id="RunSkippedWindow" style="expand hidden" label="SCREEN_TEXT_RUN_SKIPPED" icon="ban" expandible="vertical">
          <grid id="GrdRunSkp" style="expand" server-action="data" target-action="getFlowRunSkippedList" pagination-disabled="true" row-numbers="false">
            <column label="PARAMETER_TASK" name="RsTsk" sortable="false" align="left" charlength="20" />
            <column label="PARAMETER_ENDED_AT" name="RsEnd" sortable="false" align="center" charlength="16" />
          </grid>
        </window>
      </tag>
    </tag>
  </tag>
  <tag source="modal">
    <include target-screen="screen-help" target-source="center"/>
  </tag>
</screen>
