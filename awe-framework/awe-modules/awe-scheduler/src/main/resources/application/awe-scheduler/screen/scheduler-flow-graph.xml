<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : scheduler-flow-graph.xml
    Description: Flow graph of the Scheduler: the flow of the selected task, or every flow
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd"
        template="window" label="MENU_SCHEDULER_FLOW_GRAPH" help="HELP_SCREEN_SCHEDULER_FLOW_GRAPH">
  <tag source="buttons">
    <button button-type="button" label="BUTTON_BACK" icon="arrow-circle-left" id="ButBck" help="HELP_BACK_BUTTON">
      <button-action type="back" />
    </button>
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" help="HELP_HELP_BUTTON">
      <button-action type="dialog" target="HlpOpt" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" maximize="true" label="SCREEN_TEXT_FLOW_GRAPH" icon="code-fork" expandible="vertical">
      <!-- The id makes a clicked node arrive at the task screen as IdeTsk.selected, like a row of the task grid -->
      <widget type="flow-graph" id="IdeTsk" server-action="data" target-action="getFlowGraph" initial-load="query" style="expand">
        <widget-parameter type="string" name="target" value="update-scheduler-task"/>
      </widget>
    </window>
  </tag>
  <tag source="modal">
    <include target-screen="screen-help" target-source="center"/>
  </tag>
</screen>
