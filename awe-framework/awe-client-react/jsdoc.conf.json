{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "source": {
    "include": "src",
    "includePattern": ".+\\.js(doc|x)?$"
  },
  "recurseDepth": 10,
  "sourceType": "module",
  "plugins": [
    "plugins/markdown",
    "node_modules/better-docs/category",
    "node_modules/better-docs/typescript"
  ],
  "opts": {
    "encoding": "utf8",
    "destination": "target/reports/jsdoc",
    "template": "node_modules/better-docs",
    "recurse": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false,
    "search": true,
    "better-docs": {
      "name": "AWE React Front-End Engine"
    }
  }
}