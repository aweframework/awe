{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "source": {
    "include": "src",
    "includePattern": ".+\\.js(doc|x)?$"
  },
  "recurseDepth": 10,
  "sourceType": "module",
  "plugins": [
    "plugins/markdown"
  ],
  "opts": {
    "encoding": "utf8",
    "destination": "target/reports/jsdoc",
    "recurse": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false,
    "search": true
  }
}
