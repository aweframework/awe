<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.almis.awe</groupId>
    <artifactId>awe-dependencies</artifactId>
    <version>5.0.0-SNAPSHOT</version>
    <relativePath>../awe-dependencies</relativePath>
  </parent>

  <packaging>jar</packaging>
  <artifactId>awe-client-react</artifactId>
  <name>AWE Client React (V${project.version})</name>
  <description>Awe Client React Module</description>

  <properties>
    <!-- The React engine is published to npm (awe-react-client), not to a Maven repository -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Sonar properties -->
    <application.folder>.</application.folder>
    <sonar.sources>src</sonar.sources>
    <sonar.tests>test/js</sonar.tests>
    <!-- Not code: vendored PrimeReact theme CSS, fonts, images and icons (src/static and src/assets hold duplicated
         copies of the same binaries). This module-level value replaces the root pom's "**/fonts/**", so it is repeated.
         The client's own JS/JSX/LESS/CSS (src/components, src/assets/css, src/main.css...) stays analysed. -->
    <sonar.exclusions>**/fonts/**,src/static/css/themes/**,src/static/images/**,src/assets/images/**,**/*.svg,**/*.png,**/*.jpg,**/*.ico,**/*.woff,**/*.woff2</sonar.exclusions>
    <sonar.testExecutionReportPaths>target/reports/jest/sonar/javascriptUnitTests.xml</sonar.testExecutionReportPaths>
    <sonar.javascript.lcov.reportPaths>target/reports/jest/coverage/lcov.info</sonar.javascript.lcov.reportPaths>
  </properties>

  <build>
    <finalName>awe-client-react</finalName>

    <plugins>
      <!-- Frontend generation -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <executions>
          <!-- The npm package version follows the framework version (see package-version.cjs).
               This override only works because its id ("npm run build") matches the execution inherited
               from awe-dependencies: if that id changes, AWE_VERSION would silently stop reaching webpack.
               The "verify npm package version" execution below guards against that. -->
          <execution>
            <id>npm run build</id>
            <configuration>
              <environmentVariables>
                <AWE_VERSION>${project.version}</AWE_VERSION>
              </environmentVariables>
            </configuration>
          </execution>
          <!-- Fails the build when dist/package.json does not carry the Maven version. It is skipped only with
               skip.frontend (like the build itself), never with -DskipTests, so CI packaging still verifies it -->
          <execution>
            <id>verify npm package version</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <arguments>run verify:version</arguments>
              <environmentVariables>
                <AWE_VERSION>${project.version}</AWE_VERSION>
              </environmentVariables>
            </configuration>
          </execution>
          <!-- Lint the whole client (sources, tests and build config) before the unit tests: lint errors fail the
               build, warnings are only reported. Declared before "jest" so it runs first within the test phase. -->
          <execution>
            <id>lint</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <arguments>run lint</arguments>
            </configuration>
          </execution>
          <execution>
            <id>jest</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>test</phase>
            <configuration>
              <arguments>run test:coverage</arguments>
              <!-- Force the test environment: Jest keeps an inherited NODE_ENV, and the CI project variable
                   NODE_ENV=production (which overrides job-level variables) would load React's production
                   build, where act() is not supported. -->
              <environmentVariables>
                <NODE_ENV>test</NODE_ENV>
                <BABEL_ENV>test</BABEL_ENV>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
