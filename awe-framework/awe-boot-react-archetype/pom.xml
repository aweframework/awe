<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.almis.awe</groupId>
    <artifactId>awe-dependencies</artifactId>
    <version>5.0.0-SNAPSHOT</version>
    <relativePath>../awe-dependencies</relativePath>
  </parent>

  <artifactId>awe-boot-react-archetype</artifactId>
  <packaging>maven-archetype</packaging>
  <name>AWE Spring Boot React Archetype (V${project.version})</name>
  <url>https://www.almis.com</url>
  <description>This archetype generates a simple AWE web application with spring boot using the React frontend engine</description>

  <developers>
    <developer>
      <id>pabloG</id>
      <name>Pablo Garcia</name>
      <email>pablo.garcia@almis.com</email>
      <organization>Almis</organization>
      <organizationUrl>https://www.almis.com</organizationUrl>
      <timezone>+2</timezone>
    </developer>
    <developer>
      <id>pabloV</id>
      <name>Pablo Vidal</name>
      <email>pablo.vidal@almis.com</email>
      <organization>Almis</organization>
      <organizationUrl>https://www.almis.com</organizationUrl>
      <timezone>+2</timezone>
    </developer>
  </developers>

  <properties>
    <sonar.exclusions>src/**</sonar.exclusions>
    <dependency-check.skip>true</dependency-check.skip>
    <archetype.test.ignoreEOLStyle>true</archetype.test.ignoreEOLStyle>
    <archetype.test.debug>false</archetype.test.debug>
  </properties>

  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
      </extension>
    </extensions>

    <!-- Plugins -->
    <plugins>
      <!-- Filter the root POM and package.json to replace the project version: the generated application depends on the
           awe-react-client npm package of the same version as the archetype -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <encoding>UTF-8</encoding>
          <escapeString>\</escapeString>
        </configuration>
      </plugin>
      <!-- Skip deploy -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>archetype-resources/pom.xml</include>
          <include>archetype-resources/package.json</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>archetype-resources/pom.xml</exclude>
          <exclude>archetype-resources/package.json</exclude>
        </excludes>
      </resource>
    </resources>
    <!-- The archetype integration test builds the generated project with "package -Dskip.frontend=true" (see
         src/test/resources/projects/it1/goal.txt): the generated package.json pins awe-react-client to this project's
         version, which is published to npm only when a release is tagged, so a snapshot build cannot install it. The
         test still compares the generated files with the reference and compiles and tests the Java application. -->
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>projects/it1/reference/pom.xml</exclude>
          <exclude>projects/it1/reference/package.json</exclude>
        </excludes>
      </testResource>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>projects/it1/reference/pom.xml</include>
          <include>projects/it1/reference/package.json</include>
        </includes>
      </testResource>
    </testResources>
  </build>
</project>
