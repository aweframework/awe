{
  "$comment": [
    "Equivalence table of the AWE theme of PrimeReact (#885), read by primereact-theme.cjs.",
    "Each value of the Lara light theme of primereact 10.9.9 maps to the --awe-* token that replaces it; the tokens follow",
    "the Aura preset of @primeuix/themes 2.0.3 as the design system prototype does (never --awe-palette-* primitives).",
    "An entry is a token, a CSS value, or a list of rules {selector, property, value} (regular expressions on the selector",
    "of the Lara rule and on the property): the first matching rule wins. overrides replace a whole declaration of the",
    "components whose Aura geometry differs from Lara. structural values are kept as they are. A value of Lara that is not",
    "mapped here fails the build."
  ],
  "source": {
    "package": "primereact",
    "version": "10.9.9",
    "theme": "resources/themes/lara-light-indigo/theme.css"
  },
  "structural": ["0", "0px", "1px", "1%", "50%", "100%", "auto", "none", "0 none", "inherit", "transparent"],
  "rootVariables": {
    "--border-radius": "--awe-radius-field",
    "--inline-spacing": "--awe-space-2",
    "--content-padding": "--awe-content-padding"
  },
  "variables": {
    "font-family": "--awe-font-family-base",
    "font-feature-settings": "--awe-font-feature-base",
    "maskbg": "--awe-color-mask"
  },
  "overrides": [
    {"selector": "^\\.p-inputtext$|^\\.p-(multiselect|treeselect|cascadeselect) \\.p-(multiselect|treeselect|cascadeselect)-label$", "property": "padding", "value": "var(--awe-field-padding-y) var(--awe-field-padding-x)"},
    {"selector": "^\\.p-inputtext\\.p-inputtext-sm$|^\\.p-inputtext-sm \\.p-inputtext$", "property": "padding", "value": "var(--awe-space-1-5) var(--awe-space-2)"},
    {"selector": "^\\.p-inputtext\\.p-inputtext-lg$|^\\.p-inputtext-lg \\.p-inputtext$", "property": "padding", "value": "var(--awe-space-2) var(--awe-space-3)"},
    {"selector": "^\\.p-(dropdown|multiselect|treeselect|cascadeselect) \\.p-(dropdown|multiselect|treeselect|cascadeselect)-trigger$|\\.p-autocomplete-dropdown$", "property": "width", "value": "var(--awe-space-10)"},
    {"selector": "^\\.p-inputgroup-addon$", "property": "padding", "value": "var(--awe-field-padding-y) var(--awe-field-padding-x)"},
    {"selector": "^\\.p-inputgroup-addon$", "property": "min-width", "value": "var(--awe-size-control)"},

    {"selector": "^\\.p-button$", "property": "padding", "value": "var(--awe-field-padding-y) var(--awe-button-padding-x)"},
    {"selector": "^\\.p-button\\.p-button-icon-only$", "property": "width", "value": "var(--awe-size-control)"},
    {"selector": "^\\.p-button\\.p-button-icon-only$", "property": "padding", "value": "var(--awe-field-padding-y) 0"},
    {"selector": "^\\.p-button\\.p-button-icon-only\\.p-button-rounded$", "property": "height", "value": "var(--awe-size-control)"},
    {"selector": "^\\.p-button\\.p-button-sm$|^\\.p-splitbutton\\.p-button-sm > \\.p-button$", "property": "padding", "value": "var(--awe-space-1-5) var(--awe-space-3)"},
    {"selector": "^\\.p-button\\.p-button-lg$|^\\.p-splitbutton\\.p-button-lg > \\.p-button$", "property": "padding", "value": "var(--awe-space-3) var(--awe-space-4)"},
    {"selector": "^\\.p-button-label$", "property": "font-weight", "value": "var(--awe-font-weight-medium)"},
    {"selector": "^\\.p-button\\.p-button-outlined$", "property": "background-color", "value": "var(--awe-color-surface)"},
    {"selector": "^\\.p-button\\.p-button-outlined(:not\\(:disabled\\):(hover|active))?$", "property": "color", "value": "var(--awe-color-text)"},
    {"selector": "^\\.p-button\\.p-button-outlined$", "property": "border", "value": "1px solid var(--awe-color-field-border)"},
    {"selector": "^\\.p-button\\.p-button-outlined:not\\(:disabled\\):(hover|active)$", "property": "border", "value": "1px solid var(--awe-color-field-border-hover)"},
    {"selector": "^\\.p-button\\.p-button-outlined:not\\(:disabled\\):hover$", "property": "background", "value": "var(--awe-color-surface-subtle)"},
    {"selector": "^\\.p-button\\.p-button-outlined:not\\(:disabled\\):active$", "property": "background", "value": "var(--awe-color-surface-hover)"},

    {"selector": "^\\.p-(checkbox|tristatecheckbox)( \\.p-checkbox-box)?$|^\\.p-radiobutton( \\.p-radiobutton-box)?$", "property": "width|height", "value": "var(--awe-size-checkbox)"},
    {"selector": "^\\.p-checkbox \\.p-checkbox-(input|box)$|^\\.p-radiobutton \\.p-radiobutton-(input|box)$", "property": "border", "value": "1px solid var(--awe-color-field-border)"},
    {"selector": "^\\.p-checkbox \\.p-checkbox-(input|box)$", "property": "border-radius", "value": "var(--awe-radius-sm)"},
    {"selector": "^\\.p-checkbox \\.p-checkbox-box \\.p-checkbox-icon(\\.p-icon)?$", "property": "font-size|width|height", "value": "var(--awe-checkbox-icon-size)"},
    {"selector": "^\\.p-radiobutton \\.p-radiobutton-box \\.p-radiobutton-icon$", "property": "width|height", "value": "var(--awe-radio-dot-size)"},

    {"selector": "^\\.p-inputswitch$", "property": "width", "value": "var(--awe-switch-width)"},
    {"selector": "^\\.p-inputswitch$", "property": "height", "value": "var(--awe-switch-height)"},
    {"selector": "^\\.p-inputswitch \\.p-inputswitch-slider:before$", "property": "width|height", "value": "var(--awe-switch-handle-size)"},
    {"selector": "^\\.p-inputswitch \\.p-inputswitch-slider:before$", "property": "left", "value": "calc((var(--awe-switch-height) - var(--awe-switch-handle-size)) / 2 - 1px)"},
    {"selector": "^\\.p-inputswitch \\.p-inputswitch-slider:before$", "property": "margin-top", "value": "calc(var(--awe-switch-handle-size) / -2)"},
    {"selector": "^\\.p-inputswitch\\.p-highlight \\.p-inputswitch-slider:before$", "property": "transform", "value": "translateX(calc(var(--awe-switch-width) - var(--awe-switch-height)))"},

    {"selector": "^\\.p-(dropdown|multiselect|autocomplete|cascadeselect|treeselect|mention)-panel \\.p-[a-z]+-items$|^\\.p-listbox \\.p-listbox-list$", "property": "padding", "value": "var(--awe-list-padding)"},
    {"selector": "^\\.p-(dropdown|multiselect|autocomplete|treeselect|mention)-panel \\.p-[a-z]+-items \\.p-[a-z]+-item(-group)?$|^\\.p-listbox \\.p-listbox-list \\.p-listbox-item(-group)?$|^\\.p-cascadeselect-panel \\.p-cascadeselect-items \\.p-cascadeselect-item \\.p-cascadeselect-item-content$", "property": "padding", "value": "var(--awe-list-option-padding)"},
    {"selector": "^\\.p-(dropdown|multiselect|autocomplete|treeselect|mention)-panel \\.p-[a-z]+-items \\.p-[a-z]+-item$|^\\.p-listbox \\.p-listbox-list \\.p-listbox-item$|^\\.p-cascadeselect-panel \\.p-cascadeselect-items \\.p-cascadeselect-item$", "property": "border-radius", "value": "var(--awe-radius-list-option)"},
    {"selector": "^\\.p-(dropdown|multiselect|treeselect)-panel \\.p-(dropdown|multiselect|treeselect)-header$|^\\.p-listbox \\.p-listbox-header$", "property": "padding", "value": "var(--awe-space-2) var(--awe-space-4) var(--awe-space-1)"},
    {"selector": "-items \\.p-[a-z]+-empty-message$|^\\.p-listbox \\.p-listbox-list \\.p-listbox-empty-message$", "property": "padding", "value": "var(--awe-list-option-padding)"},

    {"selector": "\\.p-menuitem-link$|\\.p-panelmenu-header-link$", "property": "padding", "value": "var(--awe-nav-item-padding)"},
    {"selector": "\\.p-submenu-header$", "property": "padding", "value": "var(--awe-nav-item-padding)"},
    {"selector": "^\\.p-(menu|contextmenu|tieredmenu|slidemenu)$|^\\.p-(menubar|contextmenu|tieredmenu) \\.p-submenu-list$|^\\.p-panelmenu \\.p-panelmenu-content$", "property": "padding", "value": "var(--awe-list-padding)"},
    {"selector": "^\\.p-(menu|contextmenu|tieredmenu|slidemenu|megamenu|menubar|panelmenu)( \\.p-[a-z-]+)* \\.p-menuitem > \\.p-menuitem-content$", "property": "border-radius", "value": "var(--awe-radius-list-option)"},
    {"selector": "\\.p-menubar-root-list( ul li){5} a$", "property": "padding-left", "value": "calc(var(--awe-menu-indent) * 5)"},
    {"selector": "\\.p-menubar-root-list( ul li){4} a$", "property": "padding-left", "value": "calc(var(--awe-menu-indent) * 4)"},
    {"selector": "\\.p-menubar-root-list( ul li){3} a$", "property": "padding-left", "value": "calc(var(--awe-menu-indent) * 3)"},
    {"selector": "\\.p-menubar-root-list( ul li){2} a$", "property": "padding-left", "value": "calc(var(--awe-menu-indent) * 2)"},
    {"selector": "\\.p-menubar-root-list ul li a$", "property": "padding-left", "value": "var(--awe-menu-indent)"},

    {"selector": "^\\.p-(dialog|overlaypanel|confirm-popup|contextmenu)$", "property": "border", "value": "1px solid var(--awe-color-overlay-border)"},
    {"selector": "^\\.p-(overlaypanel|confirm-popup)\\.p-(overlaypanel|confirm-popup)-flipped:before$", "property": "border-top-color", "value": "var(--awe-color-overlay-border)"},
    {"selector": "^\\.p-overlaypanel \\.p-overlaypanel-content$|^\\.p-confirm-popup \\.p-confirm-popup-content$|^\\.p-datepicker$", "property": "padding", "value": "var(--awe-overlay-padding)"},
    {"selector": "^\\.p-confirm-popup \\.p-confirm-popup-footer$", "property": "padding", "value": "0 var(--awe-overlay-padding) var(--awe-overlay-padding)"},
    {"selector": "^\\.p-tooltip \\.p-tooltip-text$", "property": "padding", "value": "var(--awe-space-1) var(--awe-space-2)"},
    {"selector": "^\\.p-tooltip \\.p-tooltip-text$", "property": "border-radius", "value": "var(--awe-radius-sm)"},
    {"selector": "^\\.p-dialog \\.p-dialog-header$|^\\.p-sidebar \\.p-sidebar-(header|content)$", "property": "padding", "value": "var(--awe-modal-padding)"},
    {"selector": "^\\.p-dialog \\.p-dialog-content$", "property": "padding", "value": "0 var(--awe-modal-padding) var(--awe-modal-padding)"},
    {"selector": "^\\.p-dialog \\.p-dialog-footer$", "property": "padding", "value": "var(--awe-space-3) var(--awe-modal-padding)"},
    {"selector": "^\\.p-dialog \\.p-dialog-footer$", "property": "background", "value": "var(--awe-color-surface-subtle)"},
    {"selector": "^\\.p-dialog \\.p-dialog-footer$", "property": "border-top", "value": "1px solid var(--awe-color-border)"},
    {"selector": "^\\.p-dialog \\.p-dialog-footer button$", "property": "margin", "value": "0"},
    {"selector": "^\\.p-dialog( \\.p-dialog-(header|content|footer))?(:last-of-type)?$", "property": "border(-[a-z]+)*-radius", "value": "var(--awe-radius-modal)"},
    {"selector": "^\\.p-dialog \\.p-dialog-header \\.p-dialog-title$", "property": "font-size", "value": "var(--awe-font-size-dialog-title)"},

    {"selector": "^\\.p-toast \\.p-toast-message \\.p-toast-message-content$", "property": "padding", "value": "var(--awe-overlay-padding)"},
    {"selector": "^\\.p-toast \\.p-toast-message$", "property": "border-radius", "value": "var(--awe-radius-lg)"},
    {"selector": "^\\.p-toast \\.p-toast-message$", "property": "margin", "value": "0 0 var(--awe-space-2) 0"},
    {"selector": "^\\.p-toast \\.p-toast-message \\.p-toast-message-content \\.p-toast-message-text$", "property": "margin", "value": "0 0 0 var(--awe-space-3)"},
    {"selector": "^\\.p-toast \\.p-toast-message \\.p-toast-message-content \\.p-toast-detail$", "property": "margin", "value": "var(--awe-space-0-5) 0 0 0"},
    {"selector": "^\\.p-toast \\.p-toast-message\\.p-toast-message-(info|success|warn|error)$|^\\.p-message\\.p-message-(info|success|warn|error)$|^\\.p-inline-message\\.p-inline-message-(info|success|warn|error)$", "property": "border-width", "value": "1px"},
    {"selector": "^\\.p-toast \\.p-toast-message\\.p-toast-message-(info|success|warn|error)$|^\\.p-message\\.p-message-(info|success|warn|error)$|^\\.p-inline-message\\.p-inline-message-(info|success|warn|error)$", "property": "color", "value": "var(--awe-color-text)"},
    {"selector": "^\\.p-toast \\.p-toast-message\\.p-toast-message-info$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-info-subtle), var(--awe-color-overlay) 40%)"},
    {"selector": "^\\.p-toast \\.p-toast-message\\.p-toast-message-success$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-success-subtle), var(--awe-color-overlay) 40%)"},
    {"selector": "^\\.p-toast \\.p-toast-message\\.p-toast-message-warn$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-warning-subtle), var(--awe-color-overlay) 40%)"},
    {"selector": "^\\.p-toast \\.p-toast-message\\.p-toast-message-error$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-danger-subtle), var(--awe-color-overlay) 40%)"},
    {"selector": "^\\.p-message\\.p-message-info$|^\\.p-inline-message\\.p-inline-message-info$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-info-subtle), var(--awe-color-surface) 45%)"},
    {"selector": "^\\.p-message\\.p-message-success$|^\\.p-inline-message\\.p-inline-message-success$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-success-subtle), var(--awe-color-surface) 45%)"},
    {"selector": "^\\.p-message\\.p-message-warn$|^\\.p-inline-message\\.p-inline-message-warn$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-warning-subtle), var(--awe-color-surface) 45%)"},
    {"selector": "^\\.p-message\\.p-message-error$|^\\.p-inline-message\\.p-inline-message-error$", "property": "background", "value": "color-mix(in srgb, var(--awe-color-danger-subtle), var(--awe-color-surface) 45%)"},
    {"selector": "^\\.p-message$|^\\.p-inline-message$", "property": "border-radius", "value": "var(--awe-radius-content)"},
    {"selector": "^\\.p-message \\.p-message-text$|^\\.p-inline-message \\.p-inline-message-text$", "property": "font-size", "value": "var(--awe-font-size-sm)"},
    {"selector": "^\\.p-toast \\.p-toast-message \\.p-toast-message-content \\.p-toast-message-icon(\\.p-icon)?$|^\\.p-message \\.p-message-icon(\\.p-icon)?$", "property": "font-size|width|height", "value": "var(--awe-size-icon-lg)"},
    {"selector": "^\\.p-toast \\.p-toast-message \\.p-toast-message-content \\.p-toast-summary$", "property": "font-weight", "value": "var(--awe-font-weight-semibold)"},
    {"selector": "^\\.p-message \\.p-message-wrapper$|^\\.p-inline-message$", "property": "padding", "value": "var(--awe-space-2) var(--awe-space-3)"},

    {"selector": "^\\.p-(datatable|treetable) \\.p-(datatable|treetable)-(header|footer|thead > tr > th|tbody > tr > td|tfoot > tr > td)$", "property": "padding", "value": "var(--awe-grid-cell-padding-y) var(--awe-grid-cell-padding-x)"},
    {"selector": "^\\.p-(datatable|treetable)\\.p-(datatable|treetable)-sm ", "property": "padding", "value": "var(--awe-grid-cell-padding-y) var(--awe-grid-cell-padding-x)"},
    {"selector": "^\\.p-(datatable|treetable)\\.p-(datatable|treetable)-lg ", "property": "padding", "value": "var(--awe-space-4) var(--awe-space-5)"},
    {"selector": "^\\.p-paginator \\.p-paginator-(first|prev|next|last|current)|^\\.p-paginator \\.p-paginator-pages \\.p-paginator-page$", "property": "min-width|height", "value": "var(--awe-size-control-sm)"},
    {"selector": "^\\.p-paginator \\.p-paginator-(first|last)|^\\.p-paginator \\.p-paginator-pages \\.p-paginator-page$", "property": "border(-(top|bottom)-(left|right))?-radius", "value": "var(--awe-radius-md)"},
    {"selector": "^\\.p-paginator \\.p-dropdown$", "property": "height", "value": "var(--awe-size-control-sm)"},
    {"selector": "^\\.p-datatable \\.p-datatable-tbody > tr > td \\.p-row-toggler, ", "property": "width|height", "value": "var(--awe-size-control-sm)"},
    {"selector": "^\\.p-datatable \\.p-datatable-tbody > tr > td \\.p-row-toggler, ", "property": "border-radius", "value": "var(--awe-radius-md)"},
    {"selector": "^\\.p-treetable \\.p-treetable-tbody > tr > td \\.p-treetable-toggler$", "property": "width|height", "value": "var(--awe-space-6)"},
    {"selector": "^\\.p-treetable \\.p-treetable-tbody > tr > td \\.p-treetable-toggler$", "property": "border-radius", "value": "var(--awe-radius-sm)"},

    {"selector": "^\\.p-tabmenu \\.p-tabmenu-nav \\.p-tabmenuitem \\.p-menuitem-link$|^\\.p-tabview \\.p-tabview-nav li \\.p-tabview-nav-link$", "property": "padding", "value": "var(--awe-space-4)"},
    {"selector": "^\\.p-tabmenu \\.p-tabmenu-nav( \\.p-tabmenuitem \\.p-menuitem-link)?$|^\\.p-tabview \\.p-tabview-nav( li \\.p-tabview-nav-link)?$", "property": "border-width", "value": "0 0 1px 0"},
    {"selector": "^\\.p-tabmenu \\.p-tabmenu-nav \\.p-tabmenuitem \\.p-menuitem-link$|^\\.p-tabview \\.p-tabview-nav li \\.p-tabview-nav-link$", "property": "margin", "value": "0 0 -1px 0"},
    {"selector": "^\\.p-tabmenu \\.p-tabmenu-nav \\.p-tabmenuitem \\.p-menuitem-link$", "property": "height", "value": "calc(100% + 1px)"},
    {"selector": "^\\.p-slider\\.p-slider-(horizontal|vertical) \\.p-slider-handle$", "property": "margin-(top|left|bottom)", "value": "calc(var(--awe-space-5) / -2)"},

    {"selector": "^\\.p-tag$|^\\.p-badge$", "property": "font-weight", "value": "var(--awe-font-weight-bold)"},
    {"selector": "^\\.p-tag$", "property": "padding", "value": "var(--awe-space-1) var(--awe-space-2)"},
    {"selector": "^\\.p-tag$", "property": "font-size", "value": "var(--awe-font-size-sm)"},
    {"selector": "^\\.p-progressbar$", "property": "height", "value": "var(--awe-space-5)"},
    {"selector": "^\\.p-progressbar$", "property": "background", "value": "var(--awe-color-secondary)"},
    {"selector": "^\\.p-progressbar$", "property": "border-radius", "value": "var(--awe-radius-full)"}
  ],
  "values": {
    "box-shadow": {
      "0 0 0 0.2rem #c7d2fe": [
        {"selector": "\\.p-(inputtext|dropdown|multiselect|autocomplete|cascadeselect|treeselect|chips|password|inputnumber)(?![-\\w])", "value": "--awe-shadow-field-focus"},
        {"value": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-focus-ring)"}
      ],
      "0 0 0 0.2rem #e2e8f0": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-on-secondary)",
      "0 0 0 0.2rem #bfdbfe": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-info)",
      "0 0 0 0.2rem #bbf7d0": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-success)",
      "0 0 0 0.2rem #fde68a": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-warning)",
      "0 0 0 0.2rem #e9d5ff": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-contrast)",
      "0 0 0 0.2rem #fecaca": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-danger)",
      "0 0 0 2px #ffffff, 0 0 0 4px #b1b3f8, 0 1px 2px 0 rgb(0, 0, 0)": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-focus-ring)",
      "0 0 0 2px #ffffff, 0 0 0 4px #b0b9c6, 0 1px 2px 0 rgb(0, 0, 0)": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-on-secondary)",
      "0 0 0 2px #ffffff, 0 0 0 4px #83d3f8, 0 1px 2px 0 rgb(0, 0, 0)": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-info)",
      "0 0 0 2px #ffffff, 0 0 0 4px #88eaac, 0 1px 2px 0 rgb(0, 0, 0)": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-success)",
      "0 0 0 2px #ffffff, 0 0 0 4px #fcb98b, 0 1px 2px 0 rgb(0, 0, 0)": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-warning)",
      "0 0 0 2px #ffffff, 0 0 0 4px #d4aafb, 0 1px 2px 0 rgb(0, 0, 0)": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-contrast)",
      "0 0 0 2px #ffffff, 0 0 0 4px #f7a2a2, 0 1px 2px 0 rgb(0, 0, 0)": "0 0 0 var(--awe-focus-ring-offset) var(--awe-color-surface), 0 0 0 calc(var(--awe-focus-ring-offset) + var(--awe-focus-ring-width)) var(--awe-color-danger)",
