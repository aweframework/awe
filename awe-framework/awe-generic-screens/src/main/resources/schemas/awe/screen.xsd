    <xs:attribute name="style" type="xs:string" />
    <xs:attribute name="orientation" type="orientationEnum" />
  </xs:attributeGroup>

  <!-- Grid Attributes -->
  <xs:attributeGroup name="gridAttr">
    <xs:attribute name="id" use="required" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Grid identifier. It is the key of the grid on the screen and the name of the grid variables sent to the server (for example id-RowTyp). Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Component name stored in the screen model. Neither client engine uses it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS classes added to the grid.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multiselect" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Allows selecting several rows and adds a checkbox column to select them. Default: false. In a tree grid the React engine only supports single selection.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="checkbox-multiselect" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Read by the model but not implemented by either client engine; use multiselect to get a checkbox column. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="send-operations" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Makes the grid editable and sends only the rows that were inserted, updated or deleted, with the type of operation of each row in the id-RowTyp parameter, and shows an operation icon column. It takes precedence over editable in the AngularJS engine. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="editable" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Allows editing rows. In AngularJS the selected row is edited in place with save and cancel buttons; in React a row is edited with a row editor opened by double click. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show-totals" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows a footer row with the summary of each column that has a summary-type. AngularJS only calculates sums, whatever the summary-type; React supports sum, avg, max and min. When the rows are grouped, the footer is the grand total of all the rows. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group-by" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Comma-separated column names that group the rows, one grouping level each, in order; unknown names are ignored. Each group row shows its value, its row count and the aggregates of the columns with a summary-type (sum, avg, max, min) in both engines. A grouped grid loads every row (as load-all) and does not paginate. Ignored on tree grids and on editable, send-operations, move-rows and row-detail grids.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group-selector" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows a "Group by" control in the toolbar to choose the grouping levels at runtime (visible columns with a label and without summary-type). Like group-by, it makes the grid load every row. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group-subtotals" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Closes each group with a subtotal row with the aggregates of the group. Only used when the rows are grouped. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enable-filters" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows a filter for each column. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row-numbers" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Adds a first column with the row number. Not shown in tree grids. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="move-rows" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Adds a leading column with a grip to move the rows by dragging them. The Alt+arrow shortcuts to move the selected row are also enabled. Not available in tree grids. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="treegrid" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows the data as a tree grid instead of a plain grid. The rows are related by the tree-id and tree-parent fields. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-id" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Name of the field that identifies each row. Default: id.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-parent" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Name of the field with the identifier of the parent row. Default: parent.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-leaf" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Name of the field that tells whether a row is a leaf. Default: isLeaf.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="expand-column" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Name of the column that holds the expand and collapse toggle. React only (default: the tree-id field); the AngularJS engine ignores it and shows the toggle in the row header.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-expand" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Icon of a collapsed node (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name). Default: plus-square. Both engines.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-collapse" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Icon of an expanded node (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name). Default: minus-square. Both engines.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-loading" type="loadingIconEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Style of the loading indicator shown while the grid loads. skeleton shows placeholder rows with the grid columns on every load; skeleton-dim shows them on the first load and dims the rows on a reload. Default: the awe.application.component.grid-icon-loading property (skeleton). Set another value (spinner...) to disable the skeleton on this grid.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="initial-level" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Number of levels expanded after loading: a value of N expands N-1 levels, so 0 and 1 both start collapsed. Both engines; a row that carries an expanded field is expanded or collapsed by it, and only loaded nodes are expanded by the level.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-leaf" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tree grid only. Icon of a node without children (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name). Default: dot-circle-o. Both engines.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="load-all" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Loads every row at once (max is ignored) and sorts and paginates locally in the client. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="send-all" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Sends the values of all the grid rows to the server instead of only the selected ones; the selected rows are then sent in the id.selected parameter. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="help" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Help text of the grid. AngularJS shows it in the column headers; React does not show it for grids.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="help-image" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Path of an image shown in the grid help. AngularJS only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="validate-on-save" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">When false, the row being edited is not validated before it is saved, or before the page is changed. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pagination-disabled" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Hides the paginator of the grid. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pager-values" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Comma separated list of rows-per-page values the user can choose in the paginator (for example 5,25,50,100). Every value must be an integer. Without it AngularJS shows no selector and React offers 10, 20 and 30 plus the max value.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Initial visibility of the grid. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="row-height" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Minimum height of each row in pixels. Plain grids in both engines (AngularJS default 27); tree grids ignore it in both.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show-toolbar" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows the grid toolbar, with the Columns dialog (show, hide and reorder columns, saved per user) and the Maximize button. Set it to false to opt out. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="columns-panel" type="gridColumnsPanelEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the toolbar shows the Columns of the grid: popover (anchored to the Columns button, the grid stays in view), dialog (a modal dialog in the middle of the screen) or side-panel (a panel anchored to the right edge). Both engines. Default: the property awe.application.component.grid-columns-panel (popover unless the application changes it).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="empty-title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Title (locale or text) shown in the empty state of the grid. Default: a translated "No records" title</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="empty-text" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Description (locale or text) shown in the empty state of the grid. Default: a translated "No records match the search" text</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="empty-icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown in the empty state of the grid (grid without rows). Default: an inbox icon</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="empty-action" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Identifier of a button of the grid. The empty state shows a button with its label and icon that runs the button actions</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="serverCallAttr" />
  </xs:attributeGroup>

  <!-- PivotTable Attributes -->
  <xs:attributeGroup name="pivotTableAttr">
    <xs:attribute name="id" use="required" type="nameEnum" />
    <xs:attribute name="style" type="xs:string" />
    <xs:attribute name="total-column-placement" type="PivotColumnPlacementEnum" />
    <xs:attribute name="total-row-placement" type="PivotRowPlacementEnum" />
    <xs:attribute name="cols" type="xs:string" />
    <xs:attribute name="rows" type="xs:string" />
    <xs:attribute name="renderer" type="PivotRendererEnum" />
    <xs:attribute name="aggregator" type="PivotAggregatorEnum" />
    <xs:attribute name="aggregation-field" type="xs:string" />
    <xs:attribute name="sort-method" type="PivotSortMethodEnum" />
    <xs:attribute name="decimal-numbers" type="xs:integer"/>
    <xs:attribute name="thousand-separator" type="xs:string"/>
    <xs:attribute name="decimal-separator" type="xs:string"/>    
    <xs:attributeGroup ref="serverCallAttr" />
  </xs:attributeGroup>

  <!-- Group Header Column Attributes -->
  <xs:attributeGroup name="columnGroupHeaderAttr">
    <xs:attribute use="required" name="name" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Required by the schema, but the model does not read it: the group header position comes from the columns it contains.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text shown over the grouped columns. It is a localization key that is translated. The header spans all the columns it contains, starting at the first one.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Column Attributes -->
  <xs:attributeGroup name="columnAttr">
    <xs:attribute name="name" use="required" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the field of the data list shown in the column. It is also the column identifier. Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS class applied to the column. AngularJS applies it to the header and the cells; in React plain text cells ignore it and only column components use it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Column header text. It is a localization key that is translated.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Static value of the column. Cell values normally come from the query, so no client engine uses it for plain cells.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="component" type="columnComponentType">
      <xs:annotation>
        <xs:documentation xml:lang="en">Component used to show or edit the cell value. Without it the cell shows plain text. The link component only exists in React; progress, image, icon, text-view, button, formatted-text and sparkline are display components. In React the editors of text, textarea, date, time, filtered-calendar, select-multiple, suggest and suggest-multiple only appear while a row is being edited; otherwise the cell is plain text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown in the cell (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name). Used by text-view and button columns; an icon or unit sent in the cell data overrides it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tooltip of the buttons of a button column (a locale key); a title sent in the cell data overrides it. A cell button without label shows only its icon and the title is its accessible name. Supported by both client engines.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unit" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Unit text shown to the right of the cell value (text-view, numeric and text cells). A unit sent in the cell data overrides it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="cellDataTypes">
      <xs:annotation>
        <xs:documentation xml:lang="en">Type of the data of the column, used when printing so exported cells get the right format. It is not used for sorting or filtering. An invalid value makes the report fail.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="server-action" type="serverActionEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Server action that loads the options of the column component (for example the values of a select).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="target-action" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Query or enumerated that provides the options of the column component (select, suggest, radio and button-radio columns).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="initial-load" type="initialLoadEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the options of the column component are loaded when the screen is built: query, enum or value.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autorefresh" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Reloads the column options from the server every this many seconds. No client engine applies it specifically to columns.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="alignEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Horizontal alignment of the cell text: left, center or right. The header is always centered. It also sets the alignment in printed reports.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="charlength" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Column width in characters. AngularJS uses it only when width is not set (characters times the character size, 8 pixels by default); React always uses it, as (characters + 4) times 8 pixels, and ignores width. Printed reports use it too.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="columnWidth">
      <xs:annotation>
        <xs:documentation xml:lang="en">Column width: a number of pixels, or * to share the free space. AngularJS uses it before charlength and also accepts a percentage (for example 20%), which this schema does not allow and which fails when printing. React ignores it and uses charlength. In reports, * is a fixed width.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="wrap" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">The text of the cells wraps over several lines and the row grows to fit it, in both client engines. Without it (or with false) the text is one line cut with an ellipsis, as before. In AngularJS the row-height of the grid becomes the minimum row height, and a grid with frozen columns keeps its single-line rows. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max-lines" type="xs:positiveInteger">
      <xs:annotation>
        <xs:documentation xml:lang="en">Maximum number of lines of a wrapping cell; it implies wrap unless wrap is false. Line N ends in an ellipsis when the text is longer, and the full text shows on hover and on keyboard focus.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="secondary-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of another field of the row whose value is shown under the main value, smaller and muted. An empty secondary value shows only the main line. Sorting, filtering and export use the main value. Combines with plain text and with status-field; ignored in columns with a component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="export-secondary" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Print and export add a column right after this one with the value of secondary-field, titled with secondary-label (or the column label without it). Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="secondary-label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Label (i18n key) of the column that export-secondary adds to print and export. Default: the column label.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="status-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of a field of the row with the tone of the cell: success, warning, danger, info or neutral. The main value is shown as a status, a dot plus the text, so the tone never relies on colour alone. An unknown or empty tone is neutral. Ignored with chips="true" and in columns with a component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="chips" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">The main value is split by chip-separator and each item, trimmed and not empty, is shown as a chip. Takes precedence over status-field; ignored in columns with a component. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="chip-separator" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text that separates the items of a chips column. Default: , (comma).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max-chips" type="xs:positiveInteger">
      <xs:annotation>
        <xs:documentation xml:lang="en">Maximum number of chips of a chips column. The first N chips are shown plus a +n chip whose tooltip and accessible label list the hidden items. Default: all the chips.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar-min" type="xs:decimal">
      <xs:annotation>
        <xs:documentation xml:lang="en">Only for component="progress", React engine only (AngularJS ignores it). Lower end of the scale of the bar. Below 0 a zero mark is drawn and negative values fill to the left of it in the negative colour. Default: 0. It does not reuse the column max attribute, which sets the option rows of the column.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar-max" type="xs:decimal">
      <xs:annotation>
        <xs:documentation xml:lang="en">Only for component="progress", React engine only (AngularJS ignores it). Upper end of the scale of the bar: a value of 4.13 with bar-max="40" fills 10.325 % of the bar. Default: 100. It does not reuse the column max attribute, which sets the option rows of the column.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar-second-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Only for component="progress", React engine only (AngularJS ignores it). Name of a field of the row with a second value (a target, for instance) drawn as a thinner bar under the main one, on the same scale (bar-min and bar-max). Print and export write the cell value only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar-stack-fields" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Only for component="progress", React engine only (AngularJS ignores it). Comma-separated names of fields of the row: the bar is drawn as stacked segments with their values (positive numbers, in the given order). The cell value stays the accessible value and the one that print and export write.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bar-leaf-only" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Only for component="progress", React engine only (AngularJS ignores it). In a tree grid the bar is drawn only on leaf rows. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="avatar-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of a field of the row with the name (or the initials) the avatar is built from. The cell shows a small round avatar with its initials (the first letter of its first and its last word that start with a letter, in upper case) before the main value and its secondary line. An empty value shows no avatar. The avatar is decorative: sorting, filtering, print and export use the main value. Ignored in columns with a component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="avatar-tone-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of a field of the row with the tone of the avatar: primary, info, success, warning, danger or neutral. An unknown or empty tone is neutral. Only with avatar-field.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of a field of the row with an icon (lucide:name, fa-name...) shown before the main value. With status-field the icon takes the place of the dot, so the status is a plain tag (a row without icon shows the tag without dot nor icon). The icon is decorative: the main value is the accessible text, and sorting, filtering, print and export use it. Ignored with chips="true" and in columns with a component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sort-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field used to sort the column. Default: the column name.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hidden" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Hides the column. Hidden columns are still sent to the server and can be printed with printable. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Not applied: the initial visibility of a column is the opposite of hidden, so visible=false has no effect on its own. Dependencies can still change the visibility at run time.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sortable" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Allows sorting by the column. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="movable" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Stored by the model but not applied: neither client engine uses it to allow or forbid moving the column. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>    
    <xs:attribute name="sendable" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Sends the column values to the server (and to the print request). A printed column that is not sendable shows empty cells. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="optional" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">For select and suggest column components, allows clearing the value. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="summary-type" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Calculation shown in the grid footer when show-totals is true, and in the group and subtotal rows of a grouped grid (both engines). AngularJS always calculates a sum; React supports sum, avg, max and min and shows nothing for other values.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="number-format" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Number format options (autoNumeric style) of numeric cells and of the footer total. Both engines apply it; React translates only the common options.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="validation" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Validation rules of the cell (for example required), applied when the cell is editable.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="formatter" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Stored by the model but not used by either client engine or by printing.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="format-options" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Stored by the model but not used by either client engine or by printing.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frozen" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Pins the column on the left so it stays out of the horizontal scroll. Both client engines; do not use it when the header has more than one line. React moves the frozen columns to the left (with the row number and checkbox columns) and keeps single-line rows; it ignores frozen in a grid with grouped headers and in a tree grid. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pagebreak" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Stored by the model but not used by either client engine or by printing.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sparkline-type" type="sparklineTypeEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Drawing of the series of a sparkline column: line, bar or area. Only the sparkline component reads it. Default: line.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sparkline-color" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS colour of the series of a sparkline column (for example #3b82f6 or rgb(59, 130, 246)). A value that is not a plain colour is ignored. Default: blue.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sparkline-negative-color" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS colour used for the negative values of a sparkline column: the bars below zero, or the parts of the line and the area that go below zero. Without it negative values use the colour of the series.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sparkline-last-point" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Highlights the last point of the series of a sparkline column with a dot (line and area) or a dark outline (bar). Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sparkline-min-max" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Marks the lowest (red) and highest (green) points of the series of a sparkline column. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="printable" type="printableEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the column goes to printed reports: true always prints it, even if hidden; excel prints it only in spreadsheet formats (XLSX, CSV); false never prints it. Without it the column is printed only when it is visible on screen. Only the AngularJS engine sends this information; React ignores it and prints the visible columns.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="help" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Help text shown in the column header. AngularJS only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="help-image" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Path of an image shown in the column help. AngularJS only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="check-initial" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Stored by the model for suggest cells; neither client engine reads it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="checked" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Checkbox cells only. Initial checked state. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="readonly" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Prevents editing the cell when the column has an editable component. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Maximum number of rows retrieved for the column options when the column is loaded from a target. Default: the awe.application.component.criteria-rows-per-page property (100).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dialog" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Stored by the model but not used by either client engine.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show-weekends" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Date cells only. Shows the weekends in the calendar. The AngularJS engine honours it; React ignores it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="strict" type="xs:boolean">
      <xs:annotation>
        <xs:documentation xml:lang="en">Suggest cells only. When true (the default) the value must be one of the values suggested by the server. AngularJS only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Action Attributes -->
  <xs:attributeGroup name="actionAttr">
    <xs:attribute name="server-action" type="serverActionEnum" />
    <xs:attribute name="target-action" type="xs:string" />
    <xs:attribute name="target" type="xs:string" />
    <xs:attribute name="type" use="required" type="buttonActionEnum" />
    <xs:attribute name="context" type="xs:string" />
    <xs:attribute name="silent" type="booleanEnum" />
    <xs:attribute name="async" type="booleanEnum" />
    <xs:attribute name="value" type="xs:string" />
  </xs:attributeGroup>

  <!-- Dependency Attributes -->
  <xs:attributeGroup name="dependencyAttr">
    <xs:attributeGroup ref="serverCallAttr" />
    <xs:attribute name="initial" type="booleanEnum" />
    <xs:attribute name="invert" type="booleanEnum" />
    <xs:attribute name="type" type="dependencyJoinEnum" />
    <xs:attribute name="label" type="xs:string" />
    <xs:attribute name="value" type="xs:string" />
    <xs:attribute name="formule" type="xs:string" />
    <xs:attribute name="source-type" type="dependencySourceEnum" />
    <xs:attribute name="target-type" type="dependencyTargetEnum" />
    <xs:attribute name="silent" type="booleanEnum" />
    <xs:attribute name="async" type="booleanEnum" />
  </xs:attributeGroup>

  <!-- Dependency Element Attributes -->
  <xs:attributeGroup name="dependencyElementAttr">
    <xs:attribute name="id" use="required" type="nameEnum" />
    <xs:attribute name="condition" type="dependencyConditionEnum" />
    <xs:attribute name="value" type="xs:string" />
    <xs:attribute name="name" type="nameEnum" />
    <xs:attribute name="event" type="eventEnum" />
    <xs:attribute name="optional" type="booleanEnum" />
    <xs:attribute name="cancel" type="booleanEnum" />
    <xs:attribute name="row" type="xs:string" />
    <xs:attribute name="id2" type="xs:string" />
    <xs:attribute name="attribute" type="criteriaAttributeEnum" />
    <xs:attribute name="attribute2" type="criteriaAttributeEnum" />
    <xs:attribute name="alias" type="xs:string" />
    <xs:attribute name="column" type="nameEnum" />
    <xs:attribute name="column2" type="nameEnum" />
    <xs:attribute name="view" type="viewEnum" />
    <xs:attribute name="view2" type="viewEnum" />
    <xs:attribute name="check-changes" type="booleanEnum" />
  </xs:attributeGroup>

  <!-- Info Attributes -->
  <xs:attributeGroup name="infoAttr">
    <xs:attributeGroup ref="serverCallAttr" />
    <xs:attribute name="id" use="required" type="nameEnum" />
    <xs:attribute name="field" type="xs:string" />
    <xs:attribute name="title" type="xs:string" />
    <xs:attribute name="label" type="xs:string" />
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="style" type="xs:string" />
    <xs:attribute name="dropdown-style" type="xs:string" />
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="session" type="xs:string" />
    <xs:attribute name="value" type="xs:string" />
    <xs:attribute name="property" type="xs:string" />
    <xs:attribute name="unit" type="xs:string" />
  </xs:attributeGroup>

  <!-- Menu Container Attributes -->
  <xs:attributeGroup name="menuContainerAttr">
    <xs:attribute name="id" type="xs:string" />
    <xs:attribute name="type" type="orientationEnum" />
    <xs:attribute name="style" type="xs:string" />
  </xs:attributeGroup>

  <!-- Frame Attributes -->
  <xs:attributeGroup name="frameAttr">
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="screen" type="xs:string" />
    <xs:attribute name="screen-variable" type="xs:string" />
    <xs:attribute name="scroll" type="yesNoEnum" />
    <xs:attribute name="server-action" type="serverActionEnum" />
  </xs:attributeGroup>

  <!-- View Attributes -->
  <xs:attributeGroup name="viewAttr">
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="style" type="xs:string" />
  </xs:attributeGroup>

  <!-- Message Attributes -->
  <xs:attributeGroup name="messageAttr">
    <xs:attribute name="id" use="required" type="xs:string" />
    <xs:attribute name="message" use="required" type="xs:string" />
    <xs:attribute name="title" use="required" type="xs:string" />
  </xs:attributeGroup>

  <!-- Javascript Attributes -->
  <xs:attributeGroup name="javascriptAttr">
    <xs:attribute name="id" use="required" type="xs:string" />
  </xs:attributeGroup>

  <!-- Dialog Attributes -->
  <xs:attributeGroup name="dialogAttr">
    <xs:attribute name="modal" type="booleanEnum" />
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="help" type="xs:string" />
    <xs:attribute name="help-image" type="xs:string" />
    <xs:attribute name="on-close" type="onCloseEnum" />
    <xs:attribute name="deferred" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">When true, the initial load of the dialog components does not run with the screen: it runs when the dialog is opened for the first time. Default false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Side Panel Attributes -->
  <xs:attributeGroup name="sidePanelAttr">
    <xs:attribute name="position" type="sidePanelPositionEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edge of the screen the panel is anchored to. Default: right.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max-width" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Maximum width of the panel as a CSS length (480px, 30rem, 50vw...). The panel takes the width of the screen up to this maximum. Default: 40rem.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="header-grid" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Identity header: id of a grid of the screen. While exactly one row of that grid is selected, the header of the panel shows that row (a large avatar, a title, a muted subtitle and the header-tag children) instead of the label and the icon; with no row or several rows selected it shows the label and the icon. The header follows the selected row while the panel is open, and the title is the accessible name of the panel. Without it the header does not change. Supported by both client engines.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="header-title-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field of the selected row of header-grid with the title of the identity header (for example the full name).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="header-subtitle-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field of the selected row of header-grid with the subtitle of the identity header, shown muted under the title. Not shown when empty.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="header-avatar-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field of the selected row of header-grid the avatar of the identity header is built from: its initials (the first letter of its first and last words), as the avatar-field of a grid column. Decorative. No avatar when it is empty.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="header-avatar-tone-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field of the selected row of header-grid with the tone of the avatar: primary, info, success, warning, danger or neutral (any other value, or none, is neutral).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Popover Attributes -->
  <xs:attributeGroup name="popoverAttr">
    <xs:attribute name="anchor" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">Id of the control of the screen the popover is anchored to.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="position" type="popoverPositionEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Side of the anchor where the popover opens: bottom, top, left or right. Default: bottom.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max-width" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Maximum width of the popover as a CSS length (320px, 20rem, 30vw...). Default: 20rem.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Tab Container (tab page) Attributes -->
  <xs:attributeGroup name="tabcontainerAttr">
    <xs:attribute name="deferred" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">When true, the initial load of the tab page components does not run with the screen: it runs when the tab page is selected for the first time. Default false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Javascript Attributes -->
  <xs:attributeGroup name="includeAttr">
    <xs:attribute name="target-screen" type="xs:string" use="required" />
    <xs:attribute name="target-source" type="xs:string" />
  </xs:attributeGroup>

  <!--
  ==============================================================================
  Group definitions
  ==============================================================================
  -->
  <xs:group name="elementGroup">
    <xs:choice>
      <xs:element ref="grid" />
      <xs:element ref="accordion" />
      <xs:element ref="pivot-table" />
      <xs:element ref="window" />
      <xs:element ref="advanced" />
      <xs:element ref="card" />
      <xs:element ref="resizable" />
      <xs:element ref="tag" />
      <xs:element ref="tab" />
      <xs:element ref="video" />
      <xs:element ref="map" />
      <xs:element ref="link" />
      <xs:element ref="image" />
      <xs:element ref="wizard" />
      <xs:element ref="criteria" />
      <xs:element ref="button" />
      <xs:element ref="avatar" />
      <xs:element ref="message" />
      <xs:element ref="text" />
      <xs:element ref="widget" />
      <xs:element ref="chart" />
      <xs:element ref="javascript" />
      <xs:element ref="include" />
      <xs:element ref="dialog" />
      <xs:element ref="side-panel" />
      <xs:element ref="popover" />
      <xs:element ref="info" />
      <xs:element ref="info-button" />
      <xs:element ref="info-criteria" />
      <xs:element ref="menu-container" />
      <xs:element ref="frame" />
      <xs:element ref="view" />
      <xs:element ref="tag-list" />
    </xs:choice>
  </xs:group>

  <!--
  ==============================================================================
  Type definitions
  ==============================================================================
  -->

  <!-- Screen Type -->
  <xs:complexType name="screenType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="tag" />
      <xs:element ref="javascript" />
      <xs:element ref="message" />
    </xs:choice>
    <xs:attributeGroup ref="screenAttr" />
  </xs:complexType>
  
  <!-- Accordion Type -->
  <xs:complexType name="accordionType">
    <xs:choice minOccurs="1" maxOccurs="unbounded">
      <xs:sequence minOccurs="1" maxOccurs="unbounded">
        <xs:element ref="accordion-item" />
      </xs:sequence>
      <xs:element ref="dependency" />
    </xs:choice>
    <xs:attributeGroup ref="accordionAttr" />
  </xs:complexType>
  
  <!-- Accordion Item Type -->
  <xs:complexType name="accordionItemType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="accordionItemAttr" />
  </xs:complexType>

  <!-- Element Type -->
  <xs:complexType name="elementType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="elementAttr" />
  </xs:complexType>

  <!-- HTML Tag Type (the tag element) -->
  <xs:complexType name="htmlTagType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="elementAttr" />
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown before the label of the tag (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name), decorative. With style="section-title" a heading tag (h2, h3, h4) is the title of a section of a form: the icon and the label in one line, and a separator line above every section title but the first one of its container. Supported by both client engines.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Element Type -->
  <xs:complexType name="videoType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="videoAttr" />
  </xs:complexType>

  <!-- Map Type -->
  <xs:complexType name="mapType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="dependency" />
    </xs:choice>
    <xs:attributeGroup ref="mapAttr" />
  </xs:complexType>

  <!-- Element Type -->
  <xs:complexType name="linkType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="linkAttr" />
  </xs:complexType>

  <!-- Element Type -->
  <xs:complexType name="imageType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="imageAttr" />
  </xs:complexType>

  <!-- Criteria Base Type -->
  <xs:complexType name="criteriaBaseType">
    <xs:attributeGroup ref="criteriaAttr" />
  </xs:complexType>

  <!-- Criteria Type -->
  <xs:complexType name="criteriaType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Content of a criterion: optional dependencies, context buttons and context separators. The id attribute is required.</xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="criteriaBaseType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="dependency" />
          <xs:element ref="context-button" />
          <xs:element ref="context-separator" />
        </xs:choice>
        <xs:attribute use="required" name="id" type="nameEnum" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Info Type -->
  <xs:complexType name="infoType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="dependency" />
      <xs:element ref="info-button" />
      <xs:element ref="info-criteria" />
      <xs:element ref="tag" />
      <xs:element ref="include" />
      <xs:element ref="info" />
      <xs:element ref="button-action" />
    </xs:choice>
    <xs:attributeGroup ref="infoAttr" />
  </xs:complexType>

  <!-- Info Button Type -->
  <xs:complexType name="infoButtonType">
    <xs:complexContent>
      <xs:extension base="buttonType">
        <xs:attribute name="title" type="xs:string" />
        <xs:attribute name="info-style" type="xs:string" />
        <xs:attribute name="unit" type="xs:string" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Info Criteria Type -->
  <xs:complexType name="infoCriteriaType">
    <xs:complexContent>
      <xs:extension base="criteriaType">
        <xs:attribute name="info-style" type="xs:string" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Menu Container Type -->
  <xs:complexType name="menuContainerType">
    <xs:attributeGroup ref="menuContainerAttr" />
  </xs:complexType>

  <!-- Frame Type -->
  <xs:complexType name="frameType">
    <xs:attributeGroup ref="frameAttr" />
  </xs:complexType>

  <!-- View Type -->
  <xs:complexType name="viewType">
    <xs:attributeGroup ref="viewAttr" />
  </xs:complexType>

  <!-- Button Type -->
  <xs:complexType name="buttonType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="tag" />
      <xs:element ref="include" />
      <xs:element ref="button-action" />
      <xs:element ref="dependency" />
      <xs:element ref="context-button" />
      <xs:element ref="context-separator" />
    </xs:choice>
    <xs:attributeGroup ref="buttonAttr" />
    <xs:attribute name="show-loading" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Busy state (true by default): when the action launched by the button is still running after a short time, the button shows a spinner instead of its icon until it ends. false turns it off.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selection" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Only for the buttons of a grid (false by default). true makes it an action on the selected rows: it is not shown in the footer of the grid but in its selection bar, which appears between the toolbar and the header of the grid while one or more rows are selected, with the number of selected rows and these buttons in the order of the screen, small and at the right. The button keeps all its behaviour (actions, dependencies, confirmations). With style="btn-danger" it is the destructive action (Delete) and is drawn in the danger colour. In a grid without multiselect the bar shows the one selected row. Supported by both client engines.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Context Button Type -->
  <xs:complexType name="contextButtonType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="context-button" />
      <xs:element ref="context-separator" />
      <xs:element ref="button-action" />
      <xs:element ref="dependency" />
    </xs:choice>
    <xs:attributeGroup ref="buttonAttr" />
  </xs:complexType>

  <!-- Button Type -->
  <xs:complexType name="avatarType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="info" />
      <xs:element ref="info-button" />
      <xs:element ref="info-criteria" />
      <xs:element ref="tag" />
      <xs:element ref="include" />
      <xs:element ref="button-action" />
      <xs:element ref="dependency" />
    </xs:choice>
    <xs:attributeGroup ref="avatarAttr" />
  </xs:complexType>

  <!-- Context Separator Type -->
  <xs:complexType name="contextSeparatorType">
    <xs:attribute name="name" type="xs:string" />
  </xs:complexType>

  <!-- Window Type -->
  <xs:complexType name="windowType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="windowAttr" />
  </xs:complexType>

  <!-- Advanced Type -->
  <xs:complexType name="advancedType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attribute name="id" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Identifier of the advanced block. Optional: the server generates one when it is missing.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS classes of the advanced block.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Card Type -->
  <xs:complexType name="cardType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="elementGroup" />
      <xs:element ref="dependency" />
    </xs:choice>
    <xs:attributeGroup ref="cardAttr" />
  </xs:complexType>

  <!-- Resizable Type -->
  <xs:complexType name="resizableType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="resizableAttr" />
  </xs:complexType>

  <!-- Grid Type -->
  <xs:complexType name="gridType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Content of a grid: columns, group headers, buttons, context buttons and separators, dependencies, an optional row detail, an optional quick filter and an optional search, in any order and number.</xs:documentation>
    </xs:annotation>
    <xs:choice maxOccurs="unbounded">
      <xs:element minOccurs="0" ref="group-header" />
      <xs:element minOccurs="0" ref="column" />
      <xs:element minOccurs="0" ref="row-detail" />
      <xs:element minOccurs="0" ref="quick-filter" />
      <xs:element minOccurs="0" ref="search" />
      <xs:element minOccurs="0" ref="button" />
      <xs:element minOccurs="0" ref="context-button" />
      <xs:element minOccurs="0" ref="context-separator" />
      <xs:element minOccurs="0" ref="dependency" />
    </xs:choice>
    <xs:attributeGroup ref="gridAttr" />
  </xs:complexType>

  <!-- Quick filter Type -->
  <xs:complexType name="quickFilterType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Attributes of the quick filters of a grid. It has no content.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="id" use="required" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Identifier of the quick filter. It is also the name of the parameter that sends its value with the requests of the grid. Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="initial-load" use="required" type="initialLoadEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Where the options come from: query runs the target query (the usual case, to get the counts) and enum reads the target enumerated. Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="target-action" use="required" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Query or enumerated that returns the options, one row per option with the fields value, label, count (optional) and tone (optional). The query receives the values of the screen, so its counts can follow the other filters of the grid. Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="server-action" type="serverActionEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Server action that reloads the options. Default: data.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Option chosen when the screen is opened. Default: empty, the option with an empty value (All); with no option of that value the first option is shown as chosen.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accessible name of the group of buttons, read by screen readers (a localization key). It is not shown. Default: SCREEN_TEXT_FILTERS.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Grid search Type -->
  <xs:complexType name="gridSearchType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Attributes of the search field of a grid. It has no content.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="id" use="required" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Identifier of the search. It is also the name of the parameter that sends its value with the requests of the grid. Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="placeholder" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text shown in the empty field, such as "User, name or email…" (a localization key).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accessible name of the field, read by screen readers (a localization key). It is not shown. Default: BUTTON_SEARCH.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text of the field when the screen is opened. Default: empty, the grid unfiltered.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- PivotTable Type -->
  <xs:complexType name="pivotTableType">
    <xs:choice maxOccurs="unbounded">
      <xs:element minOccurs="0" ref="context-button" />
      <xs:element minOccurs="0" ref="context-separator" />
      <xs:element minOccurs="0" ref="dependency" />
    </xs:choice>
    <xs:attributeGroup ref="pivotTableAttr" />
  </xs:complexType>

  <!-- GroupHeader columns Type -->
  <xs:complexType name="groupHeaderType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Content of a group header: the columns it spans. The columns must be consecutive, because the header starts at the first column and spans as many columns as it contains.</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="column" />
    </xs:choice>
    <xs:attributeGroup ref="columnGroupHeaderAttr" />
  </xs:complexType>

  <!-- Row detail Type -->
  <xs:complexType name="rowDetailType" mixed="true">
    <xs:annotation>
      <xs:documentation xml:lang="en">Template of the row detail (plain text with {name} placeholders) or its component (a single read-only grid, inline or through an include), and the CSS classes of its area.</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0">
      <xs:element ref="grid" />
      <xs:element ref="include" />
    </xs:choice>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS classes added to the area of the detail, to give it a background, a border or a font. A template itself stays plain text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Column Type -->
  <xs:complexType name="columnType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Content of a column: optional dependencies and button actions. The button actions run when the user clicks a column of component button.</xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="dependency" />
      <xs:element ref="button-action" />
    </xs:choice>
    <xs:attributeGroup ref="columnAttr" />
  </xs:complexType>

  <!-- Tab Container Type -->
  <xs:complexType name="tabcontainerType">
    <xs:complexContent>
      <xs:extension base="elementType">
        <xs:attributeGroup ref="tabcontainerAttr" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Tab Type -->
  <xs:complexType name="tabType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="tabcontainer" />
      <xs:element ref="dependency" />
      <xs:element ref="context-button" />
      <xs:element ref="context-separator" />
    </xs:choice>
    <xs:attributeGroup ref="tabAttr" />
  </xs:complexType>

  <!-- Wizard Type -->
  <xs:complexType name="wizardType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="wizard-panel" />
      <xs:element ref="dependency" />
      <xs:element ref="context-button" />
      <xs:element ref="context-separator" />
    </xs:choice>
    <xs:attributeGroup ref="wizardAttr" />
  </xs:complexType>

  <!-- Action Type -->
  <xs:complexType name="actionType">
    <xs:attributeGroup ref="actionAttr" />
  </xs:complexType>

  <!-- Dependency Type -->
  <xs:complexType name="dependencyType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="dependency-action" />
      <xs:element ref="dependency-element" />
    </xs:choice>
    <xs:attributeGroup ref="dependencyAttr" />
  </xs:complexType>

  <!-- Dependency Element Type -->
  <xs:complexType name="dependencyElementType">
    <xs:attributeGroup ref="dependencyElementAttr" />
  </xs:complexType>

  <!-- Chart Type -->
  <xs:complexType name="chartType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="chart-legend" maxOccurs="1" />
      <xs:element ref="chart-tooltip" maxOccurs="1" />
      <xs:element ref="x-axis" />
      <xs:element ref="y-axis" />
      <xs:element ref="chart-serie" />
      <xs:element ref="chart-parameter" />
      <xs:element ref="dependency" />
      <xs:element ref="context-button" />
      <xs:element ref="context-separator" />
    </xs:choice>
    <xs:attributeGroup ref="chartAttr" />
  </xs:complexType>

  <!-- Chart legend Type -->
  <xs:complexType name="chartLegendType">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="chart-parameter" />
    </xs:sequence>
    <xs:attributeGroup ref="chartLegendAttr" />
  </xs:complexType>

  <!-- Chart tooltip Type -->
  <xs:complexType name="chartTooltipType">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="chart-parameter" />
    </xs:sequence>
    <xs:attributeGroup ref="chartTooltipAttr" />
  </xs:complexType>

  <!-- Chart axis Type -->
  <xs:complexType name="chartAxisType">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="chart-parameter" />
    </xs:sequence>
    <xs:attributeGroup ref="chartAxisAttr" />
  </xs:complexType>

  <!-- Chart series Type -->
  <xs:complexType name="chartSerieType">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="chart-parameter" />
    </xs:sequence>
    <xs:attributeGroup ref="chartSeriesAttr" />
  </xs:complexType>

  <!-- Chart Parameter Type -->
  <xs:complexType name="chartParameterType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="chart-parameter" />
    </xs:choice>
    <xs:attributeGroup ref="chartParameterAttr" />
  </xs:complexType>

  <!-- Widget Type -->
  <xs:complexType name="widgetType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="widget-parameter" />
      <xs:element ref="dependency" />
      <xs:element ref="context-button" />
      <xs:element ref="context-separator" />
    </xs:choice>
    <xs:attributeGroup ref="widgetAttr" />
    <xs:attribute name="id" use="required" type="nameEnum" />
  </xs:complexType>

  <!-- Widget Parameter Type -->
  <xs:complexType name="widgetParameterType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="widget-parameter" />
    </xs:choice>
    <xs:attributeGroup ref="widgetParameterAttr" />
    <xs:attribute name="name" type="nameEnum" />
  </xs:complexType>

  <!-- Tag Type -->
  <xs:complexType name="tagType">
    <xs:attributeGroup ref="tagAttr" />
  </xs:complexType>


  <!-- TagList Type -->
  <xs:complexType name="tagListType">
    <xs:group ref="elementGroup" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="tagListAttr" />
  </xs:complexType>

  <!-- Message Type -->
  <xs:complexType name="messageType">
    <xs:attributeGroup ref="messageAttr" />
  </xs:complexType>

  <!-- Javascript Element -->
  <xs:complexType name="javascriptType">
    <xs:attributeGroup ref="javascriptAttr" />
  </xs:complexType>

  <!-- Dialog Element -->
  <xs:complexType name="dialogType">
    <xs:complexContent>
      <xs:extension base="elementType">
        <xs:attributeGroup ref="dialogAttr" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Side Panel Element -->
  <xs:complexType name="sidePanelType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="elementGroup" />
      <xs:element ref="header-tag" />
    </xs:choice>
    <xs:attributeGroup ref="elementAttr" />
    <xs:attributeGroup ref="dialogAttr" />
    <xs:attributeGroup ref="sidePanelAttr" />
  </xs:complexType>

  <!-- Side panel header tag Type -->
  <xs:complexType name="headerTagType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Attributes of a tag of the identity header of a side panel. It has no content.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="field" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field of the selected row with the text of the tag. The tag is not shown when it is empty. Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tone-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field of the selected row with the tone of the tag: success, warning, danger, info or neutral (any other value, or none, is neutral).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-field" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Field of the selected row with the icon of the tag (an icon name of the Icons page). With it the tag is plain: the icon, if the row has one, takes the place of the dot.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Popover Element -->
  <xs:complexType name="popoverType">
    <xs:complexContent>
      <xs:extension base="elementType">
        <xs:attributeGroup ref="dialogAttr" />
        <xs:attributeGroup ref="popoverAttr" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Include Element -->
  <xs:complexType name="includeType">
    <xs:attributeGroup ref="includeAttr" />
  </xs:complexType>

  <!--
  ==============================================================================
  Restriction definitions
  ==============================================================================
  -->

  <!-- Printable Enumeration -->
  <xs:simpleType name="printableEnum">
    <xs:annotation>
      <xs:documentation xml:lang="en">Printing mode: true always prints, false never prints, excel prints only in spreadsheet formats.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="true" />
      <xs:enumeration value="false" />
      <xs:enumeration value="excel" />
    </xs:restriction>
  </xs:simpleType>

  <!-- View Mode Enumeration  -->
  <xs:simpleType name="captureEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="user" />
      <xs:enumeration value="environment" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="viewModeEnum">
    <xs:annotation>
      <xs:documentation xml:lang="en">Smallest view of a date calendar: days, months or years.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="days" />
      <xs:enumeration value="months" />
      <xs:enumeration value="years" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Initial load Enumeration -->
  <xs:simpleType name="initialLoadEnum">
    <xs:annotation>
      <xs:documentation xml:lang="en">How a component loads its data when the screen is built: from an enumerated, from a query, or from the first row of a query as a value.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="enum" />
      <xs:enumeration value="query" />
      <xs:enumeration value="value" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Button Action Enumeration -->
  <xs:simpleType name="criteriaAttributeEnum">
    <xs:restriction base="xs:string">
      <!-- Widget -->
      <xs:enumeration value="visible" />
      <!-- Input -->
      <xs:enumeration value="value" />
      <xs:enumeration value="text" />
      <xs:enumeration value="label" />
      <xs:enumeration value="unit" />
      <xs:enumeration value="editable" />
      <xs:enumeration value="required" />
      <!-- Input select -->
      <xs:enumeration value="totalValues" />
      <xs:enumeration value="selectedValues" />
      <!-- Table -->
      <xs:enumeration value="currentRow" />
      <xs:enumeration value="prevCurrentRow" />
      <xs:enumeration value="nextCurrentRow" />
      <xs:enumeration value="prevRowValue" />
      <xs:enumeration value="nextRowValue" />
      <xs:enumeration value="selectedRowValue" />
      <xs:enumeration value="footerValue" />
      <xs:enumeration value="selectedRow" />
      <xs:enumeration value="prevRow" />
      <xs:enumeration value="nextRow" />
      <xs:enumeration value="totalRows" />
      <xs:enumeration value="selectedRows" />
      <xs:enumeration value="hasDataColumn" />
      <xs:enumeration value="emptyDataColumn" />
      <xs:enumeration value="fullDataColumn" />
      <xs:enumeration value="currentRowValue" />
      <xs:enumeration value="prevCurrentRowValue" />
      <xs:enumeration value="nextCurrentRowValue" />
      <xs:enumeration value="modifiedRows" />
      <!-- Chart -->
      <xs:enumeration value="xMin" />
      <xs:enumeration value="xMax" />
      <xs:enumeration value="yMin" />
      <xs:enumeration value="yMax" />
      <xs:enumeration value="x" />
      <xs:enumeration value="y" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Event call enumeration -->
  <xs:simpleType name="eventEnum">
    <xs:restriction base="xs:string">
      <!-- Button, ContextOption, Chart -->
      <xs:enumeration value="click" />
      <!-- Dialog -->
      <xs:enumeration value="open" />
      <xs:enumeration value="close" />
      <!-- Grid -->
      <xs:enumeration value="change" />
      <xs:enumeration value="select-row" />
      <xs:enumeration value="before-save-row" />
      <xs:enumeration value="save-row" />
      <xs:enumeration value="after-save-row" />
      <xs:enumeration value="before-cancel-row" />
      <xs:enumeration value="cancel-row" />
      <xs:enumeration value="after-cancel-row" />
      <xs:enumeration value="delete-row" />
