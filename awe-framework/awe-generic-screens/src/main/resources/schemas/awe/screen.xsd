  <!-- Dependency Source Type Enumeration -->
  <xs:simpleType name="dependencySourceEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none" />
      <xs:enumeration value="query" />
      <xs:enumeration value="criteria-value" />
      <xs:enumeration value="criteria-text" />
      <xs:enumeration value="launcher" />
      <xs:enumeration value="value" />
      <xs:enumeration value="label" />
      <xs:enumeration value="formule" />
      <xs:enumeration value="reset" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Dependency Target Type Enumeration -->
  <xs:simpleType name="dependencyTargetEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none" />
      <xs:enumeration value="label" />
      <xs:enumeration value="unit" />
      <xs:enumeration value="icon" />
      <xs:enumeration value="input" />
      <xs:enumeration value="specific" />
      <xs:enumeration value="show" />
      <xs:enumeration value="hide" />
      <xs:enumeration value="show-column" />
      <xs:enumeration value="hide-column" />
      <xs:enumeration value="format-number" />
      <xs:enumeration value="chart-options" />
      <xs:enumeration value="validate" />
      <xs:enumeration value="enable" />
      <xs:enumeration value="disable" />
      <xs:enumeration value="set-required" />
      <xs:enumeration value="set-optional" />
      <xs:enumeration value="set-readonly" />
      <xs:enumeration value="set-editable" />
      <xs:enumeration value="set-visible" />
      <xs:enumeration value="set-invisible" />
