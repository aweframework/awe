    <xs:attribute name="id" type="xs:string" />
  </xs:attributeGroup>

  <!-- Criteria Attributes -->
  <xs:attributeGroup name="criteriaAttr">
    <xs:attribute name="component" type="criteriaComponentType" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">Kind of input: hidden, text, numeric, select, suggest, suggest-multiple, select-multiple, picklist, date, time, filtered-calendar, color, textarea, uploader, checkbox, radio, button-checkbox, button-radio, password, text-view or markdown-editor (progress is accepted by the schema but no engine implements it). picklist exists only in the React engine. Required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text shown above the input. It is a localization key that is translated. A style containing no-label hides it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS classes of the criterion wrapper, usually Bootstrap grid classes such as col-sm-6. React adds col-12 when there is no style.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown next to the input (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name). React does not show it in a textarea.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unit" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Unit text shown after the input (text, password, numeric and text-view). React hides it when the slider is shown and in a textarea.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Size of the input: xs, sm, md or lg. Default: md (property awe.component.size).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="area-rows" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Textarea only. Number of visible rows. Without it the browser default applies.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="placeholder" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Hint text shown inside an empty input. It is a localization key that is translated.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="optional" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Select and select-multiple only. When false the first value is selected automatically if nothing is selected; when true an empty value is allowed and the selection can be cleared. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="optional" default="">
      <xs:annotation>
        <xs:documentation xml:lang="en">Static initial value of the criterion. A comma separated list gives several values. For a checkbox or radio it is the value sent when checked. It has the lowest priority: a screen target, a variable, the stored criteria, the session and the property replace it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="readonly" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Disables the input. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="variable" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the screen variable (a parameter sent from another screen) that gives the initial value. It also names the parameter sent to check a suggest value. Used by the server only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="property" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of an application property whose value is the initial value. Used by the server only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="session" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of a session variable whose value is the initial value. Used by the server only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="validation" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Validation rules (for example required), separated by spaces. A rule list containing required also marks the criterion as required.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="number-format" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Numeric only. Number format options in autoNumeric style (for example min, max, step and precision). AngularJS passes them to autoNumeric; React translates the common options.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show-slider" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Numeric only. Shows a slider below the input. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="capitalize" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Declared but not read by any engine or by the server. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="strict" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Suggest only. When true the value must be one of the values suggested by the server; when false any typed text is accepted. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="message" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Declared but not read by any engine or by the server.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="printable" type="printableEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the criterion goes to printed reports. Only false excludes it; hidden criteria are never printed. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="check-empty" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Includes the criterion in the check that warns when a form is empty. React only looks at the criteria that set it to true; AngularJS ignores the attribute and checks all the top level criteria. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="check-initial" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Declared for suggest criteria; neither client engine nor the server reads it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="check-target" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Suggest only. Query used to find the label of the selected value when only the value is known. Default: the target-action.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="specific" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Declared but not read by any engine or by the server.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="checked" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Checkbox and radio only. The criterion starts checked. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="timeout" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Suggest only. Delay in milliseconds before searching after typing. React uses this attribute (300 by default); AngularJS ignores it and uses a global setting.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Checkbox and radio only. Name of the group the criterion belongs to; the group is used in validation and to match the screen target field.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="destination" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Uploader only. Folder where the uploaded files are stored.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drop-zone" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Uploader only. Shows a drop area where files can be dragged and dropped, plus a preview of the selected image. Default is false</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="capture" type="captureEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Uploader only. Adds a button to take a photo with the device camera (user: front camera, environment: rear camera). Devices without a camera fall back to the file dialog</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="presets" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Quick presets of a date-range criterion, as a list of codes separated by commas or
          spaces. Each code is shown as a button that fills the range from the current date: TODAY, YTD (year to date), ALL
          (clears both dates) or a period back from today, a number followed by D (days), W (weeks), M (months) or Y (years),
          for instance 7D, 1M, 3M, 12M, 3Y. The label of each preset is the locale DATE_RANGE_PRESET_ plus the code. The
          active preset is cleared when the dates are edited. Only used by date-range criteria.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="help" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Help text shown in a tooltip next to the label. It is a localization key that is translated.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="help-image" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Path of an image shown in the help tooltip.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show-weekends" type="xs:boolean">
      <xs:annotation>
        <xs:documentation xml:lang="en">Date criteria only. When false, Saturdays and Sundays cannot be chosen. AngularJS only; React ignores it. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show-future-dates" type="xs:boolean">
      <xs:annotation>
        <xs:documentation xml:lang="en">Date criteria only. When false, dates after the current selected value cannot be chosen. AngularJS only; React ignores it. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date-format" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Date criteria only. Date format in bootstrap-datepicker syntax (default dd/mm/yyyy). AngularJS only; React always uses its own fixed format.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date-show-today-button" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Date criteria only. Shows the button that goes to today. AngularJS only (default: shown); React always shows it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date-view-mode" type="viewModeEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Date criteria only. Smallest view of the calendar: days, months or years. Default: days. AngularJS only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left-label" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows the label to the left of the input, with a width of this many characters. AngularJS only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="visible" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Initial visibility of the criterion. Default: true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tooltip shown over the input. AngularJS only; React does not use it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="serverCallAttr" />
  </xs:attributeGroup>

  <!-- Button Attributes -->
  <xs:attributeGroup name="buttonAttr">
