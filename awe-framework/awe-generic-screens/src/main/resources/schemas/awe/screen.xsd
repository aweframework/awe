<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!--
  ==============================================================================
  Definition
  ==============================================================================
  -->
  <xs:annotation>
    <xs:appinfo>awe Screen Schema</xs:appinfo>
    <xs:documentation xml:lang="en">This Schema defines the way an awe Screen must be structured</xs:documentation>
  </xs:annotation>

  <!--
  ==============================================================================
  Includes
  ==============================================================================
  -->
  <xs:include schemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/general.xsd" />

  <!--
  ==============================================================================
  Elements
  ==============================================================================
  -->

  <!-- Screen Element -->
  <xs:element name="screen" type="screenType">
    <xs:unique name="TagUnique">
      <xs:selector xpath=".//tag" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="AccordionUnique">
      <xs:selector xpath=".//accordion" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="AccordionItemUnique">
      <xs:selector xpath=".//accordion-item" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="MessageUnique">
      <xs:selector xpath=".//message" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="TagSourceUnique">
      <xs:selector xpath=".//tag" />
      <xs:field xpath="@source" />
    </xs:unique>
    <xs:unique name="VideoIdUnique">
      <xs:selector xpath=".//video" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="MapIdUnique">
      <xs:selector xpath=".//map" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="LinkIdUnique">
      <xs:selector xpath=".//link" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="ImageIdUnique">
      <xs:selector xpath=".//image" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="ColumnNameUnique">
      <xs:selector xpath=".//column" />
      <xs:field xpath="@name" />
    </xs:unique>
    <xs:unique name="CriteriaIdUnique">
      <xs:selector xpath=".//criteria" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="ButtonIdUnique">
      <xs:selector xpath=".//button" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="GridIdUnique">
      <xs:selector xpath=".//grid" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="PivotTableIdUnique">
      <xs:selector xpath=".//pivot-table" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="ContextButtonNameUnique">
      <xs:selector xpath=".//context-button" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="TabIdUnique">
      <xs:selector xpath=".//tab" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="WidgetIdUnique">
      <xs:selector xpath=".//widget" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="ChartIdUnique">
      <xs:selector xpath=".//chart" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="ContextSeparatorNameUnique">
      <xs:selector xpath=".//context-separator" />
      <xs:field xpath="@id" />
    </xs:unique>
    <xs:unique name="DialogIdUnique">
      <xs:selector xpath=".//dialog|.//side-panel|.//popover" />
      <xs:field xpath="@id" />
    </xs:unique>
  </xs:element>

  <!-- Grid Element -->
  <xs:element name="grid" type="gridType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Data grid (or tree grid when treegrid is true) that shows the rows returned by a query. It contains the columns, optional group headers, buttons and context menu, and can be editable. Supported by both client engines; the tree grid support of the React engine is partial (see the attributes).</xs:documentation>
    </xs:annotation>
  </xs:element>
  
  <!-- Accordion Element -->
  <xs:element name="accordion" type="accordionType" />
  
  <!-- Accordion Item -->
  <xs:element name="accordion-item" type="accordionItemType" />

  <!-- PivotTable Element -->
  <xs:element name="pivot-table" type="pivotTableType" />

  <!-- Tag Element -->
  <xs:element name="tag" type="htmlTagType" />

  <!-- Video Element -->
  <xs:element name="video" type="videoType" />

  <!-- Map Element -->
  <xs:element name="map" type="mapType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Interactive map (Leaflet with OpenStreetMap tiles). Each data row is a marker; clicking a marker selects its row and launches the dependencies.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Card Element -->
  <xs:element name="card" type="cardType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Metric tile: a title, a big value with its unit, an icon, a change (delta) with its trend and caption, a description, a footer and an optional progress towards a target. Its attributes are static values; with initial-load the first row of the target query fills it, and the query fields (named as the attributes in camelCase: title, value, unit, delta, deltaUnit, trend, caption, tone...) override them. Its children (a chart, a grid, buttons...) are shown in its body, below the value. It refreshes with reload, filter and dependencies like any component. Supported by both client engines.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Link Element -->
  <xs:element name="link" type="linkType" />

  <!-- Image Element -->
  <xs:element name="image" type="imageType" />

  <!-- Javascript Element -->
  <xs:element name="javascript" type="javascriptType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Deprecated in AWE 5.0 and removed in 6.0: no client engine renders it.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Dialog Element -->
  <xs:element name="dialog" type="dialogType" />

  <!-- Side Panel Element -->
  <xs:element name="side-panel" type="sidePanelType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Panel anchored to the left or right edge of the screen, with a header, a scrollable body and an optional footer (a child with style modal-footer). It is opened and closed as a dialog (button-action type dialog, close and close-cancel), it closes with its close button, a click outside or Esc, and it keeps the focus inside while it is open. Supported by both client engines.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Popover Element -->
  <xs:element name="popover" type="popoverType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Floating container anchored to the control named in anchor, opened on the side of it set in position (bottom, top, left or right), with a header, a body and an optional footer (a child with style modal-footer). It is opened and closed as a dialog (button-action type dialog, close and close-cancel), it closes with its close button, a click outside or Esc, and it keeps the focus inside while it is open. Supported by both client engines.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Include Element -->
  <xs:element name="include" type="includeType" />

  <!-- Tab Element -->
  <xs:element name="tab" type="tabType" />

  <!-- Tab Element -->
  <xs:element name="tabcontainer" type="tabcontainerType" />

  <!-- Wizard Element -->
  <xs:element name="wizard" type="wizardType" />

  <!-- Wizard Panel Element -->
  <xs:element name="wizard-panel" type="elementType" />

  <!-- Column Element -->
  <xs:element name="column" type="columnType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Column of a grid. It names the field of the data list to show and sets how the cell is shown or edited. It can also be placed inside a group-header.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Row detail Element -->
  <xs:element name="row-detail" type="rowDetailType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Detail area of a grid row. A toggle at the start of each row opens it under the row, across the whole width of the grid; several rows can be open and a reload of the data closes them. The detail is either a template or components, never both. Template: its text, where each {name} placeholder is replaced with the field name of the row, also of hidden columns (the label of the cell when it has one); missing fields show nothing. The detail is plain text (HTML is shown as text) and keeps the line breaks. Use CDATA for multi-line templates. Components: a single read-only grid (no editable nor send-operations), inline or through an include whose source contains only that grid. Each open row gets its own instance of the grid, which loads only when the row is opened; its requests send every field of the parent row as [parent grid id].row.[field] (for example GrdProducts.row.id), so a query reads it with a variable of that name. The components of a row detail are not screen components: they cannot have dependencies (the screen fails to load) and cannot be the target of other components. Declare at most one per grid; only the first one is used. Supported by both client engines; tree grids do not show it.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Quick filter Element -->
  <xs:element name="quick-filter" type="quickFilterType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Quick filters of a grid: a group of buttons (a segmented control) at the start of the grid toolbar, one per option, such as All 128 · Locked 3 · Inactive 12. It is a criterion of the screen: its options come from its initial load (a query or an enumerated) with the fields value, label (a localization key), count (optional, shown after the label) and tone (optional, the colour of the count: danger, warning, success or info). Its value is sent with every request of the grid as a variable named like its id, so the query of the grid reads it to filter the rows; the option with an empty value (usually the first one, All) leaves the grid unfiltered. Choosing an option filters the grid with no dependency, and every filter of the grid (a search, a filter after a maintain, choosing an option) reloads the options too, so the counts stay current. The arrow keys move the choice. The toolbar shows it also when the grid hides its toolbar buttons with show-toolbar="false". Declare at most one per grid; only the first one is used. Supported by both client engines.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Grid search Element -->
  <xs:element name="search" type="gridSearchType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Search field of a grid: a text box with a search icon at the start of the grid toolbar, before the quick filters. It is a text criterion of the screen with no query of its own (no server-action nor target-action): its value is sent with every request of the grid as a variable named like its id, so the query of the grid reads it to filter the rows (usually with a like filter on several fields). Typing filters the grid after a short pause (300 ms); Enter filters it at once, and the clear button or Escape empties it and filters the grid again. As every filter of the grid, a search reloads the quick filter of the grid too, so its counts follow the search. The toolbar shows it also when the grid hides its toolbar buttons with show-toolbar="false". Declare at most one per grid; only the first one is used. Supported by both client engines.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Side panel header tag Element -->
  <xs:element name="header-tag" type="headerTagType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Tag of the identity header of a side panel (only inside a side-panel with header-grid): a field of the selected row of the header grid shown as a tag after the subtitle, in the order of the XML, with the look of the status cells of a grid (the tone of tone-field and a dot, or the icon of icon-field in place of the dot). A tag whose field is empty in the selected row is not shown. Supported by both client engines.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Column Element -->
  <xs:element name="group-header" type="groupHeaderType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Second header level that spans over a set of consecutive columns of the grid. The label is shown over the columns it contains, and printed reports keep the grouping.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Window Element -->
  <xs:element name="window" type="windowType" />

  <!-- Advanced Element -->
  <xs:element name="advanced" type="advancedType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Advanced block of a window: the advanced criteria of a search and their layout tags. Place it right after the essential criteria, inside the window (usually in its panel-body tag); declare at most one per window. The window draws an Advanced filters row where the block is, with the count of the advanced criteria whose value differs from its default, the filters in effect and Clear all, and shows the block on demand below the row or in a side panel (see advanced-mode on the window). Enter in a criterion and Show results launch the submit button of the window. It only has effect inside a window: elsewhere its children are shown as in a plain tag. Supported by both client engines.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Resizable Element -->
  <xs:element name="resizable" type="resizableType" />

  <!-- Criteria Element -->
  <xs:element name="criteria" type="criteriaType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Input component (text, select, date, checkbox...) that gets a value from the user and sends it to the server. Its component attribute selects the kind of input. It can contain dependencies and a context menu.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- Button Element -->
  <xs:element name="button" type="buttonType" />

  <!-- ContextButton Element -->
  <xs:element name="context-button" type="contextButtonType" />

  <!-- ContextSeparator Element -->
  <xs:element name="context-separator" type="contextSeparatorType" />

  <!-- Button Action Element -->
  <xs:element name="button-action" type="actionType" />

  <!-- Message Element -->
  <xs:element name="message" type="messageType" />

  <!-- Text Element -->
  <xs:element name="text" />

  <!-- Info Element -->
  <xs:element name="info" type="infoType" />

  <!-- Info Button Element -->
  <xs:element name="info-button" type="infoButtonType" />

  <!-- Info Criteria Element -->
  <xs:element name="info-criteria" type="infoCriteriaType" />

  <!-- Avatar Element -->
  <xs:element name="avatar" type="avatarType" />

  <!-- Menu container -->
  <xs:element name="menu-container" type="menuContainerType" />

  <!-- Frame Element -->
  <xs:element name="frame" type="frameType">
    <xs:annotation>
      <xs:documentation xml:lang="en">Deprecated in AWE 5.0 and removed in 6.0: no client engine renders it.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <!-- View Element -->
  <xs:element name="view" type="viewType" />

  <!-- Dependency Element -->
  <xs:element name="dependency" type="dependencyType" />

  <!-- Dependency Action Element -->
  <xs:element name="dependency-action" type="actionType" />

  <!-- Dependency Element -->
  <xs:element name="dependency-element" type="dependencyElementType" />

  <!-- Widget Element -->
  <xs:element name="widget" type="widgetType" />

  <!-- Widget Parameter Element -->
  <xs:element name="widget-parameter" type="widgetParameterType" />

  <!-- Chart Element -->
  <xs:element name="chart" type="chartType" />

  <!-- Chart legend Element -->
  <xs:element name="chart-legend" type="chartLegendType" />

  <!-- Chart tooltip Element -->
  <xs:element name="chart-tooltip" type="chartTooltipType" />

  <!-- Chart xAxis Element -->
  <xs:element name="x-axis" type="chartAxisType" />

  <!-- Chart yAxis Element -->
  <xs:element name="y-axis" type="chartAxisType" />

  <!-- Chart Series Element -->
  <xs:element name="chart-serie" type="chartSerieType" />

  <!-- Chart Parameter Element -->
  <xs:element name="chart-parameter" type="chartParameterType" />

  <!-- TagList Element -->
  <xs:element name="tag-list" type="tagListType" />

  <!--
  ==============================================================================
  Attribute Groups
  ==============================================================================
  -->

  <!-- Server Call Attributes -->
  <xs:attributeGroup name="serverCallAttr">
    <xs:attribute name="initial-load" type="initialLoadEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the component gets its data when the screen is built. query runs the target query, enum reads the target enumerated, and value runs the target and uses the first row to fill the selected value (for a criterion this overrides the value from variable, session, property and value). A grid only loads data with query.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="server-action" type="serverActionEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Server action used to load or refresh the component data (for example data). Used together with target-action.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="target-action" type="nameEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the target (query, enumerated or maintain) that the server action runs.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="max" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Number of rows requested per page. Default: for a grid, the grid.rows.per.page property (30); for a criterion, the awe.application.component.criteria-rows-per-page property (100).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autorefresh" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Reloads the component data from the server every this many seconds. 0 or empty means no automatic refresh.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoload" type="booleanEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">When true, the component is reloaded from the server as soon as it is created, after the screen is shown. Default: false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Screen Attributes -->
  <xs:attributeGroup name="screenAttr">
    <xs:attribute name="label" type="xs:string" />
    <xs:attribute name="template" use="required" type="xs:string" />
    <xs:attribute name="target" type="xs:string" />
    <xs:attribute name="onload" type="xs:string" />
    <xs:attribute name="onunload" type="xs:string" />
    <xs:attribute name="keep-criteria" type="booleanEnum" />
    <xs:attribute name="help" type="xs:string" />
    <xs:attribute name="help-image" type="xs:string" />
  </xs:attributeGroup>

  <!-- Element Attributes -->
  <xs:attributeGroup name="elementAttr">
    <xs:attribute name="id" type="xs:string" />
    <xs:attribute name="label" type="xs:string" />
    <xs:attribute name="source" type="xs:string" />
    <xs:attribute name="style" type="xs:string" />
    <xs:attribute name="type" type="xs:string" />
    <xs:attribute name="expandible" type="orientationEnum" />
  </xs:attributeGroup>
  
  <!-- Accordion Attributes -->
  <xs:attributeGroup name="accordionAttr">
    <xs:attribute name="id" type="xs:string" use="required" />
    <xs:attribute name="style" type="xs:string" />
    <xs:attribute name="selected" type="xs:string" />
    <xs:attribute name="autocollapse" type="booleanEnum" />
  </xs:attributeGroup>  
  
  <!-- Accordion Item Attributes -->
  <xs:attributeGroup name="accordionItemAttr">
    <xs:attribute name="id" type="xs:string" use="required" />
    <xs:attribute name="label" type="xs:string" use="required" />
    <xs:attribute name="style" type="xs:string" />
  </xs:attributeGroup>

  <!-- Video Attributes -->
  <xs:attributeGroup name="videoAttr">
    <xs:attributeGroup ref="elementAttr" />
    <xs:attribute name="loop" type="booleanEnum" />
    <xs:attribute name="preload" type="videoPreloadValues" />
    <xs:attribute name="autoplay" type="booleanEnum" />
    <xs:attribute name="poster" type="xs:string" />
    <xs:attribute name="src" type="xs:string" />
    <xs:attribute name="controls" type="booleanEnum" />
  </xs:attributeGroup>

  <!-- Card Attributes -->
  <xs:attributeGroup name="cardAttr">
    <xs:attribute name="id" type="nameEnum" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">Identifier of the card, unique in the screen. Actions (filter) and dependencies address the card with it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS classes of the card, separated by spaces (for example awe-card-wide to take two columns of an awe-card-grid). The query never overrides it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="serverCallAttr" />
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Title of the card (a locale key or a text). label is used when there is no title.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Title of the card when it has no title (a locale key or a text).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="subtitle" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Secondary text below the title.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown in a tile at the top right (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name). With an icon the delta is shown in the footer; without it, in the header.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-tone" type="cardToneEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour of the icon tile and of the progress bar: success, warning, danger, info or neutral. Default: the primary colour.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="chip" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Status chip shown at the top right, before the icon or the delta (a locale key or a text), as a tag with a dot. The query can return it as a field to change the status.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="chip-tone" type="cardToneEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tone of the status chip: success, warning, danger, info or neutral. Default: neutral.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Main value. A number is formatted in the language of the user with number-decimals.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unit" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Unit or suffix of the value and of the target (%, €, ms...).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="number-decimals" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Decimals of the value and of the target when they are numbers. Default: the decimals they have, up to 2. The delta always keeps up to 2 decimals.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="delta" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Change of the value (for example 4.2), shown as a tag with the trend arrow and its text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="delta-unit" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Unit of the change. Default: %.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="trend" type="cardTrendEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Direction of the change: up, down or flat. Default: the sign of the delta (negative down, zero flat, positive up). When it is set, the delta is shown without sign.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="good-trend" type="cardGoodTrendEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Direction that is good news: up (default) or down (error rate, costs, response time). The trend in this direction is shown as success, the opposite as danger and flat as neutral.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tone" type="cardToneEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tone of the change, used as is instead of the one derived from trend and good-trend: success, warning, danger, info or neutral.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="caption" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text next to the change (for example vs. last month).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="target" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Target of the value. When it is a number, a progress bar shows the value against it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="progress-style" type="cardProgressStyleEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the progress towards the target is drawn: bar (default) or gauge (a half circle with the percent).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sparkline" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Series of numbers drawn as a sparkline below the value, as a JSON array (for example [93.1,93.8,92.6]). The query can return it as a field.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sparkline-type" type="sparklineTypeEnum">
      <xs:annotation>
        <xs:documentation xml:lang="en">Type of the sparkline: line, area (default) or bar.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="description" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Paragraph below the value and the body.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="footer" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Muted text at the bottom left of the card.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- Map Attributes -->
  <xs:attributeGroup name="mapAttr">
    <xs:attributeGroup ref="elementAttr" />
    <xs:attributeGroup ref="serverCallAttr" />
    <xs:attribute name="latitude" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the data column that holds the marker latitude. Default: latitude.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="longitude" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the data column that holds the marker longitude. Default: longitude.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="marker-label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the data column shown in the popup of a marker.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoom" type="xs:integer">
      <xs:annotation>
        <xs:documentation xml:lang="en">Initial zoom level of the map.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="center-latitude" type="xs:decimal">
      <xs:annotation>
        <xs:documentation xml:lang="en">Latitude of the initial map center. Without a center, the map fits the markers.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="center-longitude" type="xs:decimal">
      <xs:annotation>
        <xs:documentation xml:lang="en">Longitude of the initial map center. Without a center, the map fits the markers.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

