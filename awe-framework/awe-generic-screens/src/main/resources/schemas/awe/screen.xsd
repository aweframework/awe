      <xs:enumeration value="add-row" />
      <xs:enumeration value="after-add-row" />
      <xs:enumeration value="check-records-saved" />
      <xs:enumeration value="check-records-generated" />
      <xs:enumeration value="check-one-selected" />
      <xs:enumeration value="check-some-selected" />
