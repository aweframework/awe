    <xs:attribute name="size" type="xs:string" />
    <xs:attribute name="button-type" type="buttonTypes" />
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon (an icon name of the Icons page: Font Awesome 4 by default, mdi:name or lucide:name).</xs:documentation>
      </xs:annotation>
