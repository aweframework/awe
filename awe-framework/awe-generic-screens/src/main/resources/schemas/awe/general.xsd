<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!--
  ==============================================================================
  Definition
  ==============================================================================
  -->

  <xs:annotation>
    <xs:appinfo>awe General Schema</xs:appinfo>
    <xs:documentation xml:lang="en">
      This Schema defines the general restrictions for awe files
    </xs:documentation>
  </xs:annotation>

  <!--
  ==============================================================================
  Restriction definitions
  ==============================================================================
  -->

  <!-- Variable type -->
  <xs:simpleType name="variableRestriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="STRINGL"/>
      <xs:enumeration value="STRINGR"/>
      <xs:enumeration value="STRINGB"/>
      <xs:enumeration value="STRINGN"/>
      <xs:enumeration value="STRING"/>
      <xs:enumeration value="DATE"/>
      <xs:enumeration value="TIME"/>
      <xs:enumeration value="TIMESTAMP"/>
      <xs:enumeration value="SYSTEM_DATE"/>
      <xs:enumeration value="SYSTEM_TIME"/>
      <xs:enumeration value="SYSTEM_TIMESTAMP"/>
      <xs:enumeration value="FLOAT"/>
      <xs:enumeration value="DOUBLE"/>
      <xs:enumeration value="INTEGER"/>
      <xs:enumeration value="LONG"/>
      <xs:enumeration value="OBJECT"/>
      <xs:enumeration value="CLOB"/>
      <xs:enumeration value="NULL"/>
      <xs:enumeration value="BOOLEAN"/>
      <xs:enumeration value="STRING_ENCRYPT"/>
      <xs:enumeration value="STRING_HASH_RIPEMD160">
        <xs:annotation>
          <xs:documentation xml:lang="en">Deprecated for user passwords: use STRING_HASH_PASSWORD. Unsalted RIPEMD-160 hash, kept unchanged for the descriptors that still compare legacy hashes.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STRING_HASH_PASSWORD">
        <xs:annotation>
          <xs:documentation xml:lang="en">User password hashed with the application password encoder (awe.security.password-encoder, BCrypt by default). The hash is salted: store it, never compare it in SQL.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STRING_HASH_SHA"/>
      <xs:enumeration value="STRING_HASH_PBKDF_2_W_HMAC_SHA_1"/>
      <xs:enumeration value="LIST_TO_STRING"/>
      <xs:enumeration value="STRING_TO_LIST"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Service Type Restriction -->
  <xs:simpleType name="serviceTypeRestriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DATA"/>
      <xs:enumeration value="MAINTAIN"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Service Variable Restriction -->
  <xs:simpleType name="serviceVariableRestriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="STRING"/>
      <xs:enumeration value="INTEGER"/>
      <xs:enumeration value="LONG"/>
      <xs:enumeration value="FLOAT"/>
      <xs:enumeration value="DOUBLE"/>
      <xs:enumeration value="DATE"/>
      <xs:enumeration value="TIME"/>
      <xs:enumeration value="TIMESTAMP"/>
      <xs:enumeration value="OBJECT"/>
      <xs:enumeration value="JSON"/>
      <xs:enumeration value="BOOLEAN"/>
      <xs:enumeration value="DATE_RDB"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Boolean -->
  <xs:simpleType name="booleanEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Button Action Enumeration -->
  <xs:simpleType name="buttonActionEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="confirm" />
      <xs:enumeration value="back" />
      <xs:enumeration value="forward">
        <xs:annotation>
          <xs:documentation xml:lang="en">Deprecated in AWE 5.0 and removed in 6.0: no client engine handles it.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dialog" />
      <xs:enumeration value="reset" />
      <xs:enumeration value="restore" />
      <xs:enumeration value="restore-target" />
      <xs:enumeration value="validate" />
      <xs:enumeration value="server" />
      <xs:enumeration value="server-print" />
      <xs:enumeration value="server-download" />
      <xs:enumeration value="copy-criterion-value-clipboard" />
      <xs:enumeration value="screen" />
      <xs:enumeration value="reload" />
      <xs:enumeration value="redirect" />
      <xs:enumeration value="redirect-screen" />
      <xs:enumeration value="wait" />
      <xs:enumeration value="filter" />
      <xs:enumeration value="print" />
      <xs:enumeration value="close" />
      <xs:enumeration value="close-window" />
      <xs:enumeration value="resize" />
      <xs:enumeration value="add-class" />
      <xs:enumeration value="remove-class" />
      <xs:enumeration value="toggle-class" />
      <xs:enumeration value="confirm-updated-data" />
      <xs:enumeration value="confirm-not-updated-data" />
      <xs:enumeration value="confirm-empty-data" />
      <xs:enumeration value="cancel-row" />
      <xs:enumeration value="add-row" />
      <xs:enumeration value="add-row-top" />
      <xs:enumeration value="add-row-up" />
      <xs:enumeration value="add-row-down" />
      <xs:enumeration value="copy-row" />
      <xs:enumeration value="copy-row-top" />
      <xs:enumeration value="copy-row-up" />
      <xs:enumeration value="copy-row-down" />
      <xs:enumeration value="copy-rows">
        <xs:annotation>
          <xs:documentation xml:lang="en">Replaces the rows of the target grid with a copy of the rows of the grid named in value, without its deleted rows: each shown column of the target takes the cells of the shown column of that grid in the same position, a select cell with the text of its option. The target is not marked as changed: a read-only view of an editable grid. Both engines.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <!-- Move the selected row of the target grid to the top, one position up, one position down or to the bottom (Alt+ArrowUp/ArrowDown on a selected row) -->
      <xs:enumeration value="move-row-top" />
      <xs:enumeration value="move-row-up" />
      <xs:enumeration value="move-row-down" />
      <xs:enumeration value="move-row-bottom" />
      <xs:enumeration value="copy-selected-rows-clipboard" />
      <xs:enumeration value="delete-row" />
      <xs:enumeration value="save-row" />
      <xs:enumeration value="check-leaf-selected">
        <xs:annotation>
          <xs:documentation xml:lang="en">Deprecated in AWE 5.0 and removed in 6.0: no client engine handles it.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="check-one-selected" />
      <xs:enumeration value="check-some-selected" />
      <xs:enumeration value="check-records-saved" />
      <xs:enumeration value="check-records-generated" />
      <xs:enumeration value="check-parent-expanded">
        <xs:annotation>
          <xs:documentation xml:lang="en">Deprecated in AWE 5.0 and removed in 6.0: no client engine handles it.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="select-first-row" />
      <xs:enumeration value="select-last-row" />
      <xs:enumeration value="select-all-rows" />
      <xs:enumeration value="unselect-all-rows" />
      <!-- Open the context menu under the button: the one of its grid when the button is in a grid row, its own otherwise -->
      <xs:enumeration value="show-context-menu" />
      <xs:enumeration value="toggle-menu" />
      <xs:enumeration value="toggle-navbar" />
      <xs:enumeration value="logout" />
      <xs:enumeration value="change-theme" />
      <xs:enumeration value="update-theme" />
      <xs:enumeration value="change-language" />
      <xs:enumeration value="next-step" />
      <xs:enumeration value="prev-step" />
      <xs:enumeration value="first-step" />
      <xs:enumeration value="last-step" />
      <xs:enumeration value="nth-step" />
      <xs:enumeration value="disable-dependencies" />
      <xs:enumeration value="enable-dependencies" />
      <xs:enumeration value="start-load" />
      <xs:enumeration value="value" />
      <xs:enumeration value="close-cancel" />
      <xs:enumeration value="reload-language" />
      <xs:enumeration value="get-locals">
        <xs:annotation>
          <xs:documentation xml:lang="en">Deprecated in AWE 5.0 and removed in 6.0: it does nothing as a button action. The locals are loaded by the client with the get-locals server action, which stays.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <!-- Server Action Enumeration -->
  <xs:simpleType name="serverActionEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="login" />
      <xs:enumeration value="login-azure" />
      <xs:enumeration value="login-sso" />
      <xs:enumeration value="afterLogin" />
      <xs:enumeration value="logout" />
      <xs:enumeration value="screen" />
      <xs:enumeration value="reload" />
      <xs:enumeration value="refresh-menu" />
      <xs:enumeration value="data" />
      <xs:enumeration value="dataMessageCentered" />
      <xs:enumeration value="value" />
      <xs:enumeration value="unique" />
      <xs:enumeration value="control" />
      <xs:enumeration value="control-cancel" />
      <xs:enumeration value="control-confirm" />
      <xs:enumeration value="control-confirm-message" />
      <xs:enumeration value="control-confirm-cancel" />
      <xs:enumeration value="control-empty-cancel" />
      <xs:enumeration value="control-unique-cancel" />
      <xs:enumeration value="subscribe" />
      <xs:enumeration value="validate" />
      <xs:enumeration value="maintain" />
      <xs:enumeration value="maintain-silent" />
      <xs:enumeration value="maintain-async" />
      <xs:enumeration value="dataTrt"/>
      <xs:enumeration value="maintainTrt"/>
      <xs:enumeration value="data-silent" />
      <xs:enumeration value="update-model" />
      <xs:enumeration value="deferred-data" />
      <xs:enumeration value="application-manual" />
      <xs:enumeration value="view-pdf-file" />
      <xs:enumeration value="get-server-file" />
      <xs:enumeration value="get-log-file" />
      <xs:enumeration value="get-file-maintain" />
      <xs:enumeration value="file" />
      <xs:enumeration value="help" />
      <xs:enumeration value="application-help" />
      <xs:enumeration value="data-target-message" />
      <xs:enumeration value="value-target-message" />
      <xs:enumeration value="maintain-target-message" />
      <xs:enumeration value="control-target-message" />
      <xs:enumeration value="maintainTrtSilent"/>
      <xs:enumeration value="maintainKutUpdate"/>
      <xs:enumeration value="maintainKutDelete"/>
      <xs:enumeration value="maintainKutMultiple"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
