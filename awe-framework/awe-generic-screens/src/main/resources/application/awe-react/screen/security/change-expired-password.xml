<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : change-expired-password.xml
    Description: Screen to set a new password when the password has expired (public screen).
                 The user is not authenticated: the server only accepts the change in the session that verified
                 the expired password (see PasswordChangeService), so the screen asks only for the new password.
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="full" label="SCREEN_TITLE_CHANGE_EXPIRED_PWD" help="HELP_SCREEN_TITLE_CHANGE_EXPIRED_PWD">
  <tag source="center">
    <tag type="div" id="page-change-expired-password" style="expand grid m-0">
      <tag type="div" style="awe-signin signin-container align-self-center shadow-3">

        <!-- Left side -->
        <tag type="div" style="signin-info">
          <tag type="h1">
            <tag type="span" label="APP_CLIENT"/>
          </tag>
        </tag>
        <!-- / Left side -->

        <!-- Right side -->
        <tag type="div" style="signin-form">
          <tag type="div" style="p-2">
            <tag type="span" label="SCREEN_TEXT_CHANGE_EXPIRED_PWD"/>
          </tag>
          <criteria label="PARAMETER_PASSWD" placeholder="PARAMETER_PASSWD" component="password" id="Pas" validation="{required: true, pattern:{setting:'passwordPattern'}, minlength:{setting:'minlengthPassword'}}"/>
          <criteria label="PARAMETER_RETYPE_PASSWD" placeholder="PARAMETER_RETYPE_PASSWD" component="password" id="RetPas" validation="{required: true, eq:{criterion:'Pas', message:'VALIDATOR_MESSAGE_REPEAT_PASSWORD'}}"/>
          <tag type="div" style="p-2 mt-5">
            <button button-type="submit" label="BUTTON_CONFIRM" id="ButChdExpPwd" style="m-0 col-12">
              <button-action type="validate"/>
              <button-action type="server" server-action="maintain" target-action="ChdPwdExpired"/>
            </button>
            <button button-type="button" label="BUTTON_BACK" id="ButBckExpPwd" style="m-0 mt-2 col-12">
              <button-action type="screen" target="signin"/>
            </button>
          </tag>
        </tag>
        <!-- Right side -->
      </tag>
    </tag>
  </tag>
</screen>
