      <option name="screen-access" label="MENU_TOOLS_SCREENS_ACCESS" screen="access-admin" icon="eye-slash" />
      <option name="encrypt-tools" label="MENU_TOOLS_SCREEN_ENCRYPT" screen="ScrEncTxt" icon="lock" />
