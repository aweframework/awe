      <option name="new-user" screen="UsrNew" invisible="true" />
      <option name="update-user" screen="UsrUpd" invisible="true" />
      <option name="view-user" screen="UsrViw" invisible="true" />
    </option>
    <option name="profiles" label="MENU_TOOLS_PROFILES" screen="profile-admin" icon="group">
