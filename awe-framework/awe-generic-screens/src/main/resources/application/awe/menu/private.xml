    <option name="email-servers" label="MENU_TOOLS_AWE_EML_SRV" screen="email-server-admin" icon="envelope"/>
    <option name="queues" label="MENU_TOOLS_AWE_QUE" screen="queue-admin" icon="exchange"/>
    <option name="sequences" label="MENU_TOOLS_AWEKEY" screen="sequence-admin" icon="key" />
    <option name="application-parameters" label="MENU_TOOLS_AWE_APPPAR" screen="application-parameter-admin" icon="cogs" />
