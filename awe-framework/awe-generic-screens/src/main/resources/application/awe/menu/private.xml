  <option name="help-separator" separator="true" />
  <option name="help" label="MENU_HELP" icon="question-circle">
    <option name="user-help" label="MENU_USER_HELP" screen="application-manual" icon="book" />
    <option name="application-help" label="MENU_HELP_APPLICATION" screen="application-help" icon="question" />
