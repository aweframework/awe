    <java classname="com.almis.awe.service.TotpService" method="getQRCodeList">
      <service-parameter type="BOOLEAN" name="generate" />
    </java>
  </service>
  <service id="generate-2fa-secret">
    <java classname="com.almis.awe.service.TotpService" method="generate2faSecret"/>
  </service>
  <!-- Security audit screen -->
  <service id="SecAudDefFro">
    <java classname="com.almis.awe.security.audit.SecurityAuditScreenService" method="getDefaultDateFrom" />
  </service>
  <!-- Security audit time range: the two dates of the preset chosen in the range picker (15m, 1h, 6h, 24h, 7d, 30d) -->
  <service id="SecAudRng">
    <java classname="com.almis.awe.security.audit.SecurityAuditScreenService" method="getRange">
      <service-parameter type="STRING" name="CrtRng" />
    </java>
  </service>
  <!-- Label of the security audit time range picker: the two dates in force, with their time -->
  <service id="SecAudRngTxt">
    <java classname="com.almis.awe.security.audit.SecurityAuditScreenService" method="formatRange">
      <service-parameter type="DATE" name="CrtFro" />
      <service-parameter type="DATE" name="CrtTo" />
    </java>
  </service>
  <!-- Security audit of user account changes (userId: one identifier or the list sent by a grid) -->
  <service id="audit-user-update">
    <java classname="com.almis.awe.security.audit.UserAccountAuditService" method="auditUserUpdate">
      <service-parameter type="INTEGER" name="userId" list="true" />
      <service-parameter type="INTEGER" name="locked" />
      <service-parameter type="INTEGER" name="passwordUpdate" />
    </java>
  </service>
  <service id="audit-password-change">
    <java classname="com.almis.awe.security.audit.UserAccountAuditService" method="auditPasswordChange">
      <service-parameter type="STRING" name="user" />
      <service-parameter type="STRING" name="password" />
    </java>
  </service>
  <service id="audit-totp-reset">
    <java classname="com.almis.awe.security.audit.UserAccountAuditService" method="auditTotpReset">
      <service-parameter type="INTEGER" name="userIds" list="true" />
    </java>
  </service>
  <service id="update-2fa-status">
    <java classname="com.almis.awe.service.TotpService" method="update2faStatus">
      <service-parameter type="INTEGER" name="enable" />
    </java>
  </service>
  <!-- Favourites -->
  <service id="clickFavourite">
    <java classname="com.almis.awe.service.FavouriteService" method="clickFavourite">
      <service-parameter type="STRING" name="user" />
      <service-parameter type="STRING" name="option" />
    </java>
  </service>
  <service id="checkFavourites">
    <java classname="com.almis.awe.service.FavouriteService" method="checkFavourites">
      <service-parameter type="STRING" name="user" />
      <service-parameter type="STRING" name="option" />
    </java>
  </service>
  <!-- User settings (avatar) -->
  <service id="upsertUserAvatar">
    <java classname="com.almis.awe.service.UserSettingsService" method="upsertUserAvatar">
      <service-parameter type="STRING" name="user" />
      <service-parameter type="STRING" name="avatarToken" />
    </java>
  </service>
  <service id="saveUserAvatar">
    <java classname="com.almis.awe.service.UserSettingsService" method="saveUserAvatar">
      <service-parameter type="STRING" name="avatarToken" />
    </java>
  </service>
  <!-- User grid layouts (the user comes from the session) -->
  <service id="saveGridLayout">
    <java classname="com.almis.awe.service.GridLayoutService" method="saveGridLayout">
      <service-parameter type="STRING" name="screen" />
      <service-parameter type="STRING" name="gridId" />
      <service-parameter type="STRING" name="layout" />
    </java>
  </service>
  <service id="resetGridLayout">
    <java classname="com.almis.awe.service.GridLayoutService" method="resetGridLayout">
      <service-parameter type="STRING" name="screen" />
      <service-parameter type="STRING" name="gridId" />
    </java>
  </service>
  <!-- User window states (the user comes from the session) -->
  <service id="saveWindowAdvancedState">
    <java classname="com.almis.awe.service.WindowStateService" method="saveAdvancedState">
      <service-parameter type="STRING" name="screen" />
      <service-parameter type="STRING" name="windowId" />
      <service-parameter type="STRING" name="open" />
    </java>
  </service>
  <!-- Saved searches (the user and the profile come from the session) -->
  <service id="getWindowSavedSearches">
    <java classname="com.almis.awe.service.SavedSearchService" method="getWindowSavedSearches">
      <service-parameter type="STRING" name="screen" />
      <service-parameter type="STRING" name="windowId" />
    </java>
  </service>
  <service id="getSavedSearchProfiles">
    <java classname="com.almis.awe.service.SavedSearchService" method="getSavedSearchProfiles" />
  </service>
  <service id="saveWindowSearch">
    <java classname="com.almis.awe.service.SavedSearchService" method="saveWindowSearch">
      <service-parameter type="STRING" name="screen" />
      <service-parameter type="STRING" name="windowId" />
      <service-parameter type="STRING" name="name" />
      <service-parameter type="STRING" name="values" />
      <service-parameter type="STRING" name="profile" />
    </java>
  </service>
  <service id="renameWindowSearch">
    <java classname="com.almis.awe.service.SavedSearchService" method="renameWindowSearch">
      <service-parameter type="STRING" name="id" />
      <service-parameter type="STRING" name="name" />
    </java>
  </service>
  <service id="deleteWindowSearch">
    <java classname="com.almis.awe.service.SavedSearchService" method="deleteWindowSearch">
      <service-parameter type="STRING" name="id" />
    </java>
  </service>
  <!-- Themes -->
  <service id="changeUserMode">
    <java classname="com.almis.awe.service.UserService" method="changeUserMode">
      <service-parameter type="STRING" name="user" />
      <service-parameter type="STRING" name="mode" />
    </java>
  </service>
  <service id="changeUserDensity">
    <java classname="com.almis.awe.service.UserService" method="changeUserDensity">
      <service-parameter type="STRING" name="user" />
      <service-parameter type="STRING" name="density" />
    </java>
  </service>
  <!-- Primary colour and surface of a theme from the palette selects and colour pickers of the theme screens -->
  <service id="composeThemeColors">
    <java classname="com.almis.awe.service.ThemeService" method="composeColors">
      <service-parameter type="STRING" name="primaryPalette" />
      <service-parameter type="STRING" name="primaryHex" />
      <service-parameter type="STRING" name="surfacePalette" />
      <service-parameter type="STRING" name="surfaceHex" />
    </java>
  </service>
  <!-- Email service -->
  <service id="reloadMailServers">
    <java classname="com.almis.awe.service.EmailService" method="reloadMailServers"/>
  </service>
</services>
