<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : SecAudViw.xml
    Description: Security audit - All the data of one security event
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_SECURITY_AUDIT_VIEW" help="HELP_SCREEN_TITLE_SECURITY_AUDIT_VIEW">
  <tag source="buttons">
    <button button-type="button" label="BUTTON_BACK" icon="arrow-circle-left" id="ButBck" help="HELP_BACK_BUTTON">
      <button-action type="back" />
    </button>
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" help="HELP_HELP_BUTTON">
      <button-action type="dialog" target="HlpOpt" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_SECURITY_AUDIT_VIEW" icon="shield">
      <tag type="div" style="panel-body">
        <criteria label="PARAMETER_DATE" id="EvtDat" component="text" variable="EvtDat" readonly="true" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_EVENT" id="EvtTyp" component="select" variable="EvtTyp" initial-load="enum" target-action="SecAudEvtTyp" readonly="true" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_OUTCOME" id="EvtRes" component="select" variable="EvtRes" initial-load="enum" target-action="SecAudRes" readonly="true" style="col-xs-6 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_CAUSE" id="EvtCau" component="select" variable="EvtCau" initial-load="enum" target-action="SecAudCau" optional="true" readonly="true" style="col-xs-6 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_USER" id="UsrNam" component="text" variable="UsrNam" readonly="true" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_TENANT" id="Ten" component="text" variable="Ten" readonly="true" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_CHANNEL" id="Chn" component="select" variable="Chn" initial-load="enum" target-action="SecAudChn" readonly="true" style="col-xs-6 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_ID" id="IdeSecAud" component="text" variable="IdeSecAud" readonly="true" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_DETAIL" id="Det" component="textarea" variable="Det" readonly="true" style="col-xs-12" />
      </tag>
    </window>
    <window style="expand" label="SCREEN_TEXT_SECURITY_AUDIT_REQUEST" icon="globe">
      <tag type="div" style="panel-body">
        <criteria label="PARAMETER_SECURITY_AUDIT_IP" id="IpAdr" component="text" variable="IpAdr" readonly="true" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_CORRELATION" id="CorIde" component="text" variable="CorIde" readonly="true" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_SECURITY_AUDIT_SESSION" id="SesHsh" component="text" variable="SesHsh" readonly="true" style="col-xs-12 col-lg-6" />
        <criteria label="PARAMETER_SECURITY_AUDIT_USER_AGENT" id="UsrAgt" component="textarea" variable="UsrAgt" readonly="true" style="col-xs-12" />
      </tag>
    </window>
  </tag>
  <tag source="modal">
    <include target-screen="screen-help" target-source="center"/>
  </tag>
</screen>
