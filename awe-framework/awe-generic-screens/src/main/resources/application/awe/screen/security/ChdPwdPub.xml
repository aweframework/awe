<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : ChdPwdPub.xml
    Created on : 11 de septiembre de 2013
    Author     : Pablo VIDAL
    Description: Tools window - Change Password
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="full" label="SCREEN_TITLE_CHD_PWD" help="HELP_SCREEN_TITLE_CHD_PWD">
  <tag source="hidden">
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
  </tag>
  <tag source="center" type="div" style="fullScreen">
    <tag type="div" id="page-change-password-bg" style="fullScreen">
      <!-- Background overlay -->
      <tag type="div" style="overlay-image fullScreen" />
      <tag type="div" style="overlay fullScreen" />
    </tag>
    <tag type="div" style="awe-change-password change-password-container">

      <!-- Top side -->
      <tag type="div" style="change-password-header">
        <tag type="h1">
          <tag type="span" label="APP_CLIENT"/>
        </tag>
        <tag type="div" style="slogan" label="APP_NAME" />
      </tag>
      <!-- / Top side -->

      <!-- Bottom side -->
      <tag type="div" style="change-password-form">
        <tag type="div" style="change-password-text">
          <tag type="span" label="SCREEN_TEXT_CHANGE_PWD"/>
        </tag>
        <criteria label="PARAMETER_USER" id="Usr" component="text" variable="cod_usr" readonly="true" size="lg" icon="user change-password-form-icon" />
        <criteria id="cod_usr" component="hidden" variable="cod_usr" />
        <criteria label="PARAMETER_OLD_PASSWD" id="OldPas" component="password" validation="{required: true, eq:{criterion:'CrtOldPas', message:'VALIDATOR_MESSAGE_OLD_PASSWORD'}}" size="lg" icon="lock change-password-form-icon" />
        <criteria id="CrtOldPas" component="hidden" variable="pwd_usr" />
        <criteria label="PARAMETER_PASSWD" id="Pas" component="password" validation="{required: true, pattern:{setting:'passwordPattern'}, ne:{criterion:'OldPas', message:'VALIDATOR_MESSAGE_REPEAT_OLD_PASSWORD'}, minlength:{setting:'minlengthPassword'}}" size="lg" icon="lock change-password-form-icon" />
        <criteria id="pwd_usr" component="hidden" value="" variable="Pas">
          <dependency source-type="criteria-value" target-type="input" initial="true" target-action="Pas">
            <dependency-element id="Pas" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_RETYPE_PASSWD" id="RetPas" component="password" validation="{required: true, eq:{criterion:'Pas', message:'VALIDATOR_MESSAGE_REPEAT_PASSWORD'}}" size="lg" icon="lock change-password-form-icon" />
        <criteria id="MinPwd" component="hidden" property="MinPwd" />
        <tag type="div" style="change-password-with">
          <tag type="div" style="form-actions">
            <button button-type="submit" label="BUTTON_CONFIRM" style="no-class btn btn-primary change-password-btn bg-primary" id="ButCnf" help="HELP_CONFIRM_BUTTON">
              <button-action type="validate" />
              <button-action type="confirm" target="UpdMsg" />
              <button-action type="server" server-action="maintain" target-action="ChdPwdPub" />
              <button-action type="server" server-action="login" />
            </button>
            <button button-type="button" label="BUTTON_BACK" style="no-class btn btn-default change-password-btn" id="ButBck" help="HELP_BACK_BUTTON">
              <button-action type="screen" target="Lgn" />
            </button>
          </tag>
        </tag>
      </tag>
      <!-- Bottom side -->
    </tag>
  </tag>
</screen>
