<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : email-server-admin.xml
    Description: Mail servers (screen email-server-admin): list of the mail servers of the application with a side panel to
                 create and edit them.
                 Replaces the EmlSrv, EmlSrvNew and EmlSrvUpd screens; it reuses their queries and maintains (EmlSrvLst,
                 EmlSrvNew, EmlSrvUpd, EmlSrvDel, EmlSrvNamUni) and has its own counters of the quick filters
                 (EmlSrvStaCnt, EmlSrvStaCntAct, EmlSrvStaCntIna).
                 The grid sends IdeAweEmlSrv (the selected rows) to EmlSrvDel and every other column is not sendable: their
                 names are criteria of the panel, which takes their value from the selected row, so saving a server sends
                 the values of the panel with that identifier and never a column of another row.
                 The grid never shows nor sends the password of a server: the panel writes only the typed one (FlgPwdUpd, as
                 the EmlSrvUpd screen does), so the stored password is never replaced by an empty one nor shown.
                 The panel edits the port, the security mode (NONE, STARTTLS, SSL) and the authentication type (none, user
                 and password, OAuth2 with a Spring Security client registration of EmlSrvOauRegLst) of the server.
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd"
        template="window" label="SCREEN_TITLE_EML_SRV_ADMIN" help="HELP_SCREEN_TITLE_EML_SRV_ADMIN" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW" />
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE" />
    <message id="UniMsg" title="WARNING_TITLE_DUPLICATED_SERVER" message="WARNING_MESSAGE_DUPLICATED_SERVER" />
    <!-- Mode of the side panel: new or edit -->
    <criteria id="PnlMod" component="hidden" value="new" />
  </tag>
  <tag source="buttons">
    <!-- Icon only: its label is its tooltip and its accessible name -->
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" style="btn-ghost no-label">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button label="BUTTON_PRINT" icon="print" id="ButPrn" help="HELP_PRINT_BUTTON">
      <button-action type="dialog" target="PrnOpt" />
    </button>
    <button label="BUTTON_NEW_EMAIL_SERVER" icon="plus-circle" id="ButNew" style="btn-primary" help="HELP_NEW_BUTTON" permission="system.update">
      <!-- No selected row: no IdeAweEmlSrv is sent (EmlSrvNew takes it from its sequence) and the panel starts empty, as the
           EmlSrvNew screen -->
      <button-action type="unselect-all-rows" target="GrdEmlSrvAdm" />
      <button-action type="value" target="PnlMod" value="new" />
      <button-action type="reset" target="SrvNam" />
      <button-action type="reset" target="Hst" />
      <button-action type="reset" target="Prt" />
      <button-action type="reset" target="SecMod" />
      <button-action type="reset" target="EmlUsr" />
      <button-action type="reset" target="EmlPwd" />
      <button-action type="reset" target="Ath" />
      <button-action type="reset" target="OauReg" />
      <button-action type="value" target="Act" value="1" />
      <button-action type="dialog" target="PnlEmlSrv" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_EML_SRV_ADMIN" icon="list">
      <grid id="GrdEmlSrvAdm" style="expand" server-action="data" target-action="EmlSrvLst" multiselect="true" initial-load="query" max="50">
        <!-- Search: the alias of the server (EmlSrvLst and EmlSrvStaCnt read CrtNam) -->
        <search id="CrtNam" placeholder="SCREEN_TEXT_EMAIL_SERVER_SEARCH" label="SCREEN_TEXT_EMAIL_SERVER_SEARCH_LABEL" />
        <!-- Quick filters: All, Active and Inactive, counted with the search (EmlSrvStaCnt) -->
        <quick-filter id="CrtEmlSrvSta" initial-load="query" target-action="EmlSrvStaCnt" label="SCREEN_TEXT_EMAIL_SERVER_FILTERS" value="" />
        <!-- The alias takes the rest of the width, with its host below it; a mail server has no initials, so no avatar.
             The port and the security mode (narrow, so the alias keeps its width), the user (the sender mailbox of an
             OAuth2 server), the authentication (with the icon of its tag) and the state as status -->
        <column label="PARAMETER_ALIAS" name="SrvNam" sort-field="SrvNam" align="left" charlength="30" width="*"
                secondary-field="Hst" export-secondary="true" secondary-label="PARAMETER_SERVER" sendable="false" />
        <column label="PARAMETER_SERVER_PORT" name="Prt" sort-field="Prt" align="right" charlength="6" sendable="false" />
        <column label="PARAMETER_EML_SRV_SECURITY" name="SecTxt" sort-field="SecMod" align="left" charlength="10" sendable="false" />
        <column label="PARAMETER_USER" name="EmlUsr" sort-field="EmlUsr" align="left" charlength="24" sendable="false" />
        <column label="PARAMETER_AUTH" name="AthTxt" sort-field="Ath" align="left" charlength="20" status-field="AthTon" icon-field="AthIcn" sendable="false" />
        <column label="PARAMETER_STATUS" name="StaTxt" sort-field="StaCod" align="left" charlength="14" status-field="StaTon" sendable="false" />
        <!-- Sent to EmlSrvDel: identifier of the selected mail servers -->
        <column name="IdeAweEmlSrv" hidden="true" />
        <!-- Read by the cells, by the side panel and by its header; not sent (their names are criteria of the panel) -->
        <column name="Hst" hidden="true" sendable="false" />
        <column name="SecMod" hidden="true" sendable="false" />
        <column name="Ath" hidden="true" sendable="false" />
        <column name="OauReg" hidden="true" sendable="false" />
        <column name="Act" hidden="true" sendable="false" />
        <column name="AthTon" hidden="true" sendable="false" />
        <column name="AthIcn" hidden="true" sendable="false" />
        <column name="StaCod" hidden="true" sendable="false" />
        <column name="StaTon" hidden="true" sendable="false" />
        <!-- Row actions: the pencil edits the server of its row in the side panel and the ellipsis opens the row menu. A row
             button selects its row (only it) before its actions, so the panel is filled with that server -->
        <column name="EdtBtn" component="button" icon="lucide:pencil" title="BUTTON_EDIT" style="btn-ghost no-label" align="right" charlength="4" sortable="false" sendable="false">
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="reset" target="EmlPwd" />
          <button-action type="dialog" target="PnlEmlSrv" />
        </column>
        <column name="MorBtn" component="button" icon="lucide:ellipsis" title="BUTTON_MORE_ACTIONS" style="btn-ghost no-label" align="left" charlength="4" sortable="false" sendable="false">
          <button-action type="show-context-menu" />
        </column>
        <!-- Row menu -->
        <context-button label="BUTTON_EDIT" icon="edit" id="CtxButUpd">
          <button-action type="check-one-selected" target="GrdEmlSrvAdm" />
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="reset" target="EmlPwd" />
          <button-action type="dialog" target="PnlEmlSrv" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdEmlSrvAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <!-- Duplicate: the panel opens as a new server with the values of the selected one; the password starts empty (the
             alias is taken, so the create action refuses it until it changes) -->
        <context-button label="BUTTON_DUPLICATE_EMAIL_SERVER" icon="copy" id="CtxButDup" permission="system.update">
          <button-action type="check-one-selected" target="GrdEmlSrvAdm" />
          <button-action type="value" target="PnlMod" value="new" />
          <button-action type="reset" target="EmlPwd" />
          <button-action type="dialog" target="PnlEmlSrv" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdEmlSrvAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <context-separator name="CtxSepDel" />
        <context-button label="BUTTON_DELETE" icon="trash" id="CtxButDel">
          <button-action type="check-some-selected" target="GrdEmlSrvAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="EmlSrvDel" />
          <button-action type="filter" target="GrdEmlSrvAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdEmlSrvAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </context-button>
        <!-- Selection actions: in the selection bar of the grid while there are selected servers, Delete as the danger one -->
        <button label="BUTTON_DELETE" icon="trash" id="ButDel" help="HELP_DELETE_BUTTON" style="btn-danger" selection="true">
          <button-action type="check-some-selected" target="GrdEmlSrvAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="EmlSrvDel" />
          <button-action type="filter" target="GrdEmlSrvAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdEmlSrvAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </button>
      </grid>
    </window>

    <!-- One side panel for new and edit: the criteria ids are the parameters of EmlSrvNew and EmlSrvUpd. When editing (one
         selected server) its header shows the server: alias and the state tag; for a new server (no selected row) it shows
         its label -->
    <side-panel id="PnlEmlSrv" label="SCREEN_TITLE_EMAIL_SERVER_PANEL" icon="envelope" max-width="480px"
                header-grid="GrdEmlSrvAdm" header-title-field="SrvNam">
      <header-tag field="StaTxt" tone-field="StaTon" />
      <tag type="div" style="panel-body" id="PnlEmlSrvBdy">
        <!-- Identity: alias and state (a new server starts active) -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_EMAIL_SERVER_IDENTITY" icon="envelope" />
        <criteria label="PARAMETER_ALIAS" id="SrvNam" component="text" validation="{required: true, maxlength: 100}" style="col-xs-12 col-sm-8">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="SrvNam" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <!-- Active as the Es1Es0 select of the EmlSrv screens: 1 or 0 are sent explicitly. A switch that is off sends
             no value, and EmlSrvNew turns a missing Act into 1, so an inactive server would be created active -->
        <criteria label="PARAMETER_ACTIVE" id="Act" component="select" initial-load="enum" target-action="Es1Es0" value="1" style="col-xs-12 col-sm-4">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="Act" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>

        <!-- Connection: host, port (empty is the default port of the security mode) and security mode. A server stored
             before the security mode existed has none: the select, which is not optional, shows its first option (NONE) -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_EMAIL_SERVER_CONNECTION" icon="lucide:plug" />
        <criteria label="PARAMETER_SERVER" id="Hst" component="text" validation="{required: true, maxlength: 60}" style="col-xs-12 col-sm-8">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="Hst" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_SERVER_PORT" id="Prt" component="numeric" number-format="{vMin: '1', vMax: '65535', mDec: 0, aSep: ''}"
                  validation="integer" help="HELP_EML_SRV_PORT" style="col-xs-12 col-sm-4">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="Prt" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_EML_SRV_SECURITY" id="SecMod" component="select" initial-load="enum" target-action="EnuEmlSrvSecMod" value="NONE"
                  validation="required" help="HELP_EML_SRV_SECURITY" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="SecMod" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
          <!-- OAuth2 sends a token as the SMTP credential: it needs STARTTLS or SSL, so None turns into STARTTLS. It stops
               once the security mode is not None -->
          <dependency source-type="value" target-type="input" value="STARTTLS" initial="true">
            <dependency-element id="Ath" condition="eq" value="2" />
            <dependency-element id="SecMod" condition="eq" value="NONE" />
          </dependency>
        </criteria>

        <!-- Authentication: none (0), user and password (1) or OAuth2 (2). The user is the sender mailbox for OAuth2 (its
             label follows the type), the password applies only to user and password and the client registration only to
             OAuth2; each one is cleared when the type does not use it. The stored password is never loaded: EmlSrvUpd
             writes the password only if one is typed (FlgPwdUpd is 1, as in the EmlSrvUpd screen) -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_EMAIL_SERVER_AUTHENTICATION" icon="key" />
        <criteria label="PARAMETER_AUTH" id="Ath" component="select" initial-load="enum" target-action="EnuEmlSrvAth" value="0"
                  validation="required" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="Ath" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_USER" id="EmlUsr" component="text" validation="{maxlength: 255}" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="EmlUsr" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
          <dependency target-type="show" initial="true">
            <dependency-element id="Ath" condition="ne" value="0" />
          </dependency>
          <dependency target-type="set-required" initial="true">
            <dependency-element id="Ath" condition="ne" value="0" />
          </dependency>
          <dependency source-type="reset" target-type="input">
            <dependency-element id="Ath" condition="eq" value="0" />
          </dependency>
          <!-- OAuth2 (XOAUTH2) sends the sender mailbox as the SMTP user -->
          <dependency source-type="value" target-type="label" value="PARAMETER_EML_SRV_SENDER" initial="true">
            <dependency-element id="Ath" condition="eq" value="2" />
          </dependency>
          <dependency source-type="value" target-type="label" value="PARAMETER_USER" initial="true">
            <dependency-element id="Ath" condition="ne" value="2" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_PASSWD" id="EmlPwd" component="password" validation="{maxlength: 250}" style="col-xs-12 col-sm-6" value="">
          <dependency target-type="show" initial="true">
            <dependency-element id="Ath" condition="eq" value="1" />
          </dependency>
          <dependency source-type="reset" target-type="input">
            <dependency-element id="Ath" condition="ne" value="1" />
          </dependency>
        </criteria>
        <!-- Optional for the select: it does not pick the first registration by itself for a server without OAuth2; it is
             required while the authentication is OAuth2 -->
        <criteria label="PARAMETER_EML_SRV_OAUTH_REGISTRATION" id="OauReg" component="select" initial-load="query" server-action="data"
                  target-action="EmlSrvOauRegLst" optional="true" help="HELP_EML_SRV_OAUTH_REGISTRATION" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdEmlSrvAdm" column="OauReg" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdEmlSrvAdm" event="select-row" optional="true" />
          </dependency>
          <dependency target-type="show" initial="true">
            <dependency-element id="Ath" condition="eq" value="2" />
          </dependency>
          <dependency target-type="set-required" initial="true">
            <dependency-element id="Ath" condition="eq" value="2" />
          </dependency>
          <dependency source-type="reset" target-type="input">
            <dependency-element id="Ath" condition="ne" value="2" />
          </dependency>
        </criteria>
        <criteria id="FlgPwdUpd" component="hidden" value="0">
          <dependency source-type="formule" target-type="input" initial="true" formule="'[EmlPwd]' != '' ? '1' : '0'" type="or">
            <dependency-element id="EmlPwd" condition="ne" value="" />
            <dependency-element id="EmlPwd" condition="eq" value="" />
          </dependency>
        </criteria>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="times" id="ButPnlCnl">
          <button-action type="close-cancel" target="PnlEmlSrv" />
        </button>
        <!-- EmlSrvUpd reads IdeAweEmlSrv.selected, which is a single value only with one selected server -->
        <button label="BUTTON_SAVE_CHANGES" icon="save" id="ButPnlUpd" style="btn-primary">
          <button-action type="check-one-selected" target="GrdEmlSrvAdm" />
          <button-action type="validate" target="PnlEmlSrvBdy" />
          <button-action type="confirm" target="UpdMsg" />
          <button-action type="server" server-action="maintain" target-action="EmlSrvUpd" />
          <button-action type="close" target="PnlEmlSrv" />
          <button-action type="filter" target="GrdEmlSrvAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </button>
        <button label="BUTTON_CREATE_EMAIL_SERVER" icon="check" id="ButPnlNew" style="btn-primary">
          <button-action type="validate" target="PnlEmlSrvBdy" />
          <button-action type="confirm" target="NewMsg" />
          <button-action type="server" server-action="control-unique-cancel" target-action="EmlSrvNamUni" target="UniMsg" />
          <button-action type="server" server-action="maintain" target-action="EmlSrvNew" />
          <button-action type="close" target="PnlEmlSrv" />
          <button-action type="filter" target="GrdEmlSrvAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </button>
      </tag>
    </side-panel>
  </tag>
  <tag source="modal">
    <include target-screen="PrnOpt" target-source="center" />
    <include target-screen="screen-help" target-source="center" />
  </tag>
</screen>
