<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : change-expired-password.xml
    Description: Screen to set a new password when the password has expired (public screen).
                 The user is not authenticated: the server only accepts the change in the session that verified
                 the expired password (see PasswordChangeService), so the screen asks only for the new password.
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="full" label="SCREEN_TITLE_CHANGE_EXPIRED_PWD" help="HELP_SCREEN_TITLE_CHANGE_EXPIRED_PWD">
  <tag source="center" type="div" style="fullScreen">
    <tag type="div" id="page-change-password-bg" style="fullScreen">
      <!-- Background overlay -->
      <tag type="div" style="overlay-image fullScreen" />
      <tag type="div" style="overlay fullScreen" />
    </tag>
    <tag type="div" style="awe-change-password change-password-container">

      <!-- Top side -->
      <tag type="div" style="change-password-header">
        <tag type="h1">
          <tag type="span" label="APP_CLIENT"/>
        </tag>
        <tag type="div" style="slogan" label="APP_NAME" />
      </tag>
      <!-- / Top side -->

      <!-- Bottom side -->
      <tag type="div" style="change-password-form">
        <tag type="div" style="change-password-text">
          <tag type="span" label="SCREEN_TEXT_CHANGE_EXPIRED_PWD"/>
        </tag>
        <criteria placeholder="PARAMETER_PASSWD" component="password" id="Pas" validation="{required: true, pattern:{setting:'passwordPattern'}, minlength:{setting:'minlengthPassword'}}" size="lg" icon="key change-password-form-icon" style="no-label" />
        <criteria placeholder="PARAMETER_RETYPE_PASSWD" component="password" id="RetPas" validation="{required: true, eq:{criterion:'Pas', message:'VALIDATOR_MESSAGE_REPEAT_PASSWORD'}}" size="lg" icon="key change-password-form-icon" style="no-label" />
        <tag type="div" style="change-password-with">
          <tag type="div" style="form-actions">
            <button button-type="submit" label="BUTTON_CONFIRM" style="no-class btn btn-primary change-password-btn bg-primary" icon="save" id="ButChdExpPwd">
              <button-action type="validate" />
              <button-action type="server" server-action="maintain" target-action="ChdPwdExpired" />
            </button>
            <button button-type="button" label="BUTTON_BACK" style="no-class btn btn-default change-password-btn" icon="arrow-circle-left" id="ButBckExpPwd">
              <button-action type="screen" target="signin" />
            </button>
          </tag>
        </tag>
      </tag>
      <!-- Bottom side -->
    </tag>
  </tag>
</screen>
