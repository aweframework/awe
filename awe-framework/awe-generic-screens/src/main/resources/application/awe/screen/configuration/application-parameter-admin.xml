<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : application-parameter-admin.xml
    Description: Application parameters: list of the parameters the application reads with a side panel that creates and
                 edits them. Replaces the AweAppPar screen, whose editable grid is saved with a multiple maintain (now
                 AweAppParMul). It reuses the queries of that screen (AweAppParLst, AweAppParSug) and adds the category
                 and the state of each parameter, the counters of the quick filters (AppParStaCnt, AppParStaCntAct,
                 AppParStaCntIna) and the unique check of the name (AppParNamUni) for the new maintains (AweAppParNew,
                 AweAppParUpd, AweAppParDel).
                 The name of a parameter is the key the application reads, so the panel keeps it read-only when editing
                 (S3): the update takes the identifier of the selected row (IdeAweAppPar.selected) and writes the
                 parameter again with its name, its value, its category, its description and its state. Saving a
                 parameter reloads the properties of the application (refreshDatabaseProperties), as the deprecated
                 screen does.
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd"
        template="window" label="SCREEN_TITLE_APP_PAR_ADMIN" help="HELP_SCREEN_TITLE_APP_PAR_ADMIN" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW" />
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE" />
    <message id="UniMsg" title="WARNING_TITLE_DUPLICATED_APP_PAR" message="WARNING_MESSAGE_DUPLICATED_APP_PAR" />
    <!-- Mode of the side panel: new or edit -->
    <criteria id="PnlMod" component="hidden" value="new" />
  </tag>
  <tag source="buttons">
    <!-- Icon only: its label is its tooltip and its accessible name -->
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" style="btn-ghost no-label">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button label="BUTTON_PRINT" icon="print" id="ButPrn" help="HELP_PRINT_BUTTON">
      <button-action type="dialog" target="PrnOpt" />
    </button>
    <button label="BUTTON_NEW_APP_PAR" icon="plus-circle" id="ButNew" style="btn-primary" help="HELP_NEW_BUTTON" permission="system.update">
      <!-- No selected row: no IdeAweAppPar is sent (the identifier comes from its sequence) and the panel starts empty -->
      <button-action type="unselect-all-rows" target="GrdAppParAdm" />
      <button-action type="value" target="PnlMod" value="new" />
      <button-action type="reset" target="ParNam" />
      <button-action type="reset" target="ParVal" />
      <!-- A new parameter belongs to the general category and starts active, the defaults of the AweAppPar table -->
      <button-action type="value" target="Cat" value="0" />
      <button-action type="reset" target="Des" />
      <button-action type="value" target="Act" value="1" />
      <button-action type="dialog" target="PnlAppPar" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_APP_PAR_ADMIN" icon="lucide:sliders-horizontal">
      <grid id="GrdAppParAdm" style="expand" server-action="data" target-action="AweAppParLst" initial-load="query" multiselect="true" max="50">
        <!-- Search: the name or the description of the parameter (AweAppParLst and AppParStaCnt read CrtAppParTxt) -->
        <search id="CrtAppParTxt" placeholder="SCREEN_TEXT_APP_PAR_SEARCH" label="SCREEN_TEXT_APP_PAR_SEARCH_LABEL" />
        <!-- Quick filters: All, Active and Inactive, counted with the search (AppParStaCnt) -->
        <quick-filter id="CrtAppParSta" initial-load="query" target-action="AppParStaCnt" label="SCREEN_TEXT_APP_PAR_FILTERS" value="" />
        <!-- The name takes the rest of the width and shows the description of the parameter under it; the category is a
             plain column, with no quick filter by category -->
        <column label="PARAMETER_NAME" name="ParNam" sort-field="ParNam" align="left" charlength="30" width="*"
                secondary-field="Des" export-secondary="true" secondary-label="PARAMETER_DESCRIPTION" sendable="false" />
        <column label="PARAMETER_VALUE" name="ParVal" sort-field="ParVal" align="center" charlength="20" sendable="false" />
        <column label="PARAMETER_CATEGORY" name="CatTxt" sort-field="Cat" align="left" charlength="16" sendable="false" />
        <column label="PARAMETER_STATUS" name="StaTxt" sort-field="StaCod" align="left" charlength="14" status-field="StaTon" sendable="false" />
        <!-- Sent to AweAppParDel: identifier of the selected parameters. Its .selected value is the parameter AweAppParUpd
             updates -->
        <column name="IdeAweAppPar" hidden="true" />
        <!-- Read by the cells and by the side panel; not sent (their names are criteria of the panel) -->
        <column name="Cat" hidden="true" sendable="false" />
        <column name="Act" hidden="true" sendable="false" />
        <column name="Des" hidden="true" sendable="false" />
        <column name="StaCod" hidden="true" sendable="false" />
        <column name="StaTon" hidden="true" sendable="false" />
        <!-- Row actions: the pencil edits the parameter of its row in the side panel and the ellipsis opens the row menu.
             A row button selects its row (only it) before its actions, so the panel is filled with that parameter -->
        <column name="EdtBtn" component="button" icon="lucide:pencil" title="BUTTON_EDIT" style="btn-ghost no-label" align="right" charlength="4" sortable="false" sendable="false">
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="dialog" target="PnlAppPar" />
        </column>
        <column name="MorBtn" component="button" icon="lucide:ellipsis" title="BUTTON_MORE_ACTIONS" style="btn-ghost no-label" align="left" charlength="4" sortable="false" sendable="false">
          <button-action type="show-context-menu" />
        </column>
        <!-- Row menu -->
        <context-button label="BUTTON_EDIT" icon="edit" id="CtxButUpd">
          <button-action type="check-one-selected" target="GrdAppParAdm" />
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="dialog" target="PnlAppPar" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdAppParAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <context-separator name="CtxSepDel" />
        <context-button label="BUTTON_DELETE" icon="trash" id="CtxButDel">
          <button-action type="check-some-selected" target="GrdAppParAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="AweAppParDel" />
          <button-action type="filter" target="GrdAppParAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdAppParAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </context-button>
        <!-- Selection actions: in the selection bar of the grid while there are selected parameters, Delete as the danger one -->
        <button label="BUTTON_DELETE" icon="trash" id="ButDel" help="HELP_DELETE_BUTTON" style="btn-danger" selection="true">
          <button-action type="check-some-selected" target="GrdAppParAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="AweAppParDel" />
          <button-action type="filter" target="GrdAppParAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdAppParAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </button>
      </grid>
    </window>

    <!-- One side panel for new and edit: the criteria ids are the parameters of AweAppParNew and AweAppParUpd. When editing
         (one selected parameter) its header shows the parameter: name and the state tag; for a new parameter (no selected
         row) it shows its label -->
    <side-panel id="PnlAppPar" label="SCREEN_TITLE_APP_PAR_PANEL" icon="lucide:sliders-horizontal" max-width="560px"
                header-grid="GrdAppParAdm" header-title-field="ParNam">
      <header-tag field="StaTxt" tone-field="StaTon" />
      <tag type="div" style="panel-body" id="PnlAppParBdy">
        <!-- Identity: the name, the category and the state of the parameter -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_APP_PAR_IDENTITY" icon="lucide:sliders-horizontal" />
        <criteria label="PARAMETER_NAME" id="ParNam" component="text" validation="{required: true, maxlength: 40}" style="col-xs-12 col-sm-7">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdAppParAdm" column="ParNam" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdAppParAdm" event="select-row" optional="true" />
          </dependency>
          <!-- The name of a parameter is the key the application reads: it is typed only when it is created (S3) -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_CATEGORY" id="Cat" component="select" initial-load="enum" target-action="CatParTyp" validation="required" style="col-xs-12 col-sm-5">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdAppParAdm" column="Cat" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdAppParAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <!-- Active as a switch: 1 when on, 0 when off (AweAppParNew and AweAppParUpd read Act); a new parameter starts active -->
        <criteria label="PARAMETER_ACTIVE" id="Act" component="checkbox" value="1" style="col-xs-12 col-sm-5 switch">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdAppParAdm" column="Act" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdAppParAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>

        <!-- Value: the value the application reads for the parameter and its description -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_APP_PAR_VALUE" icon="lucide:sliders-horizontal" />
        <criteria label="PARAMETER_VALUE" id="ParVal" component="text" validation="{maxlength: 60}" style="col-xs-12">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdAppParAdm" column="ParVal" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdAppParAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_DESCRIPTION" id="Des" component="textarea" validation="{maxlength: 250}" style="col-xs-12">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdAppParAdm" column="Des" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdAppParAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <!-- Saving a parameter reloads the properties of the application, as the deprecated screen did -->
        <criteria id="AppParValHlp" component="text-view" style="col-xs-12 text-muted">
          <dependency source-type="label" target-type="input" label="SCREEN_TEXT_APP_PAR_RELOAD_HINT" initial="true">
            <dependency-element id="PnlMod" />
          </dependency>
        </criteria>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="times" id="ButPnlCnl">
          <button-action type="close-cancel" target="PnlAppPar" />
        </button>
        <!-- AweAppParUpd reads IdeAweAppPar.selected, which is a single value only with one selected parameter -->
        <button label="BUTTON_SAVE_CHANGES" icon="save" id="ButPnlUpd" style="btn-primary">
          <button-action type="check-one-selected" target="GrdAppParAdm" />
          <button-action type="validate" target="PnlAppParBdy" />
          <button-action type="confirm" target="UpdMsg" />
          <button-action type="server" server-action="maintain" target-action="AweAppParUpd" />
          <button-action type="server" server-action="maintain-silent" target-action="refreshDatabaseProperties" />
          <button-action type="close" target="PnlAppPar" />
          <button-action type="filter" target="GrdAppParAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </button>
        <button label="BUTTON_CREATE_APP_PAR" icon="check" id="ButPnlNew" style="btn-primary">
          <button-action type="validate" target="PnlAppParBdy" />
          <button-action type="confirm" target="NewMsg" />
          <button-action type="server" server-action="control-unique-cancel" target-action="AppParNamUni" target="UniMsg" />
          <button-action type="server" server-action="maintain" target-action="AweAppParNew" />
          <button-action type="server" server-action="maintain-silent" target-action="refreshDatabaseProperties" />
          <button-action type="close" target="PnlAppPar" />
          <button-action type="filter" target="GrdAppParAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </button>
      </tag>
    </side-panel>
  </tag>
  <tag source="modal">
    <include target-screen="PrnOpt" target-source="center" />
    <include target-screen="screen-help" target-source="center" />
  </tag>
</screen>
