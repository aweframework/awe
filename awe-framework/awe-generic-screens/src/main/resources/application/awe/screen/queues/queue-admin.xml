<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : queue-admin.xml
    Description: Message queues (screen queue-admin): list of the JMS queues of the application with a side panel to create
                 and edit them.
                 Replaces the Que, QueNew and QueUpd screens; it reuses their queries and maintains (QueLst, QueNew, QueUpd,
                 QueDel, QueAlsUni) and has its own counters of the quick filters (QueStaCnt, QueStaCntAct, QueStaCntIna).
                 The grid sends IdeAweQue (the selected rows) to QueDel and no other column is sendable: the columns named
                 as a criterion of the panel take their value from the selected row, so saving a queue sends the values of
                 the panel with that identifier and never a column of another row.
                 The grid never shows nor sends the password of a queue: the panel writes only the typed one (FlgPwdUpd, as
                 the QueUpd screen does), so the stored password is never replaced by an empty one (D3).
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd"
        template="window" label="SCREEN_TITLE_QUEUE_ADMIN" help="HELP_SCREEN_TITLE_QUEUE_ADMIN" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW" />
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE" />
    <message id="UniMsg" title="WARNING_TITLE_DUPLICATED_QUEUE" message="WARNING_MESSAGE_DUPLICATED_QUEUE" />
    <!-- Mode of the side panel: new or edit -->
    <criteria id="PnlMod" component="hidden" value="new" />
  </tag>
  <tag source="buttons">
    <!-- Icon only: its label is its tooltip and its accessible name -->
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" style="btn-ghost no-label">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button label="BUTTON_PRINT" icon="print" id="ButPrn" help="HELP_PRINT_BUTTON">
      <button-action type="dialog" target="PrnOpt" />
    </button>
    <button label="BUTTON_NEW_QUEUE" icon="plus-circle" id="ButNew" style="btn-primary" help="HELP_NEW_BUTTON" permission="system.update">
      <!-- No selected row: no IdeAweQue is sent (QueNew takes it from its sequence) and the panel starts empty, as the
           QueNew screen; a new queue starts active (it is the default of QueNew) -->
      <button-action type="unselect-all-rows" target="GrdQueAdm" />
      <button-action type="value" target="PnlMod" value="new" />
      <button-action type="reset" target="Als" />
      <button-action type="reset" target="Des" />
      <button-action type="value" target="Act" value="1" />
      <button-action type="reset" target="QueTyp" />
      <button-action type="reset" target="DstNam" />
      <button-action type="reset" target="ConTyp" />
      <button-action type="reset" target="JmsBrk" />
      <button-action type="reset" target="JmsUsr" />
      <button-action type="reset" target="JmsPwd" />
      <button-action type="dialog" target="PnlQue" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_QUEUE_ADMIN" icon="lucide:inbox">
      <grid id="GrdQueAdm" style="expand" server-action="data" target-action="QueLst" initial-load="query" multiselect="true" max="50">
        <!-- Search: the alias of the queue (QueLst and QueStaCnt read CrtAls). It is the criterion of the deprecated Que
             screen, so the search keeps filtering the same variable (D2) -->
        <search id="CrtAls" placeholder="SCREEN_TEXT_QUEUE_SEARCH" label="SCREEN_TEXT_QUEUE_SEARCH_LABEL" />
        <!-- Quick filters: All, Active and Inactive, counted with the search (QueStaCnt) -->
        <quick-filter id="CrtQueSta" initial-load="query" target-action="QueStaCnt" label="SCREEN_TEXT_QUEUE_FILTERS" value="" />
        <!-- Three columns: the alias with its description below it, the destination and the state as status. The queue type,
             the broker, the connection type, the user and the password are panel data only (D3): with more or wider columns
             the alias, which is the starred one, collapses and its text cannot be read in the React engine -->
        <column label="PARAMETER_ALIAS" name="Als" sort-field="Als" align="left" charlength="30"
                secondary-field="Des" export-secondary="true" secondary-label="PARAMETER_DESCRIPTION" sendable="false" />
        <column label="PARAMETER_DESTINATION" name="DstNam" sort-field="DstNam" align="left" charlength="16" sendable="false" />
        <column label="PARAMETER_STATUS" name="StaTxt" sort-field="StaCod" align="left" charlength="12" status-field="StaTon" sendable="false" />
        <!-- Sent to QueDel: identifier of the selected queues -->
        <column name="IdeAweQue" hidden="true" />
        <!-- Read by the cells, by the side panel and by its header; not sent (their names are criteria of the panel). The
             shown columns above are not sent either, so no column of the grid is sent but IdeAweQue -->
        <column name="Des" hidden="true" sendable="false" />
        <column name="JmsBrk" hidden="true" sendable="false" />
        <column name="QueTyp" hidden="true" sendable="false" />
        <column name="ConTyp" hidden="true" sendable="false" />
        <column name="ConTypTrans" hidden="true" sendable="false" />
        <column name="JmsUsr" hidden="true" sendable="false" />
        <column name="Act" hidden="true" sendable="false" />
        <column name="StaCod" hidden="true" sendable="false" />
        <column name="StaTon" hidden="true" sendable="false" />
        <!-- Row actions: the pencil edits the queue of its row in the side panel and the ellipsis opens the row menu. A row
             button selects its row (only it) before its actions, so the panel is filled with that queue -->
        <column name="EdtBtn" component="button" icon="lucide:pencil" title="BUTTON_EDIT" style="btn-ghost no-label" align="right" charlength="4" sortable="false" sendable="false">
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="reset" target="JmsPwd" />
          <button-action type="dialog" target="PnlQue" />
        </column>
        <column name="MorBtn" component="button" icon="lucide:ellipsis" title="BUTTON_MORE_ACTIONS" style="btn-ghost no-label" align="left" charlength="4" sortable="false" sendable="false">
          <button-action type="show-context-menu" />
        </column>
        <!-- Row menu -->
        <context-button label="BUTTON_EDIT" icon="edit" id="CtxButUpd">
          <button-action type="check-one-selected" target="GrdQueAdm" />
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="reset" target="JmsPwd" />
          <button-action type="dialog" target="PnlQue" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdQueAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <!-- Duplicate: the panel opens as a new queue with the values of the selected one; the password starts empty (the
             alias is taken, so the create action refuses it until it changes) -->
        <context-button label="BUTTON_DUPLICATE_QUEUE" icon="copy" id="CtxButDup" permission="system.update">
          <button-action type="check-one-selected" target="GrdQueAdm" />
          <button-action type="value" target="PnlMod" value="new" />
          <button-action type="reset" target="JmsPwd" />
          <button-action type="dialog" target="PnlQue" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdQueAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <context-separator name="CtxSepDel" />
        <context-button label="BUTTON_DELETE" icon="trash" id="CtxButDel">
          <button-action type="check-some-selected" target="GrdQueAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="QueDel" />
          <button-action type="filter" target="GrdQueAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdQueAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </context-button>
        <!-- Selection actions: in the selection bar of the grid while there are selected queues, Delete as the danger one -->
        <button label="BUTTON_DELETE" icon="trash" id="ButDel" help="HELP_DELETE_BUTTON" style="btn-danger" selection="true">
          <button-action type="check-some-selected" target="GrdQueAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="QueDel" />
          <button-action type="filter" target="GrdQueAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdQueAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </button>
      </grid>
    </window>

    <!-- One side panel for new and edit: the criteria ids are the parameters of QueNew and QueUpd. When editing (one
         selected queue) its header shows the queue: alias and the state tag; for a new queue (no selected row) it shows its
         label -->
    <side-panel id="PnlQue" label="SCREEN_TITLE_QUEUE_PANEL" icon="lucide:inbox" max-width="560px"
                header-grid="GrdQueAdm" header-title-field="Als">
      <header-tag field="StaTxt" tone-field="StaTon" />
      <tag type="div" style="panel-body" id="PnlQueBdy">
        <!-- Identity: alias, state (a new queue starts active) and description -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_QUEUE_IDENTITY" icon="lucide:tags" />
        <criteria label="PARAMETER_ALIAS" id="Als" component="text" validation="required" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="Als" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <!-- Active as a select and not as the switch of the other admin windows: AweQue.Act is NOT NULL and QueNew defaults
             a missing one to 1, so an unchecked switch would create an active queue; the select sends 0 or 1 explicitly
             (D1) -->
        <criteria label="PARAMETER_ACTIVE" id="Act" component="select" initial-load="enum" target-action="Es1Es0" validation="required" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="Act" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_DESCRIPTION" id="Des" component="textarea" style="col-xs-12">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="Des" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>

        <!-- Queue: its type, its destination and how the broker is reached -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_QUEUE_DATA" icon="lucide:send" />
        <criteria label="PARAMETER_QUEUE_TYPE" id="QueTyp" component="select" initial-load="enum" target-action="EnuQueTyp" validation="required" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="QueTyp" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_DESTINATION" id="DstNam" component="text" validation="required" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="DstNam" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_CONNECTION" id="ConTyp" component="select" initial-load="enum" target-action="EnuQueConTyp" validation="required" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="ConTyp" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>

        <!-- Connection: the broker, its user and its password. The stored password is never loaded: QueUpd writes the
             password only if one is typed (FlgPwdUpd is 1, as in the QueUpd screen) -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_QUEUE_CONNECTION" icon="lucide:plug" />
        <criteria label="PARAMETER_BROKER" id="JmsBrk" component="text" validation="required" style="col-xs-12">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="JmsBrk" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_USER" id="JmsUsr" component="text" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdQueAdm" column="JmsUsr" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdQueAdm" event="select-row" optional="true" />
          </dependency>
          <!-- The user and the password only apply to a remote broker (as the QueUpd screen: ConTyp R is remote, J is JNDI) -->
          <dependency target-type="set-editable" initial="true">
            <dependency-element id="ConTyp" condition="eq" value="R" />
          </dependency>
          <dependency source-type="reset" target-type="input" initial="true">
            <dependency-element id="ConTyp" condition="ne" value="R" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_PASSWD" id="JmsPwd" component="password" style="col-xs-12 col-sm-6" value="">
          <dependency target-type="set-editable" initial="true">
            <dependency-element id="ConTyp" condition="eq" value="R" />
          </dependency>
          <dependency source-type="reset" target-type="input" initial="true">
            <dependency-element id="ConTyp" condition="ne" value="R" />
          </dependency>
        </criteria>
        <criteria id="FlgPwdUpd" component="hidden" value="0">
          <dependency source-type="formule" target-type="input" initial="true" formule="'[JmsPwd]' != '' ? '1' : '0'" type="or">
            <dependency-element id="JmsPwd" condition="ne" value="" />
            <dependency-element id="JmsPwd" condition="eq" value="" />
          </dependency>
        </criteria>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="times" id="ButPnlCnl">
          <button-action type="close-cancel" target="PnlQue" />
        </button>
        <!-- QueUpd reads IdeAweQue.selected, which is a single value only with one selected queue -->
        <button label="BUTTON_SAVE_CHANGES" icon="save" id="ButPnlUpd" style="btn-primary">
          <button-action type="check-one-selected" target="GrdQueAdm" />
          <button-action type="validate" target="PnlQueBdy" />
          <button-action type="confirm" target="UpdMsg" />
          <button-action type="server" server-action="maintain" target-action="QueUpd" />
          <button-action type="close" target="PnlQue" />
          <button-action type="filter" target="GrdQueAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </button>
        <button label="BUTTON_CREATE_QUEUE" icon="check" id="ButPnlNew" style="btn-primary">
          <button-action type="validate" target="PnlQueBdy" />
          <button-action type="confirm" target="NewMsg" />
          <button-action type="server" server-action="control-unique-cancel" target-action="QueAlsUni" target="UniMsg" />
          <button-action type="server" server-action="maintain" target-action="QueNew" />
          <button-action type="close" target="PnlQue" />
          <button-action type="filter" target="GrdQueAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </button>
      </tag>
    </side-panel>
  </tag>
  <tag source="modal">
    <include target-screen="PrnOpt" target-source="center" />
    <include target-screen="screen-help" target-source="center" />
  </tag>
</screen>
