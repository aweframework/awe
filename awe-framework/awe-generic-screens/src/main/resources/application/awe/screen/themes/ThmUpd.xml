<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : ThmUpd.xml
    Created on : 13 de febrero de 2013
    Author     : Pablo VIDAL
    Description: Ventana de herramientas - Modificaci?n de Tema
    DEPRECATED since AWE 5.0.0: replaced by the theme-admin screen (screen/themes/theme-admin.xml), which the
    "themes" option of the default menu opens. This screen will be removed in the next minor release (5.1.0).
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_THM_UPD" help="HELP_SCREEN_TITLE_THM_UPD">
  <tag source="hidden">
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
  </tag>
  <tag source="buttons">
    <button button-type="button" label="BUTTON_BACK" icon="arrow-circle-left" id="ButBck" help="HELP_BACK_BUTTON">
      <button-action type="back" />
    </button>
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" help="HELP_HELP_BUTTON">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button button-type="button" label="BUTTON_CONFIRM" icon="save" id="ButCnf" help="HELP_CONFIRM_BUTTON">
      <button-action type="validate" />
      <button-action type="confirm" target="UpdMsg" />
      <button-action type="server" server-action="maintain" target-action="ThmUpd" />
      <button-action type="back" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TEXT_DATA">
      <tag type="div" style="panel-body static">
        <criteria label="PARAMETER_IDE" id="IdeThm" component="hidden" variable="IdeThm" />
        <criteria label="PARAMETER_THEME" id="Nam" component="text" variable="Nam" validation="required" style="col-xs-12 col-sm-8 col-lg-3" />
        <criteria label="PARAMETER_ACTIVE" id="Act" component="select" initial-load="enum" target-action="Es1Es0" variable="Act" validation="required" style="col-xs-12 col-sm-4 col-lg-2" />
        <!-- Each colour is a palette of the select or, when it is custom, the hex of the colour picker -->
        <criteria label="PARAMETER_THEME_PRIMARY" id="PriPal" component="select" initial-load="enum" target-action="ThmPri" variable="PriPal" validation="required" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_THEME_PRIMARY_HEX" id="PriHex" component="color" variable="PriHex" style="col-xs-12 col-sm-6 col-lg-3">
          <dependency target-type="show" initial="true">
            <dependency-element id="PriPal" condition="eq" value="custom" />
          </dependency>
          <dependency target-type="set-required" initial="true">
            <dependency-element id="PriPal" condition="eq" value="custom" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_THEME_SURFACE" id="SrfPal" component="select" initial-load="enum" target-action="ThmSrf" variable="SrfPal" validation="required" style="col-xs-12 col-sm-6 col-lg-3" />
        <criteria label="PARAMETER_THEME_SURFACE_HEX" id="SrfHex" component="color" variable="SrfHex" style="col-xs-12 col-sm-6 col-lg-3">
          <dependency target-type="show" initial="true">
            <dependency-element id="SrfPal" condition="eq" value="custom" />
          </dependency>
          <dependency target-type="set-required" initial="true">
            <dependency-element id="SrfPal" condition="eq" value="custom" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_THEME_MODE" id="Mde" component="select" initial-load="enum" target-action="ThmMde" variable="Mde" validation="required" style="col-xs-12 col-sm-6 col-lg-2" />
      </tag>
    </window>
  </tag>
  <tag source="modal">
    <include target-screen="screen-help" target-source="center"/>
  </tag>
</screen>