<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : home_vertical.xml
    Created on : 8 de febrero de 2010, 16:30
    Author     : Pablo GARCIA
    Description: New Home page (Menu and Report)
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="full" onload="MgrUsrLogIn">

  <!--
  SAMPLE DEFAULT PARAMETER LOADING
  target="SesPrm" -->

  <!-- Center Zone: Show menu and reports -->
  <tag source="center" type="div" style="fullScreen" expandible="vertical">
    <tag type="div" id="main-wrapper" style="expand" expandible="vertical">
      <tag type="div" id="main-navbar" style="navbar navbar-inverse">
        <button label="BUTTON_HIDE_MENU" button-type="button" id="main-menu-toggle" icon="lucide:panel-left icon navbar-icon" style="no-class">
          <button-action type="toggle-menu" />
        </button>
        <include target-screen="home_navbar" target-source="center" />
      </tag>
      <tag type="div" id="main-menu" style="menu-shadow vertical">
        <tag type="div" id="main-menu-bg" style="main-menu-inner">
          <menu-container id="MainMenu" style="navigation vertical" />
          <!-- Footer of the side menu: who powers the application, and the button that collapses the menu -->
          <tag type="div" style="sidebar-footer">
            <tag type="span" style="sidebar-powered">
              <tag type="span" label="SIDEBAR_POWERED_BY"/>
              <tag type="strong" label="SIDEBAR_POWERED_BRAND"/>
            </tag>
            <button label="BUTTON_TOGGLE_MENU" button-type="button" id="collapse-menu" icon="lucide:chevrons-left" style="sidebar-collapse no-class">
              <button-action type="toggle-menu" />
            </button>
          </tag>
        </tag>
      </tag>
      <tag type="div" id="content-wrapper" style="expand" expandible="vertical">
        <view name="report" style="expand reportView expandible-vertical"/>
      </tag>
    </tag>
  </tag>

  <tag source="modal">
    <include target-screen="home_navbar" target-source="modal" />
  </tag>
</screen>