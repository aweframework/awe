<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : user-admin.xml
    Description: Users (#793): list of users with a side panel to create and edit them. Opt-in alternative to the
                 Usr, UsrNew, UsrUpd and UsrViw screens; it reuses their queries and maintains (UsrLst, UsrNew, UsrUpd,
                 UsrDel, reset2fa) plus UsrUnl to unlock. The grid sends IdeOpe (the selected rows) to every maintain,
                 so the panel has no IdeOpe criterion, and the grid columns named as a panel criterion are not sendable.
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_USER_ADMIN" help="HELP_SCREEN_TITLE_USER_ADMIN" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW" />
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
    <message id="UniMsg" title="WARNING_TITLE_DUPLICATED_USER" message="WARNING_MESSAGE_DUPLICATED_USER" />
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE" />
    <message id="Rst2faMsg" title="CONFIRM_TITLE_RESET_2FA" message="CONFIRM_MESSAGE_RESET_2FA" />
    <message id="UnlMsg" title="CONFIRM_TITLE_UNLOCK_USER" message="CONFIRM_MESSAGE_UNLOCK_USER" />
    <!-- Mode of the side panel: new or edit -->
    <criteria id="PnlMod" component="hidden" value="new" />
    <criteria id="MinPwd" component="hidden" property="MinPwd" />
  </tag>
  <tag source="buttons">
    <!-- Icon only: its label is its tooltip and its accessible name -->
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" style="btn-ghost no-label">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button label="BUTTON_PRINT" icon="print" id="ButPrn" help="HELP_PRINT_BUTTON">
      <button-action type="dialog" target="PrnOpt" />
    </button>
    <button label="BUTTON_NEW_USER" icon="plus-circle" id="ButNew" style="btn-primary" help="HELP_NEW_BUTTON">
      <!-- No selected row: no IdeOpe is sent and the panel starts empty -->
      <button-action type="unselect-all-rows" target="GrdUsrAdm" />
      <button-action type="value" target="PnlMod" value="new" />
      <button-action type="reset" target="Nam" />
      <button-action type="reset" target="Eml" />
      <button-action type="reset" target="Usr" />
      <button-action type="value" target="Lan" value="es-ES" />
      <button-action type="reset" target="Pro" />
      <button-action type="reset" target="ScrIni" />
      <button-action type="reset" target="Res" />
      <button-action type="value" target="Sta" value="1" />
      <button-action type="reset" target="Pas" />
      <button-action type="reset" target="RetPas" />
      <button-action type="reset" target="Thm" />
      <button-action type="reset" target="EmlSrv" />
      <button-action type="reset" target="PcPrn" />
      <button-action type="reset" target="WebPrn" />
      <button-action type="value" target="PwdLck" value="0" />
      <button-action type="dialog" target="PnlUsr" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_USER_ADMIN" icon="list">
      <grid id="GrdUsrAdm" style="expand" server-action="data" target-action="UsrLst" multiselect="true" initial-load="query" max="50">
        <!-- Search: full name, login, email or profile (UsrLst and UsrStaCnt read CrtUsrTxt) -->
        <search id="CrtUsrTxt" placeholder="SCREEN_TEXT_USER_SEARCH" label="SCREEN_TEXT_USER_SEARCH_LABEL" />
        <!-- Quick filters: All, Locked, Without 2FA and Inactive, counted with the search (UsrStaCnt) -->
        <quick-filter id="CrtUsrSta" initial-load="query" target-action="UsrStaCnt" label="SCREEN_TEXT_USER_FILTERS" value="" />
        <column label="PARAMETER_USER" name="FulNam" sort-field="FulNam" align="left" charlength="30" width="*" secondary-field="UsrSec" export-secondary="true" secondary-label="PARAMETER_USER" avatar-field="Ini" avatar-tone-field="IniTon" sendable="false" />
        <!-- The user takes the rest of the width; the other columns are wide enough to read as columns, as in the design -->
        <column label="PARAMETER_PROFILE" name="ProTxt" sort-field="ProTxt" align="left" charlength="16" sendable="false" />
        <column label="PARAMETER_STATUS" name="StaTxt" sort-field="StaCod" align="left" charlength="14" status-field="StaTon" sendable="false" />
        <!-- Two-factor as a plain tag, as in the design: a shield and "On", or "Off" without icon; sorted by the 2fa value -->
        <column label="PARAMETER_2FA" name="2faTxt" sort-field="2fa" align="left" charlength="10" status-field="2faTon" icon-field="2faIcn" sendable="false" />
        <column label="PARAMETER_LANGUAGE" name="LanTxt" sort-field="Lan" align="left" charlength="12" sendable="false" />
        <!-- Sent to the maintains: identifier of the selected users -->
        <column name="IdeOpe" hidden="true" />
        <!-- Read by the cells and by the side panel; not sent (their names are criteria of the panel) -->
        <column name="UsrSec" hidden="true" sendable="false" />
        <column name="StaTon" hidden="true" sendable="false" />
        <column name="Ini" hidden="true" sendable="false" />
        <column name="IniTon" hidden="true" sendable="false" />
        <column name="2faTon" hidden="true" sendable="false" />
        <column name="2faIcn" hidden="true" sendable="false" />
        <!-- Read by the identity header of the side panel: subtitle (login · profile) and two-factor tag (only when on) -->
        <column name="UsrPro" hidden="true" sendable="false" />
        <column name="2faHdr" hidden="true" sendable="false" />
        <column name="StaCod" hidden="true" sendable="false" />
        <column name="Nom" hidden="true" sendable="false" />
        <column name="Nam" hidden="true" sendable="false" />
        <column name="Eml" hidden="true" sendable="false" />
        <column name="Lan" hidden="true" sendable="false" />
        <column name="Pro" hidden="true" sendable="false" />
        <column name="ScrIni" hidden="true" sendable="false" />
        <column name="Res" hidden="true" sendable="false" />
        <column name="Sta" hidden="true" sendable="false" />
        <column name="Lck" hidden="true" sendable="false" />
        <column name="Thm" hidden="true" sendable="false" />
        <column name="EmlSrv" hidden="true" sendable="false" />
        <column name="Prn" hidden="true" sendable="false" />
        <column name="WebPrn" hidden="true" sendable="false" />
        <!-- Row actions: the pencil edits the user of its row in the side panel and the ellipsis opens the row menu. A row
             button selects its row (only it) before its actions, so the panel is filled with that user -->
        <column name="EdtBtn" component="button" icon="lucide:pencil" title="BUTTON_EDIT" style="btn-ghost no-label" align="right" charlength="4" sortable="false" sendable="false">
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="reset" target="Pas" />
          <button-action type="reset" target="RetPas" />
          <button-action type="dialog" target="PnlUsr" />
        </column>
        <column name="MorBtn" component="button" icon="lucide:ellipsis" title="BUTTON_MORE_ACTIONS" style="btn-ghost no-label" align="left" charlength="4" sortable="false" sendable="false">
          <button-action type="show-context-menu" />
        </column>
        <!-- Row menu -->
        <context-button label="BUTTON_EDIT" icon="edit" id="CtxButUpd">
          <button-action type="check-one-selected" target="GrdUsrAdm" />
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="reset" target="Pas" />
          <button-action type="reset" target="RetPas" />
          <button-action type="dialog" target="PnlUsr" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdUsrAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <context-button label="BUTTON_UNLOCK_ACCOUNT" icon="lucide:lock-open" id="CtxButUnl">
          <button-action type="check-one-selected" target="GrdUsrAdm" />
          <button-action type="confirm" target="UnlMsg" />
          <button-action type="server" server-action="maintain" target-action="UsrUnl" />
          <button-action type="filter" target="GrdUsrAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdUsrAdm" attribute="selectedRows" condition="eq" value="1" />
            <dependency-element id="GrdUsrAdm" column="Lck" attribute="selectedRowValue" condition="eq" value="1" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </context-button>
        <context-button label="BUTTON_RESET_2FA" icon="shield" id="CtxButRst2fa">
          <button-action type="check-some-selected" target="GrdUsrAdm" />
          <button-action type="confirm" target="Rst2faMsg" />
          <button-action type="server" server-action="maintain" target-action="reset2fa" />
          <button-action type="filter" target="GrdUsrAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdUsrAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </context-button>
        <context-separator name="CtxSepDel" />
        <context-button label="BUTTON_DELETE" icon="trash" id="CtxButDel">
          <button-action type="check-some-selected" target="GrdUsrAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="UsrDel" />
          <button-action type="filter" target="GrdUsrAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdUsrAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </context-button>
        <!-- Selection actions: in the selection bar of the grid while there are selected users, Delete as the danger one -->
        <button label="BUTTON_RESET_2FA" icon="shield" id="ButRst2fa" help="HELP_RESET_2FA_BUTTON" selection="true">
          <button-action type="check-some-selected" target="GrdUsrAdm" />
          <button-action type="confirm" target="Rst2faMsg" />
          <button-action type="server" server-action="maintain" target-action="reset2fa" />
          <button-action type="filter" target="GrdUsrAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdUsrAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </button>
        <button label="BUTTON_DELETE" icon="trash" id="ButDel" help="HELP_DELETE_BUTTON" style="btn-danger" selection="true">
          <button-action type="check-some-selected" target="GrdUsrAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="UsrDel" />
          <button-action type="filter" target="GrdUsrAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdUsrAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </button>
      </grid>
    </window>

    <!-- One side panel for new and edit: the criteria ids are the parameters of UsrNew and UsrUpd. When editing (one
         selected user) its header shows the user: avatar, full name, login · profile and the state and two-factor tags;
         for a new user (no selected row) it shows its label -->
    <side-panel id="PnlUsr" label="SCREEN_TITLE_USER_PANEL" icon="user" max-width="40rem"
                header-grid="GrdUsrAdm" header-title-field="FulNam" header-subtitle-field="UsrPro"
                header-avatar-field="Ini" header-avatar-tone-field="IniTon">
      <header-tag field="StaTxt" tone-field="StaTon" />
      <header-tag field="2faHdr" tone-field="2faTon" icon-field="2faIcn" />
      <tag type="div" style="panel-body" id="PnlUsrBdy">
        <!-- Locked notice (edit mode, locked user) -->
        <criteria id="PnlLckTxt" component="text-view" style="col-xs-12 text-danger">
          <!-- Launched by PnlMod: a dependency without elements runs on every model change, its own included (endless loop) -->
          <dependency source-type="label" target-type="input" label="SCREEN_TEXT_USER_LOCKED_NOTICE" initial="true">
            <dependency-element id="PnlMod" />
          </dependency>
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PwdLck" condition="eq" value="1" />
          </dependency>
        </criteria>
        <tag type="div" style="col-xs-12">
          <button label="BUTTON_UNLOCK" icon="lucide:lock-open" id="ButPnlUnl">
            <button-action type="confirm" target="UnlMsg" />
            <button-action type="server" server-action="maintain" target-action="UsrUnl" />
            <button-action type="value" target="PwdLck" value="0" />
            <button-action type="filter" target="GrdUsrAdm" />
            <dependency target-type="show" initial="true">
              <dependency-element id="PnlMod" condition="eq" value="edit" />
              <dependency-element id="PwdLck" condition="eq" value="1" />
            </dependency>
          </button>
        </tag>

        <!-- Identity -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_USER_IDENTITY" icon="user" />
        <criteria label="PARAMETER_FULL_NAME" id="Nam" component="text" validation="required" style="col-xs-12">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Nam" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_EMAIL" id="Eml" component="text" icon="envelope" style="col-xs-12">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Eml" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_USER" id="Usr" component="text" validation="required" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Nom" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
          <!-- The login cannot be changed once created -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_LANGUAGE" id="Lan" component="select" validation="required" initial-load="enum" target-action="Lan" value="es-ES" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Lan" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>

        <!-- Access -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_USER_ACCESS" icon="shield" />
        <criteria label="PARAMETER_PROFILE" id="Pro" component="suggest" validation="required" server-action="data" target-action="ProSug" check-target="ProIni" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Pro" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_SCREEN" id="ScrIni" component="suggest" server-action="data" target-action="getScreenList" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="ScrIni" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_FILE_RESTRICTION" id="Res" component="select" initial-load="query" target-action="ProNamLst" optional="true" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Res" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <!-- Active as a switch: 1 when on, 0 when off (UsrNew and UsrUpd read Sta); a new user starts active -->
        <criteria label="PARAMETER_ACTIVE" id="Sta" component="checkbox" value="1" style="col-xs-12 col-sm-6 switch">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Sta" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <!-- Current lock flag of the user: UsrUpd writes it back, so it must keep the stored value -->
        <criteria id="PwdLck" component="hidden" value="0">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Lck" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>

        <!-- Sign-in security: typed password (required when creating, optional when editing) -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_USER_SIGN_IN_SECURITY" icon="lucide:key-round" />
        <criteria id="FlgPwdUpd" component="hidden" value="0">
          <dependency source-type="formule" target-type="input" initial="true" formule="'[Pas]' != 'null' &amp;&amp; '[Pas]' != '' ? 1 : 0" type="or">
            <dependency-element id="Pas" condition="ne" value="" />
            <dependency-element id="Pas" condition="eq" value="" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_PASSWD" id="Pas" component="password" validation="{pattern:{setting:'passwordPattern'}, minlength:{setting:'minlengthPassword'}}" style="col-xs-12 col-sm-6" value="">
          <dependency target-type="set-required" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_RETYPE_PASSWD" id="RetPas" component="password" validation="{eq:{criterion:'Pas'}}" style="col-xs-12 col-sm-6" value="">
          <dependency target-type="set-required" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </criteria>
        <tag type="div" style="col-xs-12">
          <button label="BUTTON_RESET_2FA" icon="shield" id="ButPnlRst2fa">
            <button-action type="confirm" target="Rst2faMsg" />
            <button-action type="server" server-action="maintain" target-action="reset2fa" />
            <button-action type="filter" target="GrdUsrAdm" />
            <dependency target-type="show" initial="true">
              <dependency-element id="PnlMod" condition="eq" value="edit" />
            </dependency>
          </button>
        </tag>

        <!-- Appearance and output -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_USER_APPEARANCE_OUTPUT" icon="lucide:sliders-horizontal" />
        <criteria label="PARAMETER_THEME" id="Thm" component="suggest" server-action="data" target-action="ThmSug" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Thm" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_EMAIL_SERVER" id="EmlSrv" component="select" initial-load="query" target-action="SelEmlSrvNom" optional="true" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="EmlSrv" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_PRINTER" id="PcPrn" component="select" initial-load="query" target-action="GetPrnLst" optional="true" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="Prn" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_WEB_PRINTER" id="WebPrn" component="select" initial-load="query" target-action="GetPrnLst" optional="true" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdUsrAdm" column="WebPrn" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdUsrAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="times" id="ButPnlCnl">
          <button-action type="close-cancel" target="PnlUsr" />
        </button>
        <button label="BUTTON_SAVE_CHANGES" icon="save" id="ButPnlUpd" style="btn-primary">
          <button-action type="validate" target="PnlUsrBdy" />
          <button-action type="confirm" target="UpdMsg" />
          <button-action type="server" server-action="maintain" target-action="UsrUpd" />
          <button-action type="close" target="PnlUsr" />
          <button-action type="filter" target="GrdUsrAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </button>
        <button label="BUTTON_CREATE_USER" icon="check" id="ButPnlNew" style="btn-primary">
          <button-action type="validate" target="PnlUsrBdy" />
          <button-action type="confirm" target="NewMsg" />
          <button-action type="server" server-action="control-unique-cancel" target-action="UsrChkUni" target="UniMsg" />
          <button-action type="server" server-action="maintain" target-action="UsrNew" />
          <button-action type="close" target="PnlUsr" />
          <button-action type="filter" target="GrdUsrAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </button>
      </tag>
    </side-panel>
  </tag>
  <tag source="modal">
    <include target-screen="PrnOpt" target-source="center" />
    <include target-screen="screen-help" target-source="center" />
  </tag>
</screen>
