<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : sequence-admin.xml
    Description: Sequences: list of the sequences of the application with a side panel that creates and edits them.
                 Replaces the AweKey screen, whose editable grid is saved with a multiple maintain (now AweKeyMul). It
                 reuses the queries of that screen (AweKeyLst, AweKeySug) and adds the state of each sequence, the
                 counters of the quick filters (KeyStaCnt, KeyStaCntAct, KeyStaCntIna) and the unique check of the name
                 (KeyNamUni) for the new maintains (AweKeyNew, AweKeyUpd, AweKeyDel).
                 The name of a sequence is its primary key, so the panel keeps it read-only when editing (D1): the
                 update takes the sequence of the selected row (KeyNam.selected) and writes only its value and its
                 state. The panel names the name of the sequence SeqNam, because the grid sends KeyNam with the
                 selected rows (to AweKeyDel) and a criterion named KeyNam would replace that list with one value.
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd"
        template="window" label="SCREEN_TITLE_SEQUENCE_ADMIN" help="HELP_SCREEN_TITLE_SEQUENCE_ADMIN" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW" />
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE" />
    <message id="UniMsg" title="WARNING_TITLE_DUPLICATED_SEQUENCE" message="WARNING_MESSAGE_DUPLICATED_SEQUENCE" />
    <!-- Mode of the side panel: new or edit -->
    <criteria id="PnlMod" component="hidden" value="new" />
  </tag>
  <tag source="buttons">
    <!-- Icon only: its label is its tooltip and its accessible name -->
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" style="btn-ghost no-label">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button label="BUTTON_PRINT" icon="print" id="ButPrn" help="HELP_PRINT_BUTTON">
      <button-action type="dialog" target="PrnOpt" />
    </button>
    <button label="BUTTON_NEW_SEQUENCE" icon="plus-circle" id="ButNew" style="btn-primary" help="HELP_NEW_BUTTON">
      <!-- No selected row: no KeyNam is sent (the name is typed in the panel) and the panel starts empty -->
      <button-action type="unselect-all-rows" target="GrdKeyAdm" />
      <button-action type="value" target="PnlMod" value="new" />
      <button-action type="reset" target="SeqNam" />
      <button-action type="reset" target="KeyVal" />
      <!-- A new sequence starts active, the default of the AweKey table -->
      <button-action type="value" target="Act" value="1" />
      <button-action type="dialog" target="PnlKey" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_SEQUENCE_ADMIN" icon="lucide:key-round">
      <grid id="GrdKeyAdm" style="expand" server-action="data" target-action="AweKeyLst" initial-load="query" multiselect="true" max="50">
        <!-- Search: the name of the sequence (AweKeyLst and KeyStaCnt read CrtKeyTxt) -->
        <search id="CrtKeyTxt" placeholder="SCREEN_TEXT_SEQUENCE_SEARCH" label="SCREEN_TEXT_SEQUENCE_SEARCH_LABEL" />
        <!-- Quick filters: All, Active and Inactive, counted with the search (KeyStaCnt) -->
        <quick-filter id="CrtKeySta" initial-load="query" target-action="KeyStaCnt" label="SCREEN_TEXT_SEQUENCE_FILTERS" value="" />
        <!-- The name takes the rest of the width and it is the column the grid sends: its selected rows are the
             sequences AweKeyDel deletes and its .selected value is the sequence AweKeyUpd updates -->
        <column label="PARAMETER_NAME" name="KeyNam" sort-field="KeyNam" align="left" charlength="20" width="*" />
        <column label="PARAMETER_VALUE" name="KeyVal" sort-field="KeyVal" align="center" charlength="10" sendable="false" />
        <column label="PARAMETER_STATUS" name="StaTxt" sort-field="StaCod" align="left" charlength="14" status-field="StaTon" sendable="false" />
        <!-- Read by the cells and by the side panel; not sent (their names are criteria of the panel) -->
        <column name="Act" hidden="true" sendable="false" />
        <column name="StaCod" hidden="true" sendable="false" />
        <column name="StaTon" hidden="true" sendable="false" />
        <!-- Row actions: the pencil edits the sequence of its row in the side panel and the ellipsis opens the row menu.
             A row button selects its row (only it) before its actions, so the panel is filled with that sequence -->
        <column name="EdtBtn" component="button" icon="lucide:pencil" title="BUTTON_EDIT" style="btn-ghost no-label" align="right" charlength="4" sortable="false" sendable="false">
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="dialog" target="PnlKey" />
        </column>
        <column name="MorBtn" component="button" icon="lucide:ellipsis" title="BUTTON_MORE_ACTIONS" style="btn-ghost no-label" align="left" charlength="4" sortable="false" sendable="false">
          <button-action type="show-context-menu" />
        </column>
        <!-- Row menu -->
        <context-button label="BUTTON_EDIT" icon="edit" id="CtxButUpd">
          <button-action type="check-one-selected" target="GrdKeyAdm" />
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="dialog" target="PnlKey" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdKeyAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <context-separator name="CtxSepDel" />
        <context-button label="BUTTON_DELETE" icon="trash" id="CtxButDel">
          <button-action type="check-some-selected" target="GrdKeyAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="AweKeyDel" />
          <button-action type="filter" target="GrdKeyAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdKeyAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </context-button>
        <!-- Selection actions: in the selection bar of the grid while there are selected sequences, Delete as the danger one -->
        <button label="BUTTON_DELETE" icon="trash" id="ButDel" help="HELP_DELETE_BUTTON" style="btn-danger" selection="true">
          <button-action type="check-some-selected" target="GrdKeyAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="AweKeyDel" />
          <button-action type="filter" target="GrdKeyAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdKeyAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </button>
      </grid>
    </window>

    <!-- One side panel for new and edit: the criteria ids are the parameters of AweKeyNew and AweKeyUpd. When editing
         (one selected sequence) its header shows the sequence: name and the state tag; for a new sequence (no selected
         row) it shows its label -->
    <side-panel id="PnlKey" label="SCREEN_TITLE_SEQUENCE_PANEL" icon="lucide:key-round" max-width="520px"
                header-grid="GrdKeyAdm" header-title-field="KeyNam">
      <header-tag field="StaTxt" tone-field="StaTon" />
      <tag type="div" style="panel-body" id="PnlKeyBdy">
        <!-- Identity: the name, the value and the state of the sequence -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_SEQUENCE_IDENTITY" icon="lucide:key-round" />
        <criteria label="PARAMETER_NAME" id="SeqNam" component="text" validation="{required: true, maxlength: 20}" style="col-xs-12 col-sm-7">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdKeyAdm" column="KeyNam" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdKeyAdm" event="select-row" optional="true" />
          </dependency>
          <!-- The name of a sequence is its primary key: it is typed only when the sequence is created (D1) -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </criteria>
        <!-- Active as a switch: 1 when on, 0 when off (AweKeyNew and AweKeyUpd read Act); a new sequence starts active -->
        <criteria label="PARAMETER_ACTIVE" id="Act" component="checkbox" value="1" style="col-xs-12 col-sm-5 switch">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdKeyAdm" column="Act" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdKeyAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_VALUE" id="KeyVal" component="numeric" number-format="{min: 0, precision: 0}" validation="required" style="col-xs-12 col-sm-7">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdKeyAdm" column="KeyVal" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdKeyAdm" event="select-row" optional="true" />
          </dependency>
        </criteria>
        <!-- The value is the last identifier AWE handed out for this name and the one it adds up from -->
        <criteria id="SeqValHlp" component="text-view" style="col-xs-12 text-muted">
          <dependency source-type="label" target-type="input" label="SCREEN_TEXT_SEQUENCE_VALUE_HINT" initial="true">
            <dependency-element id="PnlMod" />
          </dependency>
        </criteria>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="times" id="ButPnlCnl">
          <button-action type="close-cancel" target="PnlKey" />
        </button>
        <!-- AweKeyUpd reads KeyNam.selected, which is a single value only with one selected sequence -->
        <button label="BUTTON_SAVE_CHANGES" icon="save" id="ButPnlUpd" style="btn-primary">
          <button-action type="check-one-selected" target="GrdKeyAdm" />
          <button-action type="validate" target="PnlKeyBdy" />
          <button-action type="confirm" target="UpdMsg" />
          <button-action type="server" server-action="maintain" target-action="AweKeyUpd" />
          <button-action type="close" target="PnlKey" />
          <button-action type="filter" target="GrdKeyAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </button>
        <button label="BUTTON_CREATE_SEQUENCE" icon="check" id="ButPnlNew" style="btn-primary">
          <button-action type="validate" target="PnlKeyBdy" />
          <button-action type="confirm" target="NewMsg" />
          <button-action type="server" server-action="control-unique-cancel" target-action="KeyNamUni" target="UniMsg" />
          <button-action type="server" server-action="maintain" target-action="AweKeyNew" />
          <button-action type="close" target="PnlKey" />
          <button-action type="filter" target="GrdKeyAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </button>
      </tag>
    </side-panel>
  </tag>
  <tag source="modal">
    <include target-screen="PrnOpt" target-source="center" />
    <include target-screen="screen-help" target-source="center" />
  </tag>
</screen>
