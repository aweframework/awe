<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : profile-admin.xml
    Description: Profiles (#793): list of profiles with a side panel to create, edit and duplicate them, with their
                 permissions. Replaces the Prf, PrfNew, PrfUpd and PrfViw screens; it reuses their queries and maintains
                 (ProLst, ProNew, ProUpd, ProDel, check-profile-acronym). The grid sends IdePro (the selected rows) to
                 every maintain, so the panel has no IdePro criterion, and the grid columns named as a panel criterion
                 are not sendable. The predefined profiles (Reader, Contributor) are shown read-only: they are
                 duplicated and the copy is changed (ProUpd and ProDel refuse them too).
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_PROFILE_ADMIN" help="HELP_SCREEN_TITLE_PROFILE_ADMIN" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW" />
    <message id="UpdMsg" title="CONFIRM_TITLE_UPDATE" message="CONFIRM_MESSAGE_UPDATE" />
    <message id="UniMsg" title="WARNING_TITLE_DUPLICATED_PROFILE" message="WARNING_MESSAGE_DUPLICATED_PROFILE" />
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE" />
    <!-- Mode of the profile panel: new, edit or dup (copy of the selected profile) -->
    <criteria id="PnlMod" component="hidden" value="new" />
    <!-- 1 when the selected profile is predefined (ProPdfSel, loaded by the actions that open the panels) -->
    <criteria id="PnlPdf" component="hidden" value="0" />
    <!-- Access of the user to the permissions of the profiles: none, read or update (ProPerAcc) -->
    <criteria id="PerAcc" component="hidden" initial-load="value" target-action="ProPerAcc" />
    <!-- ProNew and ProUpd store the permissions of Per only when this flag comes (the legacy PrfNew and PrfUpd screens
         do not send it) and they changed -->
    <criteria id="PerUpd" component="hidden" value="1" />
  </tag>
  <tag source="buttons">
    <!-- Icon only: its label is its tooltip and its accessible name -->
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" style="btn-ghost no-label">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button label="BUTTON_PRINT" icon="print" id="ButPrn" help="HELP_PRINT_BUTTON">
      <button-action type="dialog" target="PrnOpt" />
    </button>
    <!-- It only opens the panel, so no target is derived from it: it declares the permission of the profile
         creation -->
    <button label="BUTTON_NEW_PROFILE" icon="plus-circle" id="ButNew" style="btn-primary" help="HELP_NEW_BUTTON" permission="profiles.create">
      <!-- No selected row: no IdePro is sent and the panel starts empty -->
      <button-action type="unselect-all-rows" target="GrdProAdm" />
      <button-action type="value" target="PnlMod" value="new" />
      <button-action type="value" target="PnlPdf" value="0" />
      <button-action type="reset" target="Acr" />
      <button-action type="reset" target="Nam" />
      <button-action type="reset" target="IdeThm" />
      <button-action type="reset" target="ScrIni" />
      <button-action type="reset" target="Res" />
      <button-action type="value" target="Act" value="1" />
      <button-action type="reset" target="Per" />
      <button-action type="dialog" target="PnlPro" />
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="SCREEN_TITLE_PROFILE_ADMIN" icon="list">
      <grid id="GrdProAdm" style="expand" server-action="data" target-action="ProLst" multiselect="true" initial-load="query" max="50">
        <!-- Search: name, acronym, theme or initial screen (ProLst and ProStaCnt read CrtProTxt) -->
        <search id="CrtProTxt" placeholder="SCREEN_TEXT_PROFILE_SEARCH" label="SCREEN_TEXT_PROFILE_SEARCH_LABEL" />
        <!-- Quick filters: All, Active and Inactive, counted with the search (ProStaCnt) -->
        <quick-filter id="CrtProSta" initial-load="query" target-action="ProStaCnt" label="SCREEN_TEXT_PROFILE_FILTERS" value="" />
        <!-- The profile takes the rest of the width: its name with the acronym and the theme below it -->
        <column label="PARAMETER_PROFILE" name="Nam" sort-field="Nam" align="left" charlength="30" width="*" secondary-field="ProSec" export-secondary="true" secondary-label="PARAMETER_ACRONYM" avatar-field="Ini" avatar-tone-field="IniTon" sendable="false" />
        <column label="PARAMETER_SCREEN" name="ScrIni" sort-field="ScrIni" align="left" charlength="20" sendable="false" />
        <column label="PARAMETER_FILE_RESTRICTION" name="Res" sort-field="Res" align="left" charlength="18" sendable="false" />
        <column label="PARAMETER_STATUS" name="StaTxt" sort-field="StaCod" align="left" charlength="14" status-field="StaTon" sendable="false" />
        <!-- Sent to the maintains: identifier of the selected profiles -->
        <column name="IdePro" hidden="true" />
        <!-- Read by the cells and by the side panel; not sent (their names are criteria of the panel) -->
        <column name="ProSec" hidden="true" sendable="false" />
        <column name="StaCod" hidden="true" sendable="false" />
        <column name="StaTon" hidden="true" sendable="false" />
        <column name="Ini" hidden="true" sendable="false" />
        <column name="IniTon" hidden="true" sendable="false" />
        <column name="Acr" hidden="true" sendable="false" />
        <column name="IdeThm" hidden="true" sendable="false" />
        <column name="Act" hidden="true" sendable="false" />
        <!-- Row actions: the pencil edits the profile of its row in the side panel and the ellipsis opens the row menu. A
             row button selects its row (only it) before its actions, so the panel is filled with that profile. Without
             profiles.update the edit openings show the panel in view mode -->
        <column name="EdtBtn" component="button" icon="lucide:pencil" title="BUTTON_EDIT" style="btn-ghost no-label" align="right" charlength="4" sortable="false" sendable="false">
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="server" server-action="value" target-action="ProPdfSel" target="PnlPdf" />
          <button-action type="dialog" target="PnlPro" edit-permission="profiles.update" />
        </column>
        <column name="MorBtn" component="button" icon="lucide:ellipsis" title="BUTTON_MORE_ACTIONS" style="btn-ghost no-label" align="left" charlength="4" sortable="false" sendable="false">
          <button-action type="show-context-menu" />
        </column>
        <!-- Row menu -->
        <context-button label="BUTTON_EDIT" icon="edit" id="CtxButUpd">
          <button-action type="check-one-selected" target="GrdProAdm" />
          <button-action type="value" target="PnlMod" value="edit" />
          <button-action type="server" server-action="value" target-action="ProPdfSel" target="PnlPdf" />
          <button-action type="dialog" target="PnlPro" edit-permission="profiles.update" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdProAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <!-- Duplicate: the profile panel opens as a copy of the selected profile, with an empty acronym and name. It
             only opens the panel, so it declares the permission of the copy (ProDup) -->
        <context-button label="BUTTON_DUPLICATE_PROFILE" icon="copy" id="CtxButDup" permission="profiles.create">
          <button-action type="check-one-selected" target="GrdProAdm" />
          <button-action type="value" target="PnlMod" value="dup" />
          <button-action type="reset" target="Acr" />
          <button-action type="reset" target="Nam" />
          <button-action type="dialog" target="PnlPro" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdProAdm" attribute="selectedRows" condition="eq" value="1" />
          </dependency>
        </context-button>
        <context-separator name="CtxSepDel" />
        <context-button label="BUTTON_DELETE" icon="trash" id="CtxButDel">
          <button-action type="check-some-selected" target="GrdProAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="ProDel" />
          <button-action type="filter" target="GrdProAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdProAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </context-button>
        <!-- Selection actions: in the selection bar of the grid while there are selected profiles, Delete as the danger one -->
        <button label="BUTTON_DELETE" icon="trash" id="ButDel" help="HELP_DELETE_BUTTON" style="btn-danger" selection="true">
          <button-action type="check-some-selected" target="GrdProAdm" />
          <button-action type="confirm" target="DelMsg" />
          <button-action type="server" server-action="maintain" target-action="ProDel" />
          <button-action type="filter" target="GrdProAdm" />
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdProAdm" attribute="selectedRows" condition="ge" value="1" />
          </dependency>
        </button>
      </grid>
    </window>

    <!-- One side panel for new, edit and duplicate: the criteria ids are the parameters of ProNew, ProUpd and ProDup.
         When editing or duplicating (one selected profile) its header shows the profile: avatar, name, acronym · theme
         and the state tag; for a new profile (no selected row) it shows its label. A predefined profile is shown
         read-only, with Duplicate instead of Save. Without profiles.update the edit openings show it in view mode -->
    <side-panel id="PnlPro" label="SCREEN_TITLE_PROFILE_PANEL" icon="group" max-width="40rem"
                header-grid="GrdProAdm" header-title-field="Nam" header-subtitle-field="ProSec"
                header-avatar-field="Ini" header-avatar-tone-field="IniTon">
      <header-tag field="StaTxt" tone-field="StaTon" />
      <tag type="div" style="panel-body" id="PnlProBdy">
        <!-- Predefined notice (edit mode, predefined profile) -->
        <criteria id="PnlPdfTxt" component="text-view" style="col-xs-12">
          <!-- Launched by PnlMod: a dependency without elements runs on every model change, its own included
               (endless loop) -->
          <dependency source-type="label" target-type="input" label="SCREEN_TEXT_PROFILE_PREDEFINED_NOTICE" initial="true">
            <dependency-element id="PnlMod" />
          </dependency>
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>
        <!-- Duplicate notice (dup mode) -->
        <criteria id="PnlDupTxt" component="text-view" style="col-xs-12">
          <dependency source-type="label" target-type="input" label="SCREEN_TEXT_PROFILE_DUPLICATE_NOTICE" initial="true">
            <dependency-element id="PnlMod" />
          </dependency>
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="dup" />
          </dependency>
        </criteria>

        <!-- Identity -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_PROFILE_IDENTITY" icon="group" />
        <!-- The acronym stays editable when editing, as in the PrfUpd screen: ProUpd stores it and the profile keeps its
             identifier, users and restrictions -->
        <criteria label="PARAMETER_ACRONYM" id="Acr" component="text" validation="{required: true, maxlength: 3}" style="col-xs-12 col-sm-4">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdProAdm" column="Acr" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdProAdm" event="select-row" optional="true" />
          </dependency>
          <!-- A predefined profile is read-only: it is duplicated -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_NAME" id="Nam" component="text" validation="{required: true, maxlength: 120}" style="col-xs-12 col-sm-8">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdProAdm" column="Nam" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdProAdm" event="select-row" optional="true" />
          </dependency>
          <!-- A predefined profile is read-only: it is duplicated -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>

        <!-- Defaults and access of the users of the profile -->
        <tag type="h3" style="col-xs-12 awe-form-section-title" label="SCREEN_TEXT_PROFILE_DEFAULTS" icon="lucide:sliders-horizontal" />
        <criteria label="PARAMETER_THEME" id="IdeThm" component="suggest" server-action="data" target-action="ThmSug" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdProAdm" column="IdeThm" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdProAdm" event="select-row" optional="true" />
          </dependency>
          <!-- A predefined profile is read-only: it is duplicated -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_SCREEN" id="ScrIni" component="suggest" server-action="data" target-action="getScreenList" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdProAdm" column="ScrIni" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdProAdm" event="select-row" optional="true" />
          </dependency>
          <!-- A predefined profile is read-only: it is duplicated -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>
        <criteria label="PARAMETER_FILE_RESTRICTION" id="Res" component="select" initial-load="query" target-action="ProNamLst" optional="true" style="col-xs-12 col-sm-6">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdProAdm" column="Res" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdProAdm" event="select-row" optional="true" />
          </dependency>
          <!-- A predefined profile is read-only: it is duplicated -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>
        <!-- Active as a switch: 1 when on, 0 when off (ProNew and ProUpd read Act); a new profile starts active -->
        <criteria label="PARAMETER_ACTIVE" id="Act" component="checkbox" value="1" style="col-xs-12 col-sm-6 switch">
          <dependency source-type="launcher" target-type="input" target-action="value">
            <dependency-element id="GrdProAdm" column="Act" attribute="selectedRowValue" alias="value" optional="true" />
            <dependency-element id="GrdProAdm" event="select-row" optional="true" />
          </dependency>
          <!-- A predefined profile is read-only: it is duplicated -->
          <dependency target-type="set-readonly" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>

        <!-- Permissions of the profile (AweProPer), in the language of the user: the options are the permission catalog
             of the application (AWE, its modules and the application itself), grouped by resource, with "all" options
             for every permission of a resource (users.*), one verb on every resource (*.read) and everything (*).
             Shown only to the users that can read the permissions (PerAcc), so nothing is launched for the others;
             read-only without permissions.update and for a predefined profile, and hidden when duplicating: the copy
             gets the effective permissions of the selected profile. It has no section title of its own, so nothing is
             left on the panel when it is hidden -->
        <criteria label="PARAMETER_PERMISSIONS" id="Per" component="select-multiple" optional="true" help="HELP_PROFILE_PERMISSIONS" style="col-xs-12">
          <!-- Options, once -->
          <dependency initial="true">
            <dependency-element id="PerAcc" condition="ne" value="none" />
            <dependency-action type="server" server-action="data" target-action="ProPerCat" target="Per" />
          </dependency>
          <!-- Values: the assignments of the selected profile -->
          <dependency source-type="query" target-type="input" server-action="value" target-action="ProPerSel">
            <dependency-element id="GrdProAdm" column="IdePro" attribute="selectedRowValue" alias="IdeProSel" optional="true" />
            <dependency-element id="GrdProAdm" event="select-row" optional="true" />
            <dependency-element id="PerAcc" condition="ne" value="none" />
          </dependency>
          <dependency target-type="show" initial="true">
            <dependency-element id="PerAcc" condition="ne" value="none" />
            <dependency-element id="PnlMod" condition="ne" value="dup" />
          </dependency>
          <dependency target-type="set-readonly" initial="true" type="or">
            <dependency-element id="PerAcc" condition="ne" value="update" />
            <dependency-element id="PnlPdf" condition="eq" value="1" />
          </dependency>
        </criteria>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="times" id="ButPnlCnl">
          <button-action type="close-cancel" target="PnlPro" />
        </button>
        <!-- Duplicate (edit mode): the panel becomes a copy of the profile, with an empty acronym and name -->
        <button label="BUTTON_DUPLICATE_PROFILE" icon="copy" id="ButPnlDup" permission="profiles.create">
          <button-action type="value" target="PnlMod" value="dup" />
          <button-action type="reset" target="Acr" />
          <button-action type="reset" target="Nam" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
          </dependency>
        </button>
        <button label="BUTTON_SAVE_CHANGES" icon="save" id="ButPnlUpd" style="btn-primary">
          <button-action type="validate" target="PnlProBdy" />
          <button-action type="confirm" target="UpdMsg" />
          <button-action type="server" server-action="maintain" target-action="ProUpd" />
          <button-action type="close" target="PnlPro" />
          <button-action type="filter" target="GrdProAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="edit" />
            <dependency-element id="PnlPdf" condition="ne" value="1" />
          </dependency>
        </button>
        <button label="BUTTON_CREATE_COPY" icon="check" id="ButPnlDupNew" style="btn-primary">
          <button-action type="validate" target="PnlProBdy" />
          <button-action type="confirm" target="NewMsg" />
          <button-action type="server" server-action="control-unique-cancel" target-action="check-profile-acronym" target="UniMsg" />
          <button-action type="server" server-action="maintain" target-action="ProDup" />
          <button-action type="close" target="PnlPro" />
          <button-action type="filter" target="GrdProAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="dup" />
          </dependency>
        </button>
        <button label="BUTTON_CREATE_PROFILE" icon="check" id="ButPnlNew" style="btn-primary">
          <button-action type="validate" target="PnlProBdy" />
          <button-action type="confirm" target="NewMsg" />
          <button-action type="server" server-action="control-unique-cancel" target-action="check-profile-acronym" target="UniMsg" />
          <button-action type="server" server-action="maintain" target-action="ProNew" />
          <button-action type="close" target="PnlPro" />
          <button-action type="filter" target="GrdProAdm" />
          <dependency target-type="show" initial="true">
            <dependency-element id="PnlMod" condition="eq" value="new" />
          </dependency>
        </button>
      </tag>
    </side-panel>
  </tag>
  <tag source="modal">
    <include target-screen="PrnOpt" target-source="center" />
    <include target-screen="screen-help" target-source="center" />
  </tag>
</screen>
