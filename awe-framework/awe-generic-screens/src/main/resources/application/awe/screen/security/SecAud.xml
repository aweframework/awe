<?xml version="1.0" encoding="UTF-8"?>

<!--
    Document   : SecAud.xml
    Description: Security audit - Browse the recorded security events (logins, logouts, locks, password and
                 second factor changes, denied accesses and REST tokens)
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="SCREEN_TITLE_SECURITY_AUDIT" help="HELP_SCREEN_TITLE_SECURITY_AUDIT" keep-criteria="true">
  <tag source="buttons">
    <button label="BUTTON_SCREEN_HELP" icon="question-circle" id="ButHlp" help="HELP_HELP_BUTTON">
      <button-action type="dialog" target="HlpOpt" />
    </button>
    <button label="BUTTON_PRINT" icon="print" id="ButPrn" help="HELP_PRINT_BUTTON">
      <button-action type="validate" />
      <button-action type="dialog" target="PrnOpt" />
    </button>
    <button label="BUTTON_RELOAD" icon="refresh" id="ButRel">
      <button-action type="validate" />
      <button-action type="filter" target="GrdSecAud" />
      <button-action type="server" server-action="data" target-action="SecAudActChr" target="ChrSecAudAct" async="true" silent="true" />
      <button-action type="server" server-action="data" target-action="SecAudCauChr" target="ChrSecAudCau" async="true" silent="true" />
    </button>
    <button label="BUTTON_VIEW" icon="eye" id="ButViw" help="HELP_VIEW_BUTTON">
      <button-action type="check-one-selected" target="GrdSecAud" />
      <button-action type="screen" target="view-security-audit-event" />
      <dependency target-type="disable" initial="true">
        <dependency-element id="GrdSecAud" condition="ne" value="1" />
      </dependency>
    </button>
  </tag>
  <tag source="center">
    <window label="SCREEN_TEXT_CRITERIA" icon="filter">
      <tag type="div" style="panel-body">
        <criteria label="PARAMETER_FROM" component="date" id="CrtFro" initial-load="value" target-action="SecAudDefFro" style="col-xs-6 col-sm-3 col-lg-2" />
        <criteria label="PARAMETER_TO" component="date" id="CrtTo" validation="{ge:{criterion:'CrtFro',type:'date'}}" style="col-xs-6 col-sm-3 col-lg-2" />
        <criteria label="PARAMETER_SECURITY_AUDIT_EVENT" component="select-multiple" id="CrtTyp" initial-load="enum" target-action="SecAudEvtTyp" style="col-xs-12 col-sm-6 col-lg-2" />
        <criteria label="PARAMETER_SECURITY_AUDIT_OUTCOME" component="select" id="CrtRes" optional="true" initial-load="enum" target-action="SecAudRes" style="col-xs-6 col-sm-3 col-lg-1" />
        <criteria label="PARAMETER_SECURITY_AUDIT_CHANNEL" component="select" id="CrtChn" optional="true" initial-load="enum" target-action="SecAudChn" style="col-xs-6 col-sm-3 col-lg-1" />
        <criteria label="PARAMETER_USER" component="suggest" id="CrtUsr" server-action="data" target-action="UsrNamSug" strict="false" style="col-xs-6 col-sm-3 col-lg-2" />
        <criteria label="PARAMETER_SECURITY_AUDIT_IP" component="text" id="CrtIp" style="col-xs-6 col-sm-3 col-lg-2" />
      </tag>
      <tag type="div" style="panel-footer">
        <tag type="div" style="pull-right">
          <button button-type="reset" label="BUTTON_RESET" icon="eraser" id="ButRst" help="HELP_RESET_BUTTON" />
          <button button-type="submit" label="BUTTON_SEARCH" icon="search" id="ButSch" help="HELP_SEARCH_BUTTON">
            <button-action type="validate" />
            <button-action type="filter" target="GrdSecAud" />
            <button-action type="server" server-action="data" target-action="SecAudActChr" target="ChrSecAudAct" async="true" silent="true" />
            <button-action type="server" server-action="data" target-action="SecAudCauChr" target="ChrSecAudCau" async="true" silent="true" />
          </button>
        </tag>
      </tag>
    </window>
    <tag type="div" style="expand" expandible="horizontal">
      <window label="SCREEN_TEXT_SECURITY_AUDIT_EVENTS" icon="list" maximize="true" style="expand-2x">
        <grid id="GrdSecAud" style="expand" server-action="data" target-action="SecAudEvtLst" initial-load="query" max="50" pager-values="25, 50, 100, 200">
          <column label="PARAMETER_DATE" name="EvtDat" sort-field="EvtDat" align="center" charlength="17" />
          <column label="" component="icon" name="TypIco" sort-field="EvtTyp" align="center" charlength="3" />
          <column label="PARAMETER_SECURITY_AUDIT_EVENT" name="TypTxt" sort-field="EvtTyp" align="left" charlength="22" />
          <column label="PARAMETER_SECURITY_AUDIT_OUTCOME" component="icon" name="ResIco" sort-field="EvtRes" align="center" charlength="8" />
          <column label="PARAMETER_USER" name="UsrNam" sort-field="UsrNam" align="left" charlength="16" />
          <column label="PARAMETER_SECURITY_AUDIT_CAUSE" name="CauTxt" sort-field="EvtCau" align="left" charlength="22" />
          <column label="PARAMETER_SECURITY_AUDIT_CHANNEL" name="ChnTxt" sort-field="Chn" align="center" charlength="9" />
          <column label="PARAMETER_SECURITY_AUDIT_IP" name="IpAdr" sort-field="IpAdr" align="left" charlength="15" />
          <column label="PARAMETER_SECURITY_AUDIT_DETAIL" name="Det" sort-field="Det" align="left" charlength="30" />
          <column name="IdeSecAud" hidden="true" />
          <column name="EvtTyp" hidden="true" />
          <column name="EvtRes" hidden="true" />
          <column name="EvtCau" hidden="true" />
          <column name="Chn" hidden="true" />
          <column name="Ten" hidden="true" />
          <column name="UsrAgt" hidden="true" />
          <column name="SesHsh" hidden="true" />
          <column name="CorIde" hidden="true" />
        </grid>
      </window>
      <window label="SCREEN_TEXT_SECURITY_AUDIT_CHARTS" icon="bar-chart" maximize="true" style="expand">
        <tag type="div" style="expand" expandible="vertical">
          <chart id="ChrSecAudAct" label="SCREEN_TEXT_SECURITY_AUDIT_ACTIVITY" style="expand" type="column" stacking="normal" initial-load="query" target-action="SecAudActChr" max="400" zoom-type="xAxis">
            <chart-legend align="center" verticalAlign="bottom" />
            <x-axis type="datetime" />
            <y-axis label="SCREEN_TEXT_SECURITY_AUDIT_EVENTS" />
            <chart-tooltip shared="true" date-format="%Y-%m-%d" />
            <chart-serie id="SecAudOk" x-value="dates" y-value="success" type="column" label="ENUM_SECURITY_AUDIT_SUCCESS" color="#4caf50" />
            <chart-serie id="SecAudKo" x-value="dates" y-value="failure" type="column" label="ENUM_SECURITY_AUDIT_FAILURE" color="#e53935" />
          </chart>
          <chart id="ChrSecAudCau" label="SCREEN_TEXT_SECURITY_AUDIT_FAILURES" style="expand" type="pie" initial-load="query" target-action="SecAudCauChr" max="30" enable-data-labels="true"
                 format-data-labels="{point.name}: {point.y}">
            <chart-legend enabled="false" />
            <chart-serie id="SecAudCau" x-value="names" y-value="serie1" label="ENUM_SECURITY_AUDIT_FAILURE" />
          </chart>
        </tag>
      </window>
    </tag>
  </tag>
  <tag source="modal">
    <include target-screen="PrnOpt" target-source="center" />
    <include target-screen="screen-help" target-source="center"/>
  </tag>
</screen>
