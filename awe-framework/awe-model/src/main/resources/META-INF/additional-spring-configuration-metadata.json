{
  "properties": [
    {
      "name": "awe.application.language-list",
      "defaultValue": ["en-GB", "es-ES", "fr-FR"]
    },
    {
      "name": "awe.application.paths.tag-angular",
      "defaultValue": "tags/angular/"
    },
    {
      "name": "awe.application.paths.icon-favicon",
      "defaultValue": "images/icon/favicon-awe.ico"
    },
    {
      "name": "awe.application.paths.icon-phone",
      "defaultValue": "images/icon/favicon-awe.ico"
    },
    {
      "name": "awe.application.paths.icon-tablet",
      "defaultValue": "images/icon/favicon-awe.ico"
    },
    {
      "name": "awe.application.paths.image-startup-logo",
      "defaultValue": "../images/logo/logo-awe-nuevo.svg"
    },
    {
      "name": "awe.application.paths.image-navbar-logo",
      "defaultValue": "../images/logo/awe-logo-mark.svg"
    },
    {
      "name": "awe.application.paths.image-splash-logo",
      "type": "java.lang.String",
      "description": "Logo of the splash shown while the page loads, which fills up with its own colours; an SVG or image with transparency (URL relative to the application root). Not set: the built-in AWE mark."
    },
    {
      "name": "awe.application.paths.image-startup-background",
      "defaultValue": "../images/background/signin-bg-1.jpg"
    },
    {
      "name": "awe.numeric.min-value",
      "defaultValue": -9999999999.99
    },
    {
      "name": "awe.numeric.separator-thousand",
      "defaultValue": "."
    },
    {
      "name": "awe.numeric.separator-decimal",
      "defaultValue": ","
    },
    {
      "name": "awe.numeric.currency-sign",
      "defaultValue": ""
    }
  ]
}
