# https://editorconfig.org
# Mirrors the current style of the repository. The Spotless check (see CONTRIBUTING.md) enforces the Java part
# for the files a merge request changes: trailing whitespace, final newline and imports.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml,json,yml,yaml,js,jsx,css,html}]
indent_style = space
indent_size = 2

# A trailing double space is a line break in Markdown
[*.md]
trim_trailing_whitespace = false
