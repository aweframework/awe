# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
# XSD reference pages, generated by scripts/xsd-reference/generate.js before every start/build
/reference
.cache-loader

# npm download cache used by the .gitlab-ci.yml website-npm-* cache key
/.npm

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Maintenance-line docs injected at build time by bin/website-maintenance-docs.sh:
# a live versioned snapshot of a support/*.x branch (e.g. "4.x"), regenerated on every
# website build and never committed.
/versioned_docs/version-*.x/
/versioned_sidebars/version-*.x-sidebars.json

# Backups of develop's docs/sidebars.js while bin/website-maintenance-docs.sh has the
# maintenance branch's docs swapped in; always removed again by that script's own cleanup.
/.docs-current/
/.sidebars-current.js

# versions.json is only ever modified inside a CI checkout, by bin/website-maintenance-docs.sh,
# to temporarily prepend a maintenance-line label (e.g. "4.x"). It must never be committed
# with such an entry present.

# Properties reference, generated from the Spring configuration metadata by scripts/properties-reference/generate.js before every start/build
/docs/properties.md
