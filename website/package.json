{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predocusaurus": "npm run generate:reference",
    "docusaurus": "docusaurus",
    "generate:reference": "node scripts/xsd-reference/generate.js && node scripts/properties-reference/generate.js",
    "refresh:properties": "node scripts/properties-reference/generate.js --refresh",
    "test:reference": "node --test \"scripts/xsd-reference/__tests__/*.test.js\"",
    "test:scripts": "node --test \"scripts/xsd-reference/__tests__/*.test.js\" \"scripts/properties-reference/__tests__/*.test.js\" \"scripts/*.test.js\"",
    "prestart": "npm run generate:reference",
    "start": "docusaurus start",
    "prebuild": "npm run generate:reference",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "prewrite-translations": "npm run generate:reference",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.8.1",
    "@docusaurus/plugin-content-docs": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@docusaurus/theme-mermaid": "3.8.1",
    "@docusaurus/utils": "3.8.1",
    "@docusaurus/utils-common": "3.8.1",
    "@xmldom/xmldom": "0.9.12",
    "clsx": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.8.1",
    "webpack": "5.104.1",
    "webpackbar": "6.0.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
