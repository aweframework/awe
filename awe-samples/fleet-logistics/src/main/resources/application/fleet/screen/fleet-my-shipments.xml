<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : fleet-my-shipments.xml
    Description: Shipments of the customer with their timeline in the detail of each row (only their own: the queries filter by the connected user)
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="FLT_MENU_MY_SHIPMENTS" keep-criteria="true">
  <tag source="buttons">
    <button button-type="submit" label="BUTTON_SEARCH" icon="lucide:search" id="ButSch" style="btn-primary">
      <button-action type="filter" target="GrdMyShp"/>
    </button>
  </tag>
  <tag source="center" expandible="vertical">
    <tag type="div" style="awe-card-grid m-2">
      <card id="CrdMyOpen" title="FLT_MY_OPEN" icon="lucide:package" icon-tone="info" initial-load="query" target-action="FltMyOpen" number-decimals="0"/>
      <card id="CrdMyDly" title="FLT_MY_DELAYED" icon="lucide:triangle-alert" icon-tone="danger" good-trend="down" initial-load="query" target-action="FltMyDelayed" number-decimals="0"/>
      <card id="CrdMyDel" title="FLT_MY_DELIVERED" icon="lucide:package-check" icon-tone="success" initial-load="query" target-action="FltMyDelivered" number-decimals="0"/>
      <card id="CrdMyDue" title="FLT_MY_DUE" icon="lucide:receipt" icon-tone="warning" unit="EUR" good-trend="down" initial-load="query" target-action="FltMyDue" number-decimals="2"/>
    </tag>
    <tag type="div" style="flt-tall" expandible="horizontal">
      <window style="expand" label="FLT_MENU_MY_SHIPMENTS" icon="lucide:package">
        <tag type="div" style="panel-body flt-command">
          <criteria label="FLT_COL_STATUS" id="CrtMyShpSta" component="select" initial-load="enum" target-action="FltShipmentStatus" optional="true" style="col-xs-12 col-sm-6 col-lg-3"/>
        </tag>
        <grid id="GrdMyShp" style="expand" initial-load="query" server-action="data" target-action="FltMyShpLst" max="15">
          <column label="FLT_COL_TRACKING" name="Cod" sort-field="Cod" align="left" charlength="14" secondary-field="DstCit" sendable="false"/>
          <column label="FLT_COL_DESTINATION" name="DstTxt" sort-field="DstTxt" align="left" charlength="11" sendable="false"/>
          <column label="FLT_COL_STATUS" name="StaTxt" sort-field="StaTxt" align="left" charlength="16" status-field="Ton" sendable="false"/>
          <column label="FLT_COL_WEIGHT" name="Wgt" sort-field="Wgt" align="right" charlength="11" sendable="false"/>
          <column label="FLT_COL_CREATED" name="CreDat" sort-field="CreDat" align="center" charlength="11" sendable="false"/>
          <column label="FLT_COL_ETA" name="Eta" sort-field="Eta" align="center" charlength="17" sendable="false"/>
          <column name="IdeShp" hidden="true" sendable="false"/>
          <column name="Ton" hidden="true" sendable="false"/>
          <column name="DstCit" hidden="true" sendable="false"/>
          <row-detail style="row-detail-card">
            <grid id="GrdMyEvt" server-action="data" target-action="FltMyEvtLst" max="10">
              <column label="FLT_TRACK_WHEN" name="EvtTim" align="left" charlength="20" sendable="false"/>
              <column label="FLT_COL_STATUS" name="EvtSta" align="left" charlength="18" sendable="false"/>
              <column label="FLT_TRACK_WHERE" name="EvtLoc" align="left" charlength="28" width="*" sendable="false"/>
            </grid>
          </row-detail>
        </grid>
      </window>
    </tag>
  </tag>
</screen>
