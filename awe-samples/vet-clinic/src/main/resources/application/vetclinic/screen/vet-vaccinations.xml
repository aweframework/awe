<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : vet-vaccinations.xml
    Description: Vaccination tracking: the status (overdue, due soon, up to date) is computed by the read model and drawn as a status tone
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="VET_MENU_VACCINATIONS" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW"/>
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE"/>
    <criteria id="PnlMod" component="hidden" value="new"/>
  </tag>
  <tag source="buttons">
    <button button-type="submit" label="BUTTON_SEARCH" icon="lucide:search" id="ButSch" style="btn-primary">
      <button-action type="filter" target="GrdVac"/>
    </button>
    <button label="VET_BTN_NEW_VACCINATION" icon="lucide:syringe" id="ButNewVac" style="btn-primary" permission="vaccinations.create">
      <button-action type="reset" target="IdePet"/>
      <button-action type="reset" target="Vcc"/>
      <button-action type="reset" target="IdeVet"/>
      <button-action type="reset" target="VacDat"/>
      <button-action type="reset" target="NxtDat"/>
      <button-action type="dialog" target="PnlVac"/>
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="VET_MENU_VACCINATIONS" icon="lucide:syringe">
      <tag type="div" style="panel-body vet-chips">
        <criteria label="VET_COL_STATUS" id="CrtVacSta" component="select" initial-load="enum" target-action="VetVacStatus" optional="true" style="col-xs-12 col-sm-6 col-lg-3"/>
        <criteria label="VET_COL_VACCINE" id="CrtVacVcc" component="select" initial-load="enum" target-action="VetVaccine" optional="true" style="col-xs-12 col-sm-6 col-lg-3"/>
        <criteria label="VET_SEARCH_VISITS_LABEL" id="CrtVacSch" component="text" icon="lucide:search" style="col-xs-12 col-lg-4" placeholder="VET_SEARCH_APT_PH"/>
      </tag>
      <grid id="GrdVac" style="expand" initial-load="query" server-action="data" target-action="VetVacLst" max="15">
        <column label="VET_COL_PET" name="PetNam" sort-field="PetNam" align="left" charlength="18" width="*" secondary-field="OwnNam" sendable="false"/>
        <column label="VET_COL_VACCINE" name="VccTxt" sort-field="Vcc" align="left" charlength="18" sendable="false"/>
        <column label="VET_COL_APPLIED" name="VacDat" sort-field="VacDat" align="center" charlength="13" sendable="false"/>
        <column label="VET_COL_NEXT_DOSE" name="NxtDat" sort-field="NxtDat" align="center" charlength="13" sendable="false"/>
        <column label="VET_COL_STATUS" name="StaTxt" sort-field="Sta" align="left" charlength="13" status-field="Ton" sendable="false"/>
        <column name="IdeVac" hidden="true"/>
        <column name="Ton" hidden="true" sendable="false"/>
        <column name="Sta" hidden="true" sendable="false"/>
        <column name="OwnNam" hidden="true" sendable="false"/>
        <column name="Vcc" hidden="true" sendable="false"/>
        <column name="IdePet" hidden="true" sendable="false"/>
        <button label="VET_BTN_DELETE" icon="lucide:trash" id="ButDel" selection="true" style="btn-danger">
          <button-action type="check-some-selected" target="GrdVac"/>
          <button-action type="confirm" target="DelMsg"/>
          <button-action type="server" server-action="maintain" target-action="VetVacDel"/>
          <button-action type="filter" target="GrdVac"/>
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdVac" attribute="selectedRows" condition="ge" value="1"/>
          </dependency>
        </button>
      </grid>
    </window>
    <side-panel id="PnlVac" label="VET_VAC_PANEL" icon="lucide:syringe" max-width="36rem">
      <tag type="div" style="panel-body" id="PnlVacBdy">
        <criteria label="VET_COL_PET" id="IdePet" component="suggest" style="col-xs-12" validation="required" server-action="data" target-action="VetPetSug" check-target="VetPetIni"/>
        <criteria label="VET_COL_VACCINE" id="Vcc" component="select" style="col-xs-12 col-sm-6" validation="required" initial-load="enum" target-action="VetVaccine"/>
        <criteria label="VET_COL_VET" id="IdeVet" component="select" style="col-xs-12 col-sm-6" validation="required" initial-load="query" target-action="VetVetSel"/>
        <criteria label="VET_COL_APPLIED" id="VacDat" component="date" style="col-xs-12 col-sm-6" validation="required" show-future-dates="false"/>
        <criteria label="VET_COL_NEXT_DOSE" id="NxtDat" component="date" style="col-xs-12 col-sm-6" validation="{required:true, gt:{criterion:'VacDat', type:'date'}}"/>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="lucide:x" id="ButPnlVacCnl">
          <button-action type="close-cancel" target="PnlVac"/>
        </button>
        <button label="BUTTON_SAVE_CHANGES" icon="lucide:check" id="ButPnlVacSav" style="btn-primary">
          <button-action type="validate" target="PnlVacBdy"/>
          <button-action type="confirm" target="NewMsg"/>
          <button-action type="server" server-action="maintain" target-action="VetVacNew"/>
          <button-action type="close" target="PnlVac"/>
          <button-action type="filter" target="GrdVac"/>
        </button>
      </tag>
    </side-panel>
  </tag>
</screen>
