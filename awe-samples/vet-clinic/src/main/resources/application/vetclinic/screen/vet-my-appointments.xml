<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : vet-my-appointments.xml
    Description: Appointments of the pet owner: request a new one (the pet and the owner are checked on the server) and cancel an open one
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="VET_MENU_MY_APPOINTMENTS" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW"/>
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE"/>
  </tag>
  <tag source="buttons">
    <button button-type="submit" label="BUTTON_SEARCH" icon="lucide:search" id="ButSch" style="btn-primary">
      <button-action type="filter" target="GrdMyApt"/>
    </button>
    <button label="VET_BTN_REQUEST_APT" icon="lucide:calendar-plus" id="ButNewMyApt" style="btn-primary" permission="portal.create">
      <button-action type="reset" target="IdePet"/>
      <button-action type="reset" target="Rea"/>
      <button-action type="reset" target="AptDat"/>
      <button-action type="reset" target="AptTim"/>
      <button-action type="reset" target="Nte"/>
      <button-action type="dialog" target="PnlMyApt"/>
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="VET_MENU_MY_APPOINTMENTS" icon="lucide:calendar-days">
      <tag type="div" style="panel-body vet-chips">
        <criteria label="VET_COL_STATUS" id="CrtMyAptSta" component="select" initial-load="enum" target-action="VetAptStatus" optional="true" style="col-xs-12 col-sm-6 col-lg-3"/>
      </tag>
      <grid id="GrdMyApt" style="expand" initial-load="query" server-action="data" target-action="VetMyAptLst" max="12">
        <column label="VET_COL_DATE" name="AptDat" sort-field="AptDat" align="center" charlength="12" sendable="false"/>
        <column label="VET_COL_TIME" name="AptTim" sort-field="AptTim" align="center" charlength="8" sendable="false"/>
        <column label="VET_COL_PET" name="PetNam" sort-field="PetNam" align="left" charlength="16" sendable="false"/>
        <column label="VET_COL_REASON" name="ReaTxt" sort-field="ReaTxt" align="left" charlength="16" sendable="false"/>
        <column label="VET_COL_VET" name="VetNam" sort-field="VetNam" align="left" charlength="18" sendable="false"/>
        <column label="VET_COL_STATUS" name="StaTxt" sort-field="StaTxt" align="left" charlength="13" status-field="Ton" sendable="false"/>
        <column label="VET_FLD_NOTES" name="Nte" sort-field="Nte" align="left" charlength="26" width="*" sendable="false"/>
        <column name="IdeApt" hidden="true"/>
        <column name="Ton" hidden="true" sendable="false"/>
        <column name="Sta" hidden="true" sendable="false"/>
        <button label="VET_BTN_CANCEL_MY_APT" icon="lucide:calendar-x" id="ButMyCan" selection="true" style="btn-danger">
          <button-action type="check-some-selected" target="GrdMyApt"/>
          <button-action type="confirm" target="DelMsg"/>
          <button-action type="server" server-action="maintain" target-action="VetMyAptCan"/>
          <button-action type="filter" target="GrdMyApt"/>
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdMyApt" attribute="selectedRows" condition="ge" value="1"/>
          </dependency>
        </button>
      </grid>
    </window>
    <side-panel id="PnlMyApt" label="VET_MY_APT_PANEL" icon="lucide:calendar-plus" max-width="36rem">
      <tag type="div" style="panel-body" id="PnlMyAptBdy">
        <criteria label="VET_COL_PET" id="IdePet" component="select" style="col-xs-12" validation="required" initial-load="query" target-action="VetMyPetSel"/>
        <criteria label="VET_COL_REASON" id="Rea" component="select" style="col-xs-12" validation="required" initial-load="enum" target-action="VetVisitType"/>
        <criteria label="VET_FLD_PREFERRED_DATE" id="AptDat" component="date" style="col-xs-12 col-sm-6" validation="required"/>
        <criteria label="VET_FLD_PREFERRED_TIME" id="AptTim" component="time" style="col-xs-12 col-sm-6" validation="required"/>
        <criteria label="VET_FLD_NOTES" id="Nte" component="textarea" style="col-xs-12" validation="{maxlength:400}" area-rows="3"/>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="lucide:x" id="ButPnlMyAptCnl">
          <button-action type="close-cancel" target="PnlMyApt"/>
        </button>
        <button label="BUTTON_SAVE_CHANGES" icon="lucide:check" id="ButPnlMyAptSav" style="btn-primary">
          <button-action type="validate" target="PnlMyAptBdy"/>
          <button-action type="confirm" target="NewMsg"/>
          <button-action type="server" server-action="maintain" target-action="VetMyAptNew"/>
          <button-action type="close" target="PnlMyApt"/>
          <button-action type="filter" target="GrdMyApt"/>
        </button>
      </tag>
    </side-panel>
  </tag>
</screen>
