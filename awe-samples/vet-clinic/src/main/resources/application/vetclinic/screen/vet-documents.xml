<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : vet-documents.xml
    Description: Documents of the pets (x-rays, lab results, reports): the uploader criterion stores the file and the maintain stores its name
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="VET_MENU_DOCUMENTS" keep-criteria="true">
  <tag source="hidden">
    <message id="NewMsg" title="CONFIRM_TITLE_NEW" message="CONFIRM_MESSAGE_NEW"/>
    <message id="DelMsg" title="CONFIRM_TITLE_DELETE" message="CONFIRM_MESSAGE_DELETE"/>
    <criteria id="PnlMod" component="hidden" value="new"/>
  </tag>
  <tag source="buttons">
    <button button-type="submit" label="BUTTON_SEARCH" icon="lucide:search" id="ButSch" style="btn-primary">
      <button-action type="filter" target="GrdDoc"/>
    </button>
    <button label="VET_BTN_UPLOAD" icon="lucide:file-up" id="ButNewDoc" style="btn-primary" permission="documents.create">
      <button-action type="reset" target="IdePet"/>
      <button-action type="reset" target="Typ"/>
      <button-action type="reset" target="Des"/>
      <button-action type="reset" target="DocFil"/>
      <button-action type="dialog" target="PnlDoc"/>
    </button>
  </tag>
  <tag source="center">
    <window style="expand" label="VET_MENU_DOCUMENTS" icon="lucide:folder-open">
      <tag type="div" style="panel-body vet-chips">
        <criteria label="VET_COL_TYPE" id="CrtDocTyp" component="select" initial-load="enum" target-action="VetDocType" optional="true" style="col-xs-12 col-sm-6 col-lg-3"/>
        <criteria label="VET_SEARCH_VISITS_LABEL" id="CrtDocSch" component="text" icon="lucide:search" style="col-xs-12 col-lg-4" placeholder="VET_SEARCH_DOC_PH"/>
      </tag>
      <grid id="GrdDoc" style="expand" initial-load="query" server-action="data" target-action="VetDocLst" max="15">
        <column label="VET_COL_PET" name="PetNam" sort-field="PetNam" align="left" charlength="16" sendable="false"/>
        <column label="VET_COL_DATE" name="DocDat" sort-field="DocDat" align="center" charlength="12" sendable="false"/>
        <column label="VET_COL_TYPE" name="TypTxt" sort-field="Typ" align="left" charlength="14" sendable="false"/>
        <column label="VET_COL_DESCRIPTION" name="Des" sort-field="Des" align="left" charlength="30" width="*" sendable="false"/>
        <column label="VET_COL_FILE" name="FilNam" sort-field="FilNam" align="left" charlength="30" sendable="false"/>
        <column name="IdeDoc" hidden="true"/>
        <column name="Typ" hidden="true" sendable="false"/>
        <column name="IdePet" hidden="true" sendable="false"/>
        <button label="VET_BTN_DELETE" icon="lucide:trash" id="ButDel" selection="true" style="btn-danger">
          <button-action type="check-some-selected" target="GrdDoc"/>
          <button-action type="confirm" target="DelMsg"/>
          <button-action type="server" server-action="maintain" target-action="VetDocDel"/>
          <button-action type="filter" target="GrdDoc"/>
          <dependency target-type="enable" initial="true">
            <dependency-element id="GrdDoc" attribute="selectedRows" condition="ge" value="1"/>
          </dependency>
        </button>
      </grid>
    </window>
    <side-panel id="PnlDoc" label="VET_DOC_PANEL" icon="lucide:file-up" max-width="36rem">
      <tag type="div" style="panel-body" id="PnlDocBdy">
        <criteria label="VET_COL_PET" id="IdePet" component="suggest" style="col-xs-12" validation="required" server-action="data" target-action="VetPetSug" check-target="VetPetIni"/>
        <criteria label="VET_COL_TYPE" id="Typ" component="select" style="col-xs-12 col-sm-6" validation="required" initial-load="enum" target-action="VetDocType"/>
        <criteria label="VET_COL_DESCRIPTION" id="Des" component="text" style="col-xs-12 col-sm-6" validation="{required:true, maxlength:120}"/>
        <criteria label="VET_FLD_FILE" id="DocFil" component="uploader" style="col-xs-12" validation="required" destination="vet-documents" drop-zone="true"/>
      </tag>
      <tag type="div" style="modal-footer">
        <button label="BUTTON_CANCEL" icon="lucide:x" id="ButPnlDocCnl">
          <button-action type="close-cancel" target="PnlDoc"/>
        </button>
        <button label="BUTTON_SAVE_CHANGES" icon="lucide:check" id="ButPnlDocSav" style="btn-primary">
          <button-action type="validate" target="PnlDocBdy"/>
          <button-action type="confirm" target="NewMsg"/>
          <button-action type="server" server-action="maintain" target-action="VetDocNew"/>
          <button-action type="close" target="PnlDoc"/>
          <button-action type="filter" target="GrdDoc"/>
        </button>
      </tag>
    </side-panel>
  </tag>
</screen>
