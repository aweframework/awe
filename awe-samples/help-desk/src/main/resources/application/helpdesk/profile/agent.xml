<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : agent.xml
    Description: Support agent: works the tickets, writes replies and notes, reads the knowledge base. No reassignment, no critical priority, no dashboard, no teams, no knowledge base changes
-->
<profile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/profile.xsd">
  <restriction option="hd-dashboard"/>
  <restriction option="hd-assign"/>
  <restriction option="hd-teams"/>
  <restriction option="customer-section"/>
  <restriction option="hd-my-tickets"/>
  <restriction option="administration"/>
  <permission id="tickets.read"/>
  <permission id="tickets.create"/>
  <permission id="tickets.update"/>
  <permission id="kb.read"/>
</profile>
