<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : hd-new-ticket.xml
    Description: New ticket wizard (agents): requester, category, details and review; the last step calls the maintain HdkTktNew
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://aweframework.gitlab.io/awe/docs/schemas/screen.xsd" template="window" label="HD_MENU_NEW_TICKET">
  <tag source="center">
    <window style="expand" label="HD_MENU_NEW_TICKET" icon="lucide:ticket-plus">
      <wizard id="WzTicket" initial-load="enum" target-action="HdkWizard" label="HD_WZ_STEP">
        <wizard-panel id="HdStep1">
          <tag type="div" style="fullHeight" expandible="vertical">
            <tag type="div" style="panel-body expand">
              <tag type="p" style="col-xs-12" label="HD_WZ_1"/>
              <criteria label="HD_COL_REQUESTER" id="IdeReq" component="suggest" style="col-xs-12" validation="required" server-action="data" target-action="HdkReqSug" check-target="HdkReqIni"/>
            </tag>
            <tag type="div" style="panel-footer">
              <tag type="div" style="pull-right">
                <button label="BUTTON_NEXT" icon="lucide:chevron-right" id="BtnWz1" style="btn-primary">
                  <button-action type="validate" target="HdStep1"/>
                  <button-action type="next-step" target="WzTicket"/>
                </button>
              </tag>
            </tag>
          </tag>
        </wizard-panel>
        <wizard-panel id="HdStep2">
          <tag type="div" style="fullHeight" expandible="vertical">
            <tag type="div" style="panel-body expand">
              <tag type="p" style="col-xs-12" label="HD_WZ_2"/>
              <criteria label="HD_COL_CATEGORY" id="Cat" component="select" style="col-xs-12 col-sm-4" validation="required" initial-load="enum" target-action="HdkCategory"/>
              <criteria label="HD_COL_PRIORITY" id="Pri" component="select" style="col-xs-12 col-sm-4" validation="required" initial-load="enum" target-action="HdkPriorityAgent" value="NORMAL"/>
              <criteria label="HD_COL_CHANNEL" id="Chn" component="select" style="col-xs-12 col-sm-4" validation="required" initial-load="enum" target-action="HdkChannel" value="WEB"/>
            </tag>
            <tag type="div" style="panel-footer">
              <tag type="div" style="pull-right">
                <button label="BUTTON_PREVIOUS" icon="lucide:chevron-left" id="BtnWz2b">
                  <button-action type="prev-step" target="WzTicket"/>
                </button>
                <button label="BUTTON_NEXT" icon="lucide:chevron-right" id="BtnWz2" style="btn-primary">
                  <button-action type="validate" target="HdStep2"/>
                  <button-action type="next-step" target="WzTicket"/>
                </button>
              </tag>
            </tag>
          </tag>
        </wizard-panel>
        <wizard-panel id="HdStep3">
          <tag type="div" style="fullHeight" expandible="vertical">
            <tag type="div" style="panel-body expand">
              <tag type="p" style="col-xs-12" label="HD_WZ_3"/>
              <criteria label="HD_COL_SUBJECT" id="Sub" component="text" style="col-xs-12" validation="{required:true, maxlength:120}"/>
              <criteria label="HD_COL_DESCRIPTION" id="Dsc" component="textarea" style="col-xs-12" validation="{required:true, maxlength:1000}" area-rows="6"/>
            </tag>
            <tag type="div" style="panel-footer">
              <tag type="div" style="pull-right">
                <button label="BUTTON_PREVIOUS" icon="lucide:chevron-left" id="BtnWz3b">
                  <button-action type="prev-step" target="WzTicket"/>
                </button>
                <button label="BUTTON_NEXT" icon="lucide:chevron-right" id="BtnWz3" style="btn-primary">
                  <button-action type="validate" target="HdStep3"/>
                  <button-action type="next-step" target="WzTicket"/>
                </button>
              </tag>
            </tag>
          </tag>
        </wizard-panel>
        <wizard-panel id="HdStep4">
          <tag type="div" style="fullHeight" expandible="vertical">
            <tag type="div" style="panel-body expand">
              <tag type="p" style="col-xs-12" label="HD_WZ_4"/>
            </tag>
            <tag type="div" style="panel-footer">
              <tag type="div" style="pull-right">
                <button label="BUTTON_PREVIOUS" icon="lucide:chevron-left" id="BtnWz4b">
                  <button-action type="prev-step" target="WzTicket"/>
                </button>
                <button label="BUTTON_FINISH" icon="lucide:check" id="BtnWzFinish" style="btn-primary" permission="tickets.create">
                  <button-action type="validate"/>
                  <button-action type="server" server-action="maintain" target-action="HdkTktNew"/>
                  <button-action type="screen" target="hd-queue"/>
                </button>
              </tag>
            </tag>
          </tag>
        </wizard-panel>
      </wizard>
    </window>
  </tag>
</screen>
